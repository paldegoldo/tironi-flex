= new THREE.PointLight(0xff4fd8, 0, 5, 1.6); ledLight.position.set(-0.55, 0.45, -1.2); scene.add(ledLight);\nconst doorLight = new THREE.PointLight(0xffd8a0, 0, 3.6, 1.4); doorLight.position.set(1.55, 1.8, 1.45); scene.add(doorLight);\nconst fillLight = new THREE.DirectionalLight(0x8090c0, 0.25); fillLight.position.set(2, 3, 4); scene.add(fillLight);\n\n/* =========================================================\n   TEXTURAS\n   ========================================================= */\nfunction tex(w, h, fn, wrap = true) {\n  const c = document.createElement('canvas'); c.width = w; c.height = h;\n  const g = c.getContext('2d'); fn(g, w, h);\n  const t = new THREE.CanvasTexture(c);\n  t.minFilter = THREE.LinearMipmapLinearFilter; t.anisotropy = renderer.capabilities.getMaxAnisotropy();\n  if (wrap) t.wrapS = t.wrapT = THREE.RepeatWrapping;\n  t.userData = { canvas:c }; return t;\n}\nfunction speckle(g, w, h, r, gg, b, v) {\n  const id = g.getImageData(0, 0, w, h);\n  for (let i = 0; i < w * h; i++) { const n = (rnd() - 0.5) * v; id.data[i*4] = r + n; id.data[i*4+1] = gg + n; id.data[i*4+2] = b + n; id.data[i*4+3] = 255; }\n  g.putImageData(id, 0, 0);\n}\nconst T = {};\nT.brick = tex(256, 256, (g, w, h) => {\n  g.fillStyle = '#6f5a50'; g.fillRect(0, 0, w, h);\n  for (let r = 0; r < 8; r++) for (let c = -1; c < 5; c++) {\n    const x = c * 64 + (r % 2 ? 32 : 0), y = r * 32;\n    const v = rnd(); g.fillStyle = `rgb(${120 + v * 50 | 0},${58 + v * 26 | 0},${44 + v * 18 | 0})`; g.fillRect(x + 3, y + 3, 58, 26);\n    g.fillStyle = 'rgba(0,0,0,.12)'; g.fillRect(x + 3, y + 22, 58, 7);\n    if (rnd() < 0.3) { g.fillStyle = 'rgba(220,210,200,.25)'; g.fillRect(x + 6 + rnd() * 30, y + 6, 14, 8); }\n  }\n});\nT.plaster = tex(128, 128, (g, w, h) => { speckle(g, w, h, 214, 210, 202, 10); });\nT.wood = tex(256, 256, (g, w, h) => {\n  for (let i = 0; i < 8; i++) { const v = rnd(); g.fillStyle = `rgb(${150 + v * 40 | 0},${110 + v * 30 | 0},${70 + v * 20 | 0})`; g.fillRect(0, i * 32, w, 32); g.fillStyle = 'rgba(0,0,0,.25)'; g.fillRect(0, i * 32, w, 2); g.fillRect((rnd() * w) | 0, i * 32, 2, 32); }\n  g.globalAlpha = 0.15; for (let i = 0; i < 60; i++) { g.fillStyle = rnd() < 0.5 ? '#5a3a20' : '#d8b080'; g.fillRect(rnd() * w, rnd() * h, 30 + rnd() * 60, 1); } g.globalAlpha = 1;\n});\nT.dart = tex(256, 256, (g) => {\n  const cx = 128, cy = 128; const rings = [124, 104, 96, 64, 56, 14, 7];\n  g.fillStyle = '#111'; g.beginPath(); g.arc(cx, cy, 127, 0, Math.PI * 2); g.fill();\n  for (let k = 0; k < 20; k++) {\n    const a0 = (k - 0.5) / 20 * Math.PI * 2, a1 = (k + 0.5) / 20 * Math.PI * 2;\n    const seg = (r0, r1, col) => { g.fillStyle = col; g.beginPath(); g.arc(cx, cy, r1, a0, a1); g.arc(cx, cy, r0, a1, a0, true); g.fill(); };\n    const dark = k % 2 === 0;\n    seg(64, 104, dark ? '#1a1a1a' : '#e8dcc0'); seg(14, 56, dark ? '#1a1a1a' : '#e8dcc0');\n    seg(104, 112, dark ? '#c0282c' : '#2a8a3a'); seg(56, 64, dark ? '#c0282c' : '#2a8a3a');\n  }\n  g.fillStyle = '#2a8a3a'; g.beginPath(); g.arc(cx, cy, 14, 0, 7); g.fill(); g.fillStyle = '#c0282c'; g.beginPath(); g.arc(cx, cy, 7, 0, 7); g.fill();\n}, false);\nT.plate = tex(256, 96, (g, w, h) => { g.fillStyle = '#f2f2ee'; g.fillRect(0, 0, w, h); g.fillStyle = '#1d3f95'; g.fillRect(0, 0, w, 22); g.fillStyle = '#fff'; g.font = 'bold 16px sans-serif'; g.textAlign = 'center'; g.fillText('SANTIAGO · CHILE', w / 2, 17); g.fillStyle = '#111'; g.font = 'bold 54px monospace'; g.fillText('XKR 1423', w / 2, 80); g.strokeStyle = '#111'; g.lineWidth = 4; g.strokeRect(2, 2, w - 4, h - 4); }, false);\nT.poster = tex(256, 360, (g, w, h) => {\n  const gr = g.createLinearGradient(0, 0, 0, h); gr.addColorStop(0, '#1b1838'); gr.addColorStop(1, '#3a1f4a'); g.fillStyle = gr; g.fillRect(0, 0, w, h);\n  g.strokeStyle = 'rgba(160,220,255,.8)'; g.lineWidth = 2;\n  for (let i = 0; i < 14; i++) { g.beginPath(); g.moveTo(128, 150); let x = 128, y = 150; for (let k = 0; k < 4; k++) { x += (rnd() - 0.5) * 90; y += (rnd() - 0.5) * 90; g.lineTo(x, y); } g.stroke(); }\n  g.fillStyle = '#ffc23a'; g.font = 'bold 40px Impact, sans-serif'; g.textAlign = 'center'; g.fillText('VIDRIOROTO', 128, 290);\n  g.fillStyle = '#fff'; g.font = 'bold 18px sans-serif'; g.fillText('EN VIVO · SANTIAGO', 128, 322);\n}, false);\nT.city = tex(256, 256, (g, w, h) => {\n  const gr = g.createLinearGradient(0, 0, 0, h); gr.addColorStop(0, '#0a0c22'); gr.addColorStop(1, '#2a2050'); g.fillStyle = gr; g.fillRect(0, 0, w, h);\n  g.fillStyle = '#2c2c48'; g.beginPath(); g.moveTo(0, 150); for (let x = 0; x <= w; x += 16) g.lineTo(x, 120 + Math.sin(x * 0.05) * 18 + rnd() * 10); g.lineTo(w, h); g.lineTo(0, h); g.fill();\n  for (let i = 0; i < 26; i++) { const bw = 12 + rnd() * 26, bh = 40 + rnd() * 110, x = rnd() * w; g.fillStyle = '#121428'; g.fillRect(x, h - bh, bw, bh); for (let y = h - bh + 4; y < h - 4; y += 8) for (let xx = x + 3; xx < x + bw - 3; xx += 6) if (rnd() < 0.35) { g.fillStyle = rnd() < 0.7 ? '#ffcf72' : '#a9dcff'; g.fillRect(xx, y, 3, 4); } }\n}, false);\nT.knit = tex(64, 64, (g, w, h) => {\n  g.fillStyle = '#5c2b3a'; g.fillRect(0, 0, w, h * 0.55); g.fillStyle = '#6f5a42'; g.fillRect(0, h * 0.55, w, h * 0.45);\n  for (let x = 0; x < w; x += 4) { g.fillStyle = 'rgba(0,0,0,.25)'; g.fillRect(x, 0, 1, h); g.fillStyle = 'rgba(255,255,255,.08)'; g.fillRect(x + 2, 0, 1, h); }\n});\nT.knit.repeat.set(5, 1);\nT.screenA = tex(512, 300, () => {}, false);   // DAW (se redibuja)\nT.screenB = tex(256, 160, (g, w, h) => { g.fillStyle = '#12151c'; g.fillRect(0, 0, w, h); for (let i = 0; i < 12; i++) { g.fillStyle = '#1e2430'; g.fillRect(8 + i * 20, 20, 14, 120); const v = 30 + rnd() * 80; g.fillStyle = i % 3 ? '#4fd36b' : '#ffd23a'; g.fillRect(10 + i * 20, 140 - v, 10, v); } }, false);\nT.screenC = tex(256, 160, (g, w, h) => { g.fillStyle = '#16121e'; g.fillRect(0, 0, w, h); for (let r = 0; r < 4; r++) for (let c = 0; c < 8; c++) { g.fillStyle = ['#ff4f4f', '#ffd23a', '#3fa0ff', '#4fd36b'][r]; g.globalAlpha = rnd() < 0.5 ? 0.9 : 0.2; g.fillRect(16 + c * 29, 18 + r * 34, 24, 26); } g.globalAlpha = 1; }, false);\nT.puff = tex(32, 32, (g) => { const gr = g.createRadialGradient(16, 16, 1, 16, 16, 16); gr.addColorStop(0, 'rgba(238,238,232,1)'); gr.addColorStop(1, 'rgba(238,238,232,0)'); g.fillStyle = gr; g.fillRect(0, 0, 32, 32); }, false);\nT.glow = tex(64, 64, (g) => { const gr = g.createRadialGradient(32, 32, 1, 32, 32, 32); gr.addColorStop(0, 'rgba(255,255,255,1)'); gr.addColorStop(0.3, 'rgba(255,255,255,.6)'); gr.addColorStop(1, 'rgba(255,255,255,0)'); g.fillStyle = gr; g.fillRect(0, 0, 64, 64); }, false);\nconst ucShirt = tex(8, 128, (g) => {\n  g.fillStyle = '#f4f4f2'; g.fillRect(0, 0, 8, 128); const v = (t) => Math.round((1 - t) * 128);\n  g.fillStyle = '#c8202e'; g.fillRect(0, v(0.635), 8, v(0.6) - v(0.635)); g.fillRect(0, v(0.445), 8, v(0.41) - v(0.445));\n  g.fillStyle = '#1b3f95'; g.fillRect(0, v(0.6), 8, v(0.445) - v(0.6)); g.fillRect(0, v(1), 8, v(0.93) - v(1));\n}, false);\nucShirt.wrapS = THREE.RepeatWrapping;\n\n/* =========================================================\n   HELPERS DE MODELADO\n   ========================================================= */\nconst UPV = new THREE.Vector3(0, 1, 0);\nconst V = (x, y, z) => new THREE.Vector3(x, y, z);\nconst PAINT = (col) => new THREE.MeshPhongMaterial({ color:col, shininess:70, specular:0x555566 });\nconst SOFT = (col, em) => new THREE.MeshPhongMaterial({ color:col, shininess:8, specular:0x111111, emissive:em || 0x000000 });\nconst MAT = (o) => new THREE.MeshPhongMaterial(Object.assign({ shininess:10, specular:0x111111 }, o));\nfunction addBox(w, h, d, mat, x, y, z, parent) { const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat); m.position.set(x, y, z); (parent || scene).add(m); return m; }\nfunction ell(rx, ry, rz, mat, x, y, z, parent, segs) {\n  segs = segs || 14;\n  const m = new THREE.Mesh(new THREE.SphereGeometry(1, segs, Math.max(6, Math.round(segs * 0.7))), mat);\n  m.scale.set(rx, ry, rz); m.position.set(x, y, z); (parent || scene).add(m); return m;\n}\nfunction seg(a, b, r1, r2, mat, parent, n) {\n  const d = new THREE.Vector3().subVectors(b, a), len = d.length();\n  const g = new THREE.CylinderGeometry(r2, r1, len, n || 10); g.translate(0, len / 2, 0);\n  const m = new THREE.Mesh(g, mat); m.position.copy(a); m.quaternion.setFromUnitVectors(UPV, d.normalize()); (parent || scene).add(m); return m;\n}\nfunction limbJ(a, b, r1, r2, mat, parent) { seg(a, b, r1, r2, mat, parent); ell(r2, r2, r2, mat, b.x, b.y, b.z, parent, 10); }\nfunction plane(w, h, mat, x, y, z, ry, parent) { const m = new THREE.Mesh(new THREE.PlaneGeometry(w, h), mat); m.position.set(x, y, z); m.rotation.y = ry || 0; (parent || scene).add(m); return m; }\n\n/* =========================================================\n   LA PIEZA DE XAKIRA\n   ========================================================= */\nconst ROOM = { x0:-2.3, x1:2.3, z0:-2.0, z1:2.4, h:2.6 };\n{\n  T.wood.repeat.set(2.4, 2.4); T.brick.repeat.set(3, 1.7); T.plaster.repeat.set(3, 2);\n  const floor = plane(4.6, 4.4, MAT({ map:T.wood }), 0, 0, 0.2); floor.rotation.x = -Math.PI / 2;\n  const ceil = plane(4.6, 4.4, MAT({ color:0x8a8690 }), 0, ROOM.h, 0.2); ceil.rotation.x = Math.PI / 2;\n  plane(4.6, ROOM.h, MAT({ map:T.brick }), 0, ROOM.h / 2, ROOM.z0);\n  plane(4.4, ROOM.h, MAT({ map:T.plaster }), ROOM.x0, ROOM.h / 2, 0.2, Math.PI / 2);\n  plane(4.4, ROOM.h, MAT({ map:T.plaster, color:0xd8d2dc }), ROOM.x1, ROOM.h / 2, 0.2, -Math.PI / 2);\n  // alfombra\n  const rug = new THREE.Mesh(new THREE.CircleGeometry(0.9, 28), MAT({ color:0x3a2a4a })); rug.rotation.x = -Math.PI / 2; rug.position.set(0.3, 0.005, -0.3); rug.scale.set(1.4, 1, 1); scene.add(rug);\n}\n// Ventana (pared derecha) con la ciudad de noche\n{\n  const win = plane(1.0, 0.9, new THREE.MeshBasicMaterial({ map:T.city }), ROOM.x1 - 0.01, 1.55, -1.1, -Math.PI / 2);\n  const fr = MAT({ color:0x2a2a30 });\n  addBox(0.06, 0.06, 1.1, fr, ROOM.x1 - 0.03, 2.03, -1.1); addBox(0.06, 0.06, 1.1, fr, ROOM.x1 - 0.03, 1.07, -1.1);\n  addBox(0.06, 1.0, 0.06, fr, ROOM.x1 - 0.03, 1.55, -1.63); addBox(0.06, 1.0, 0.06, fr, ROOM.x1 - 0.03, 1.55, -0.57); addBox(0.05, 1.0, 0.04, fr, ROOM.x1 - 0.03, 1.55, -1.1);\n  const cur = MAT({ color:0x3b4a66, side:THREE.DoubleSide });\n  for (let k = 0; k < 5; k++) { const c = new THREE.Mesh(new THREE.CylinderGeometry(0.07, 0.09, 1.3, 8, 1, true), cur); c.position.set(ROOM.x1 - 0.12, 1.45, -1.78 - k * 0.0 + k * 0.05); c.scale.set(1, 1, 0.6); scene.add(c); }\n}\n// Puerta (pared derecha, adelante) con pasillo iluminado detrás\nconst door = new THREE.Group();\n{\n  plane(0.84, 2.02, new THREE.MeshBasicMaterial({ color:0xffd08a }), ROOM.x1 - 0.008, 1.01, 0.95, -Math.PI / 2);\n  const leaf = addBox(0.04, 2.0, 0.82, MAT({ color:0x8a6a4a }), 0, 1.0, 0.41, door);\n  addBox(0.05, 1.9, 0.72, MAT({ color:0x7a5a3c }), 0.003, 1.0, 0.41, door);\n  ell(0.03, 0.03, 0.03, PAINT(0xd8c890), -0.04, 1.0, 0.75, door, 10);\n  door.position.set(ROOM.x1 - 0.03, 0, 0.54); scene.add(door);\n  const fr = MAT({ color:0x5a4430 }); addBox(0.06, 0.06, 0.94, fr, ROOM.x1 - 0.02, 2.04, 0.95); addBox(0.06, 2.06, 0.05, fr, ROOM.x1 - 0.02, 1.03, 0.5); addBox(0.06, 2.06, 0.05, fr, ROOM.x1 - 0.02, 1.03, 1.4);\n}\n// Escritorio con 3 monitores, teclado y parlantes\nconst screens = [];\n{\n  const deskM = MAT({ color:0x2c2a30 }), metal = PAINT(0x26262c);\n  addBox(2.3, 0.05, 0.72, deskM, -0.55, 0.75, -1.6);\n  for (const x of [-1.62, 0.52]) for (const z of [-1.9, -1.3]) addBox(0.05, 0.75, 0.05, metal, x, 0.375, z);\n  const mk = (x, z, ry, t) => {\n    const g = new THREE.Group(); g.position.set(x, 0, z); g.rotation.y = ry; scene.add(g);\n    addBox(0.64, 0.4, 0.04, PAINT(0x101014), 0, 1.13, 0, g);\n    const scr = plane(0.6, 0.36, new THREE.MeshBasicMaterial({ map:t }), 0, 1.13, 0.021, 0, g); screens.push(scr);\n    addBox(0.05, 0.28, 0.04, metal, 0, 0.9, -0.03, g); addBox(0.24, 0.02, 0.16, metal, 0, 0.785, 0, g);\n  };\n  mk(-0.55, -1.82, 0, T.screenA); mk(-1.24, 