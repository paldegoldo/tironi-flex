lor:0x6a5aa0, transparent:true, opacity:0.9 })); m.position.set(s * (LANE_W * 2 + 0.08), 0.02, 1 - LEN / 2); hlScene.add(m); return m; });\naddBox(LANE_W * 4 + 0.12, 0.02, 0.05, new THREE.MeshBasicMaterial({ color:0xffffff }), 0, 0.01, 0, hlScene);\nconst beatLines = [];\nfor (let i = 0; i < 12; i++) { const m = addBox(LANE_W * 4, 0.005, 0.03, new THREE.MeshBasicMaterial({ color:0xffffff, transparent:true, opacity:0.12 }), 0, 0.003, 0, hlScene); beatLines.push(m); }\nconst targets = [], flashes = [];\nfor (let l = 0; l < 4; l++) {\n  const ring = new THREE.Mesh(new THREE.TorusGeometry(0.22, 0.045, 10, 32), new THREE.MeshPhongMaterial({ color:LANE_COL[l], emissive:LANE_COL[l], emissiveIntensity:0.3, shininess:60 }));\n  ring.rotation.x = -Math.PI / 2; ring.position.set(laneX(l), 0.03, 0); hlScene.add(ring);\n  const fill = new THREE.Mesh(new THREE.CircleGeometry(0.19, 28), new THREE.MeshBasicMaterial({ color:LANE_COL[l], transparent:true, opacity:0.15 }));\n  fill.rotation.x = -Math.PI / 2; fill.position.set(laneX(l), 0.025, 0); hlScene.add(fill);\n  const fl = new THREE.Sprite(new THREE.SpriteMaterial({ map:T.glow, color:LANE_COL[l], transparent:true, opacity:0, depthWrite:false, blending:THREE.AdditiveBlending }));\n  fl.position.set(laneX(l), 0.25, 0); fl.scale.set(1.3, 1.3, 1); hlScene.add(fl);\n  targets.push({ ring, fill, held:false }); flashes.push({ sp:fl, t:0 });\n}\n// notas\nconst gemGeo = new THREE.CylinderGeometry(0.19, 0.22, 0.1, 24), capGeo = new THREE.CylinderGeometry(0.12, 0.12, 0.11, 20), tailGeo = new THREE.BoxGeometry(0.11, 0.025, 1);\nconst gemMats = LANE_COL.map((c) => new THREE.MeshPhongMaterial({ color:c, emissive:c, emissiveIntensity:0.25, shininess:80, specular:0xffffff }));\nconst tailMats = LANE_COL.map((c) => new THREE.MeshBasicMaterial({ color:c, transparent:true, opacity:0.75 }));\nconst capMat = new THREE.MeshPhongMaterial({ color:0xffffff, shininess:80 });\nconst volaoMat = new THREE.MeshPhongMaterial({ color:0xb8ffc8, emissive:0x4fd36b, emissiveIntensity:0.6, shininess:80 });\nlet notes = [];\nfunction buildNotes() {\n  notes.forEach((n) => hlScene.remove(n.g));\n  notes = CHART.notes.map(([t, lane, dur]) => {\n  const g = new THREE.Group(); g.visible = false; hlScene.add(g);\n  const gem = new THREE.Mesh(gemGeo, gemMats[lane]); gem.position.y = 0.06; g.add(gem);\n  const cap = new THREE.Mesh(capGeo, capMat); cap.position.y = 0.07; g.add(cap);\n  let tail = null;\n  if (dur > 0) { tail = new THREE.Mesh(tailGeo, tailMats[lane].clone()); tail.scale.z = dur * SPEED; tail.position.set(0, 0.03, -dur * SPEED / 2); g.add(tail); }\n  return { t, lane, dur, g, gem, tail, hit:false, missed:false, holding:false, holdEnd:false, x:laneX(lane) };\n  });\n}\nbuildNotes();\n\n/* =========================================================\n   AUDIO\n   ========================================================= */\nconst AU = { ctx:null, buf:null, src:null, on:true };\nlet songBytes = null;\nfunction fetchSong(so) { if (so.bytes) return Promise.resolve(so.bytes); return fetch(so.file).then((r) => { if (!r.ok) throw new Error(r.status); return r.arrayBuffer(); }).then((b) => (so.bytes = b)); }\nasync function decodeSong(so) { if (!so.buf) { await fetchSong(so); so.buf = await AU.ctx.decodeAudioData(so.bytes.slice(0)); SONGS.forEach((x) => { if (x !== so && x !== SONG && x.buf) x.buf = null; }); } return so.buf; }\nsetTimeout(() => SONGS.slice(1).forEach((so) => fetchSong(so).catch(() => {})), 2500);\nfetchSong(SONGS[0])\n  .then((b) => { songBytes = b; $('#play').disabled = false; $('#play').textContent = 'Jugar'; })\n  .catch(() => { $('#play').textContent = 'No se pudo cargar la canción'; });\nconst mf = (m) => 440 * Math.pow(2, (m - 69) / 12);\nasync function audioInit() {\n  if (AU.ctx) { if (AU.ctx.state === 'suspended') await AU.ctx.resume(); return; }\n  const AC = window.AudioContext || window.webkitAudioContext; const ctx = new AC(); AU.ctx = ctx;\n  AU.master = ctx.createGain(); AU.master.gain.value = 0.85; AU.master.connect(ctx.destination);\n  AU.music = ctx.createGain(); AU.music.gain.value = 0.9;\n  AU.mFilter = ctx.createBiquadFilter(); AU.mFilter.type = 'lowpass'; AU.mFilter.frequency.value = 18000; AU.music.connect(AU.mFilter); AU.mFilter.connect(volNode(ctx, AU.master, 'music'));\n  AU.sfx = ctx.createGain(); AU.sfx.gain.value = 0.7; AU.sfx.connect(volNode(ctx, AU.master, 'sfx'));\n  const nb = ctx.createBuffer(1, ctx.sampleRate, ctx.sampleRate), d = nb.getChannelData(0); for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1; AU.noise = nb;\n  AU.buf = await decodeSong(SONG);\n}\nfunction tone(f, t, dur, type, gain, dest, filt) {\n  const ctx = AU.ctx, o = ctx.createOscillator(), g = ctx.createGain(); o.type = type; o.frequency.setValueAtTime(f, t);\n  g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(gain, t + 0.01); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);\n  let node = o; if (filt) { const bf = ctx.createBiquadFilter(); bf.type = filt[0]; bf.frequency.value = filt[1]; if (filt[2]) bf.Q.value = filt[2]; o.connect(bf); node = bf; }\n  node.connect(g); g.connect(dest || AU.sfx); o.start(t); o.stop(t + dur + 0.02); return o;\n}\nfunction noise(t, dur, gain, type, freq, q) {\n  const ctx = AU.ctx, s = ctx.createBufferSource(); s.buffer = AU.noise;\n  const f = ctx.createBiquadFilter(); f.type = type; f.frequency.value = freq; if (q) f.Q.value = q;\n  const g = ctx.createGain(); g.gain.setValueAtTime(gain, t); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);\n  s.connect(f); f.connect(g); g.connect(AU.sfx); s.start(t, Math.random() * 0.5); s.stop(t + dur + 0.02); return f;\n}\nconst sfx = {\n  ok() { return !!AU.ctx; },\n  voice(l) { if (!sfx.ok()) return; const t = AU.ctx.currentTime; tone(mf(LANE_NOTE[l] + 12), t, 0.22, 'triangle', 0.05, AU.sfx, ['bandpass', 1100, 1.2]); tone(mf(LANE_NOTE[l]), t, 0.18, 'sawtooth', 0.012, AU.sfx, ['lowpass', 1400]); },\n  miss() { if (!sfx.ok()) return; const t = AU.ctx.currentTime; tone(mf(58), t, 0.28, 'sawtooth', 0.05, AU.sfx, ['lowpass', 1200]); tone(mf(58) * 1.06, t, 0.28, 'sawtooth', 0.05, AU.sfx, ['lowpass', 1200]); },\n  pifia() { if (!sfx.ok()) return; tone(110, AU.ctx.currentTime, 0.1, 'square', 0.03, AU.sfx, ['lowpass', 600]); },\n  bong() { if (!sfx.ok()) return; const t = AU.ctx.currentTime; for (let i = 0; i < 14; i++) { const f = tone(180 + Math.random() * 220, t + i * 0.06 + Math.random() * 0.03, 0.06, 'sine', 0.08); } noise(t, 0.9, 0.12, 'bandpass', 700, 0.8); noise(t + 1.1, 0.12, 0.2, 'bandpass', 500, 1.2); noise(t + 1.3, 0.14, 0.2, 'bandpass', 450, 1.2); },\n  door() {   // manilla + bisagra que cruje\n    if (!sfx.ok()) return; const ctx = AU.ctx, t = ctx.currentTime;\n    noise(t, 0.05, 0.5, 'highpass', 2500); tone(1800, t + 0.01, 0.04, 'square', 0.04, AU.sfx, ['bandpass', 2400, 4]);\n    noise(t + 0.09, 0.06, 0.35, 'bandpass', 1500, 3); tone(900, t + 0.1, 0.03, 'square', 0.03, AU.sfx, ['bandpass', 1600, 4]);\n    for (const [st, dur, f0, f1] of [[0.18, 0.32, 520, 760], [0.48, 0.42, 700, 430], [0.86, 0.25, 480, 610]]) {\n      const o = ctx.createOscillator(), g = ctx.createGain(), bp = ctx.createBiquadFilter(), lfo = ctx.createOscillator(), lg = ctx.createGain();\n      o.type = 'sawtooth'; o.frequency.setValueAtTime(f0, t + st); o.frequency.linearRampToValueAtTime(f1, t + st + dur);\n      lfo.frequency.value = 38 + Math.random() * 20; lg.gain.value = f0 * 0.06; lfo.connect(lg); lg.connect(o.frequency);\n      bp.type = 'bandpass'; bp.frequency.value = 1400; bp.Q.value = 5;\n      g.gain.setValueAtTime(0.0001, t + st); g.gain.exponentialRampToValueAtTime(0.09, t + st + 0.05); g.gain.setValueAtTime(0.09, t + st + dur * 0.7); g.gain.exponentialRampToValueAtTime(0.0001, t + st + dur);\n      o.connect(bp); bp.connect(g); g.connect(AU.sfx); o.start(t + st); lfo.start(t + st); o.stop(t + st + dur + 0.05); lfo.stop(t + st + dur + 0.05);\n    }\n    noise(t + 0.95, 0.35, 0.18, 'lowpass', 260);\n  },\n  doorClose() { if (!sfx.ok()) return; const t = AU.ctx.currentTime; noise(t, 0.28, 0.6, 'lowpass', 180); tone(70, t, 0.22, 'sine', 0.2); noise(t + 0.05, 0.05, 0.35, 'highpass', 2600); tone(1500, t + 0.06, 0.03, 'square', 0.03, AU.sfx, ['bandpass', 2200, 4]); },\n  step(k) { if (!sfx.ok()) return; const t = AU.ctx.currentTime; noise(t, 0.09, 0.22 + 0.06 * k, 'lowpass', 220 + 60 * k); tone(95 + 10 * k, t, 0.06, 'sine', 0.06); },\n  sting() { if (!sfx.ok()) return; const t = AU.ctx.currentTime; [52, 51, 50, 45].forEach((m, k) => tone(mf(m), t + k * 0.16, 0.35, 'square', 0.08, AU.sfx, ['lowpass', 1500])); },\n  win() { if (!sfx.ok()) return; const t = AU.ctx.currentTime; [69, 73, 76, 81].forEach((m, k) => tone(mf(m), t + k * 0.12, 0.3, 'square', 0.1)); },\n  send() { if (!sfx.ok()) return; const t = AU.ctx.currentTime; tone(1200, t, 0.08, 'sine', 0.08); tone(1600, t + 0.07, 0.1, 'sine', 0.08); },\n};\nfunction playSong(offset) {\n  stopSong();\n  const s = AU.ctx.createBufferSource(); s.buffer = AU.buf; s.connect(AU.music);\n  const lat = (AU.ctx.outputLatency || AU.ctx.baseLatency || 0);\n  AU.start = AU.ctx.currentTime + 0.15 - (offset || 0) + lat; s.start(AU.ctx.currentTime + 0.15, offset || 0); AU.src = s;\n}\nfunction stopSong() { if (AU.src) { try { AU.src.stop(); } catch (e) {} AU.src.disconnect(); AU.src = null; } }\nconst songTime = () => AU.ctx ? AU.ctx.currentTime - AU.start : 0;\n\n/* =========================================================\n   INTERFAZ\n   ========================================================= */\nconst H = { hud:$('#hud'), score:$('#h-score'), mult:$('#h-mult'), multw:$('#h-multw'), combo:$('#h-combo'), mood:$('#m-mood'), moodL:$('#h-mood-l'), moodbar:$('#h-moodbar'), vola:$('#m-vola'), volaL:$('#h-vola-l'), volabar:$('#h-volabar'), bongs:document.querySelectorAll('#h-bongs i'), prog:$('#h-prog'), lyNow:$('#ly-now'), lyNext:$('#ly-next'), judge:$('#judge') };\nlet centerTO = 0, hintTO = 0, judgeTO = 0;\nfunction showCenter(text, ms, cls) { const el = $('#center'); el.textContent = text; el.className = 'show ' + (cls || ''); clearTimeout(centerTO); centerTO = setTimeout(() => { el.className = ''; }, ms); }\nfunction hint(text, ms = 2600) { const el = $('#hint'); el.textContent = text; el.classList.add('show'); clearTimeout(hintTO); hintTO = setTimeout(() => el.classList.remove('show'), ms); }\nfunction judge(text, cls) { H.judge.textContent = text; H.judge.className = 'show ' + cls; clearTimeout(judgeTO); judgeTO = setTimeout(() => { H.judge.className = cls; }, 380); }\nif (matchMedia('(pointer: coarse)').matches || innerWidth < 760) $('#mobile-note').hidden = false;\n\n/* ---------- Chat ---------- */\nlet chatTimers = [];\nconst nowHM = () => { const d = new Date(); return String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0'); };\nfunction addMsg(who, text) { const box = $('#msgs'), el = document.createElement('div'); el.className = 'msg ' + who; el.textContent = text; if (who !== 'sys') { const t = document.createElement('time'); t.textContent = nowHM(); el.appendChild(t); } box.appendChild(el); box.scrollTop = box.scrollHeight; }\nfunction runChat(lines, onDone) {\n  chatTimers.forEach(clearTimeout); chatTimers = []; const box = $('#msgs'); let t = 350;\n  lines.forEach(([who, text], k) => {\n    if (who === 'them') { chatTimers.push(setTimeout(() => { const ty = document.createElement('div'); ty.className = 'typing'; ty.id = 'typing'; ty.innerHTML = '<i></i><i></i><i></i>'; box.appendChild(ty); box.scrollTop = box.scrollHeight; $('#chat-status').textContent = 'escribiendo…'; }, t)); t += Math.min(1500, 450 + text.length * 16); }\n    chatTimers.push(setTimeout(() => { const ty = $('#typing'); if (ty) ty.remove(); $('#chat-status').textContent = 'en línea'; addMsg(who, text); if (k === lines.length - 1 && onDone) onDone(); }, t));\n    t += who === 'me' ? 650 : 420;\n  });\n}\nfunction finishChatNow(lines, onDone) { chatTimers.forEach(clearTimeout); chatTimers = []; const ty = $('#typing'); if (ty) ty.remove(); $('#msgs').innerHTML = ''; lines.forEach(([w, x]) => addMsg(w, x)); if (onDone) onDone(); }\nfunction footer(buttons) { const f = $('#chat-foot'); f.innerHTML = ''; buttons.forEach(([label, cls, fn, id]) => { const b = document.createElement('button'); b.className = 'btn ' + cls; b.textContent = label; if (id) b.id = id; b.addEventListener('click', fn); f.appendChild(b); }); }\n\n/* =========================================================\n   ESTADO\n   ========================================================= */\nconst G = { mode:'title', t:0, score:0, combo:0, best:0, mood:30, vola:0, volaoT:0, bongs:1, streak:0, hits:0, perfect:0, misses:0, lastBeat:-1, lyric:-1, flash:0, red:0, warned:false, cineT:0, shot:-1, lose:null, puffT:0 };\nconst keyHeld = [false, false, false, false];\nfunction resetGame() {\n  Object.assign(G, { score:0, combo:0, best:0, mood:45, vola:0, volaoT:0, bongs:1, streak:0, hits:0, perfect:0, misses:0, lastBeat:-1, lyric:-1, flash:0, red:0, warned:false, lose:null });\n  notes.forEach((n) => { n.hit = n.missed = n.holding = n.holdEnd = false; n.g.visible = false; n.gem.visible = true; n.g.children[1].visible = true; if (n.tail) { n.tail.material.opacity = 0.75; n.tail.scale.z = n.dur * SPEED; n.tail.position.z = -n.dur * SPEED / 2; } });\n  for (let l = 0; l < 4; l++) keyHeld[l] = false;\n  papao.root.visible = papa.root.visible = false; door.rotation.y = 0; doorLight.intensity = 0;\n  tironi.root.position.set(1.4, 0, -0.3); tironi.root.rotation.y = -1.05;\n  H.lyNow.textContent = ''; H.lyNext.textContent = '';\n}\nfunction show(id) { ['title', 'chat', 'pause', 'lose'].forEach((k) => { $('#' + k).hidden = k !== id; }); }\nconst SUBS = $('#subs'), SKIP = $('#skip');\nlet subTO = 0;\nfunction say(who, text) { clearInterval(subTO); SUBS.innerHTML = ''; const b = document.createElement('b'); b.textContent = who; const sp = document.createElement('span'); SUBS.append(b, sp); SUBS.classList.add('show'); let i = 0; subTO = setInterval(() => { i++; sp.textContent = text.slice(0, i); if (i >= text.length) clearInterval(subTO); }, 30); }\nfunction clearSay() { clearInterval(subTO); SUBS.classList.remove('show'); SUBS.innerHTML = ''; }\n\nfunction goTitle() { if (EMB && embReady) { EMB.exit(); return; } stopSong(); G.mode = 'title'; show('title'); H.hud.hidden = true; document.body.classList.remove('cine', 'wsp'); SKIP.hidden = true; clearSay(); resetGame(); }\nasync function goChat() {\n  $('#play').disabled = true; $('#play').textContent = 'Preparando…';\n  try { await audioInit(); } catch (e) { $('#play').textContent = 'No se pudo cargar la canción'; return; }\n  $('#play').disabled = false; $('#play').textContent = 'Jugar';\n  G.mode = 'chat'; show('chat'); $('#msgs').innerHTML = '';\n  const accept = () => { if (document.activeElement) document.activeElement.blur(); startIntro(); };\n  footer([['Saltar chat', 'ghost', () => { finishChatNow(TXT.chatIntro); footer([['Ir donde Xakira', 'small', accept, 'accept']]); $('#accept').focus(); }]]);\n  runChat(TXT.chatIntro, () => { footer([['Ir donde Xakira', 'small', accept, 'accept']]); $('#accept').focus(); });\n}\nfunction startIntro() {\n  resetGame(); show(null); H.hud.hidden = true; G.mode = 'intro'; G.cineT = 0; G.shot = -1;\n  document.body.classList.add('cine'); SKIP.hidden = false; SKIP.textContent = 'Saltar ▸';\n  tironi.root.position.set(2.0, 0, 0.95); tironi.root.rotation.y = -Math.PI / 2;\n}\nfunction startSong() {\n  if (!TUTO.done) { G.mode = 'tuto'; clearSay(); document.body.classList.remove('cine', 'wsp'); SKIP.hidden = true; show(null); H.hud.hidden = true; tutoShow(startSong); return; }\n  clearSay(); document.body.classList.remove('cine', 'wsp'); ['#w1', '#w2'].forEach((s) => $(s).classList.remove('show')); SKIP.hidden = true; resetGame(); door.rotation.y = 0;\n  show(null); H.hud.hidden = false; $('#lyrics').hidden = !(TXT.letra.length && SONG.id === 'mirador'); G.mode = 'play'; playSong(0); showCenter('¡Dale!', 900, 'green');\n  hint('D F J K cuando las notas toquen los círculos', 3500);\n}\nfunction startOutro() {\n  G.justUnlocked = false; if (SONG.id === 'mirador' && !temasOk()) { try { localStorage.setItem('xakira-temas', '1'); } catch (e) {} G.justUnlocked = true; }\n  $('#w-file').textContent = (SONG.id === 'mirador' ? TXT.cineFinal.archivo : SONG.name + ' (base nueva).mp3 · ' + fmtDur(SONG.chart.dur)) + ' · ✓✓';\n  G.mode = 'outro'; G.cineT = 0; G.shot = -1; H.hud.hidden = true; document.body.classList.add('cine');\n  SKIP.hidden = false; SKIP.textContent = 'Saltar ▸'; sfx.win();\n}\nfunction endOutro() {\n  if (EMB) { stopSong(); EMB.done(true, clone(TXT.chatWin).concat(unlockLines(), [['sys', 'Tema: ' + SONG.name + ' · Puntaje: ' + Math.floor(G.score).toLocaleString('es-CL') + ' · Acierto: ' + Math.round(100 * G.hits / Math.max(1, notes.length)) + '%']])); return; }\n  clearSay(); document.body.classList.remove('cine', 'wsp'); SKIP.hidden = true; ['#w1', '#w2'].forEach((s) => $(s).classList.remove('show'));\n  if (AU.ctx) AU.mFilter.frequency.setTargetAtTime(18000, AU.ctx.currentTime, 0.2);\n  stopSong(); G.mode = 'end'; show('chat'); $('#msgs').innerHTML = '';\n  const acc = Math.round(100 * G.hits / Math.max(1, notes.length));\n  G.score = Math.floor(G.score); let best = G.score; try { const b = parseInt(localStorage.getItem(bestKey()) || '0', 10); best = Math.max(b, G.score); localStorage.setItem(bestKey(), String(best)); } catch (e) {}\n  const lines = clone(TXT.chatWin).concat(unlockLines(), [['sys', 'Tema: ' + SONG.name + ' · Puntaje: ' + G.score.toLocaleString('es-CL') + ' · Acierto: ' + acc + '% · Mejor: ' + best.toLocaleString('es-CL')]]);\n  footer([]); runChat(lines, () => footer([['Menú', 'ghost', goTitle], ['Cantar otro tema', 'small', () => { if (document.activeElement) document.activeElement.blur(); pickSong(); }, 'again']]));\n}\nfunction startLose(who) {\n  if (G.lose) return; G.lose = who; G.mode = 'losecine'; G.cineT = 0; H.hud.hidden = true; document.body.classList.add('cine');\n  stopSong(); sfx.door(); setTimeout(() => sfx.sting(), 600);\n  document.body.classList.remove('wsp'); papao.root.visible = papa.root.visible = false;\n  const p = who === 'papao' ? papao : papa; p.root.visible = true;\n  if (who === 'papao') say('Papao', TXT.derrota.papao);\n  else say('Papá', TXT.derrota.papa);\n}\nfunction showLose() {\n  clearSay(); document.body.classList.remove('cine'); G.mode = 'lost'; show('lose');\n  if (G.lose === 'papao') { $('#lose-t').textContent = TXT.derrota.tituloPapao; $('#lose-p').textContent = TXT.derrota.textoPapao; }\n  else { $('#lose-t').textContent = TXT.derrota.tituloPapa; $('#lose-p').textContent = TXT.derrota.textoPapa; }\n  $('#retry').focus();\n}\nfunction togglePause() {\n  if (G.mode === 'play') { G.mode = 'pause'; show('pause'); if (AU.ctx) AU.ctx.suspend(); }\n  else if (G.mode === 'pause') { G.mode = 'play'; show(null); if (AU.ctx) AU.ctx.resume(); if (document.activeElement) document.activeElement.blur(); }\n}\n$('#play').addEventListener('click', goChat);\n$('#resume').addEventListener('click', togglePause);\n$('#restart').addEventListener('click', async () => { if (document.activeElement) document.activeElement.blur(); if (AU.ctx) await AU.ctx.resume(); startSong(); });\n$('#to-menu').addEventListener('click', async () => { if (AU.ctx) await AU.ctx.resume(); goTitle(); });\n$('#retry').addEventListener('click', () => { if (document.activeElement) document.activeElement.blur(); pickSong(); });\n$('#lose-menu').addEventListener('click', goTitle);\nSKIP.addEventListener('click', () => { SKIP.blur(); skipCine(); });\nfunction skipCine() { if (G.mode === 'intro') pickSong(); else if (G.mode === 'outro') endOutro(); else if (G.mode === 'losecine') showLose(); }\n\nconst TUTO_DEF = {\"tag\": \"Cómo se juega · Nivel 2\", \"controls\": [{\"keys\": [[\"KeyD\", \"D\", \"l0\"], [\"KeyF\", \"F\", \"l1\"], [\"KeyJ\", \"J\", \"l2\"], [\"KeyK\", \"K\", \"l3\"]], \"f\": \"c_carriles\"}, {\"keys\": [[\"Space\", \"Espacio\"]], \"f\": \"c_bong\"}, {\"keys\": [[\"KeyP\", \"P\"], [\"KeyM\", \"M\"]], \"f\": \"c_pausa\"}], \"hud\": [{\"kind\": \"meter\", \"label\": \"Ánimo de Xakira\", \"bg\": \"linear-gradient(90deg,#ff5f4e,#ffc23a 45%,#8fd694)\", \"fill\": 0.55, \"f\": \"h_animo\"}, {\"kind\": \"meter\", \"label\": \"Volá\", \"bg\": \"#8fd694\", \"fill\": 0.3, \"f\": \"h_vola\"}, {\"kind\": \"bongs\", \"label\": \"Bong\", \"f\": \"h_bongs\"}]};\n/* ---------- Tutorial: cómo se juega ---------- */\nconst TUTO = { open:false, done:false, cb:null };\nfunction tutoMini(h) {\n  const box = document.createElement('div'); box.className = 'tuto-mini';\n  const lab = document.createElement('span'); lab.textContent = h.label || '';\n  if (h.kind === 'meter' || h.kind === 'power' || h.kind === 'timer') {\n    const m = document.createElement('div'); m.className = 'tuto-meter' + (h.kind === 'power' ? ' box' : ''); const i = document.createElement('i'); i.style.width = (h.fill * 100) + '%'; i.style.background = h.bg; m.appendChild(i);\n    if (h.kind === 'power') m.appendChild(document.createElement('b'));\n    if (h.kind === 'timer') m.style.height = '7px';\n    box.append(lab, m);\n  } else if (h.kind === 'pitos' || h.kind === 'bongs') {\n    const d = document.createElement('div'); d.className = 'tuto-icons' + (h.kind === 'bongs' ? ' bong' : ''); for (let k = 0; k < 3; k++) d.appendChild(document.createElement('i')); box.append(lab, d);\n  } else if (h.kind === 'map') {\n    const d = document.createElement('div'); d.className = 'tuto-map';\n    d.innerHTML = '<svg viewBox=\"0 0 64 64\" width=\"60\" height=\"60\"><path d=\"M14 46 C8 30 14 12 30 12 S56 22 50 40 34 56 14 46Z\" fill=\"none\" stroke=\"#b9aecb\" stroke-width=\"3\"/><circle cx=\"30\" cy=\"12\" r=\"4.5\" fill=\"#8fd694\"/><circle cx=\"50\" cy=\"36\" r=\"4.5\" fill=\"#ff5f4e\"/></svg>';\n    box.append(d, lab);\n  }\n  return box;\n}\nfunction tutoRender() {\n  const T = TXT.tutorial || {};\n  $('#tuto-tag').textContent = TUTO_DEF.tag; $('#tuto-title').textContent = T.titulo || ''; $('#tuto-goal').textContent = T.objetivo || '';\n  const ctl = $('#tuto-ctl'); ctl.innerHTML = '';\n  for (const c of TUTO_DEF.controls) {\n    const keys = document.createElement('div'); keys.className = 'tuto-keys';\n    for (const [code, label, cls] of c.keys) { const k = document.createElement('kbd'); k.dataset.code = code; k.textContent = label; if (cls) k.className = cls; keys.appendChild(k); }\n    const p = document.createElement('p'); p.textContent = T[c.f] || ''; ctl.append(keys, p);\n  }\n  const hud = $('#tuto-hud'); hud.innerHTML = '';\n  for (const h of TUTO_DEF.hud) { const row = document.createElement('div'); row.className = 'tuto-h'; const p = document.createElement('p'); p.textContent = T[h.f] || ''; row.append(tutoMini(h), p); hud.appendChild(row); }\n  const tips = $('#tuto-tips'); tips.innerHTML = '';\n  for (const k of ['t1', 't2', 't3']) if (T[k] && String(T[k]).trim()) { const li = document.createElement('li'); li.textContent = T[k]; tips.appendChild(li); }\n}\nfunction tutoShow(cb) { TUTO.cb = cb || null; tutoRender(); $('#tuto').hidden = false; TUTO.open = true; $('#tuto').scrollTop = 0; setTimeout(() => { if (TUTO.open) $('#tuto-go').focus(); }, 60); }\nfunction tutoClose() {\n  if (!TUTO.open) return; $('#tuto').hidden = true; TUTO.open = false; TUTO.done = true;\n  document.querySelectorAll('#tuto kbd.on').forEach((k) => k.classList.remove('on'));\n  if (document.activeElement) document.activeElement.blur();\n  const cb = TUTO.cb; TUTO.cb = null; if (cb) cb();\n}\nfunction tutoKey(e) {\n  if (!TUTO.open) return false;\n  if (e.code === 'Enter' || e.code === 'NumpadEnter') { e.preventDefault(); tutoClose(); return true; }\n  document.querySelectorAll('#tuto kbd').forEach((k) => { if (k.dataset.code === e.code) k.classList.add('on'); });\n  if (e.code === 'Space' || e.code.indexOf('Arrow') === 0) e.preventDefault();\n  return true;\n}\naddEventListener('keyup', (e) => { document.querySelectorAll('#tuto kbd').forEach((k) => { if (k.dataset.code === e.code) k.classList.remove('on'); }); });\n$('#tuto-go').addEventListener('click', tutoClose);\n$('#tuto-btn').addEventListener('click', () => tutoShow(null));\n\n/* ---------- elegir tema ---------- */\nconst DIF = ['', 'Muy fácil', 'Fácil', 'Normal', 'Difícil', 'Experto'];\nconst fmtDur = (x) => Math.floor(x / 60) + ':' + String(Math.floor(x % 60)).padStart(2, '0');\nconst bestKey = () => SONG.id === 'mirador' ? 'xakira-best' : 'xakira-best-' + SONG.id;\nlet pickIdx = 0;\nconst temasOk = () => { try { return localStorage.getItem('xakira-temas') === '1'; } catch (e) { return false; } };\nconst locked = (so) => so.id !== 'mirador' && !temasOk();\nfunction unlockLines() { return G.justUnlocked ? [['sys', '🔓 Se desbloquearon 3 temas nuevos en la carpeta de Xakira']] : []; }\nconst PV = { src:null, g:null, id:null, to:0 };\nfunction stopPreview() {\n  clearTimeout(PV.to); PV.id = null; if (!PV.src || !AU.ctx) return;\n  const src = PV.src, g = PV.g, t = AU.ctx.currentTime; g.gain.cancelScheduledValues(t); g.gain.setTargetAtTime(0.0001, t, 0.1); setTimeout(() => { try { src.stop(); } catch (e) {} src.disconnect(); }, 450); PV.src = null;\n}\nasync function previewSong(so) {\n  stopPreview(); PV.id = so.id;\n  try { await audioInit(); await decodeSong(so); } catch (e) { return; }\n  if (PV.id !== so.id || G.mode !== 'pick') return;\n  const ctx = AU.ctx, src = ctx.createBufferSource(), g = ctx.createGain(), t = ctx.currentTime;\n  src.buffer = so.buf; g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.85, t + 0.9); g.gain.setValueAtTime(0.85, t + 11.5); g.gain.exponentialRampToValueAtTime(0.0001, t + 13);\n  src.connect(g); g.connect(AU.music); src.start(t + 0.05, so.chart.preview || 30); PV.src = src; PV.g = g;\n  PV.to = setTimeout(() => { if (PV.id === so.id && G.mode === 'pick') previewSong(so); }, 13200);\n}\nfunction pickRender() {\n  const box = $('#sg-list'); box.innerHTML = '';\n  SONGS.forEach((so, i) => {\n    const lk = locked(so);\n    const b = document.createElement('button'); b.type = 'button'; b.className = 'sg-item' + (i === pickIdx ? ' on' : '') + (lk ? ' locked' : ''); if (lk) b.setAttribute('aria-disabled', 'true'); b.setAttribute('role', 'option'); b.setAttribute('aria-selected', String(i === pickIdx));\n    const cv = document.createElement('span'); cv.className = 'sg-cover sg-c' + i; cv.innerHTML = '<i></i><i></i><i></i><i></i>';\n    const tx = document.createElement('span'); tx.className = 'sg-tx';\n    const nm = document.createElement('b'); nm.textContent = so.name;\n    const mt = document.createElement('span'); mt.className = 'sg-meta'; let best = 0; try { best = parseInt(localStorage.getItem(so.id === 'mirador' ? 'xakira-best' : 'xakira-best-' + so.id) || '0', 10); } catch (e) {}\n    mt.textContent = fmtDur(so.chart.dur) + ' · ' + Math.round(so.chart.bpm) + ' bpm' + (best ? ' · Récord ' + best.toLocaleString('es-CL') : '');\n    if (lk) { mt.textContent = '🔒 Termina Mirador para desbloquearlo'; cv.innerHTML = '<em>🔒</em>'; }\n    tx.append(nm, mt);\n    const st = document.createElement('span'); st.className = 'sg-stars'; st.setAttribute('aria-label', 'Dificultad ' + so.stars + ' de 5');\n    const ss = document.createElement('span'); ss.className = 'sg-st'; for (let k = 1; k <= 5; k++) { const e = document.createElement('i'); e.textContent = '★'; if (k <= so.stars) e.className = 'on'; ss.appendChild(e); }\n    const dl = document.createElement('small'); dl.textContent = DIF[so.stars]; st.append(ss, dl);\n    b.append(cv, tx, st);\n    b.addEventListener('mouseenter', () => { if (!lk && pickIdx !== i) { pickIdx = i; pickRender(); previewSong(SONGS[i]); } });\n    b.addEventListener('click', () => { if (lk) { hint('Primero termina Mirador 🎤', 1600); return; } pickIdx = i; choose(SONGS[i]); });\n    box.appendChild(b);\n  });\n}\nfunction pickSong() {\n  stopSong(); clearSay(); document.body.classList.remove('cine', 'wsp'); ['#w1', '#w2'].forEach((q) => $(q).classList.remove('show')); SKIP.hidden = true; show(null); H.hud.hidden = true;\n  G.mode = 'pick'; pickIdx = Math.max(0, SONGS.indexOf(SONG)); if (locked(SONGS[pickIdx])) pickIdx = 0; $('#sg-sub').textContent = temasOk() ? '¿A cuál le ponemos voz? Mientras eliges, suena un pedacito.' : 'Primero hay que terminar Mirador. Después se desbloquean los otros temas.'; pickRender(); $('#songs').hidden = false; previewSong(SONGS[pickIdx]);\n  setTimeout(() => { const on = document.querySelector('#sg-list .on'); if (on) on.focus(); }, 60);\n}\nasync function choose(so) {\n  if (G.mode !== 'pick') return; G.mode = 'loading'; stopPreview(); $('#sg-go').textContent = 'Cargando…';\n  try { await audioInit(); await decodeSong(so); } catch (e) { $('#sg-go').textContent = 'No se pudo cargar el tema'; G.mode = 'pick'; return; }\n  SONG = so; CHART = so.chart; _bp = 60 / CHART.bpm; AU.buf = so.buf; buildNotes();\n  $('#songs').hidden = true; $('#sg-go').textContent = '♪ Cantar (Enter)'; if (document.activeElement) document.activeElement.blur(); startSong();\n}\nfunction pickKey(e) {\n  if (G.mode !== 'pick') return false;\n  if (e.code === 'ArrowDown' || e.code === 'KeyS' || e.code === 'KeyJ') { e.preventDefault(); do { pickIdx = (pickIdx + 1) % SONGS.length; } while (locked(SONGS[pickIdx])); pickRender(); previewSong(SONGS[pickIdx]); document.querySelector('#sg-list .on').focus(); }\n  else if (e.code === 'ArrowUp' || e.code === 'KeyW' || e.code === 'KeyF') { e.preventDefault(); do { pickIdx = (pickIdx + SONGS.length - 1) % SONGS.length; } while (locked(SONGS[pickIdx])); pickRender(); previewSong(SONGS[pickIdx]); document.querySelector('#sg-list .on').focus(); }\n  else if (e.code === 'Enter' || e.code === 'NumpadEnter' || e.code === 'Space') { e.preventDefault(); choose(SONGS[pickIdx]); }\n  return true;\n}\n$('#sg-go').addEventListener('click', () => choose(SONGS[pickIdx]));\n\naddEventListener('keydown', (e) => {\n  if (tutoKey(e)) return;\n  if (pickKey(e)) return;\n  if (e.target && /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName)) return;\n  if (!$('#editor').hidden) { if (e.code === 'Escape') closeEditor(); return; }\n  if ((G.mode === 'intro' || G.mode === 'outro' || G.mode === 'losecine') && (e.code === 'Enter' || e.code === 'Space' || e.code === 'Escape')) { e.preventDefault(); skipCine(); return; }\n  const l = LANE_KEYS.indexOf(e.code);\n  if (G.mode === 'play') {\n    if (l >= 0) { e.preventDefault(); if (!e.repeat && !keyHeld[l]) { keyHeld[l] = true; press(l); } }\n    if (e.code === 'Space') { e.preventDefault(); if (!e.repeat) useBong(); }\n  }\n  if (e.code === 'KeyP' || (e.code === 'Escape' && (G.mode === 'play' || G.mode === 'pause'))) togglePause();\n  if (e.code === 'KeyM' && AU.ctx) { AU.on = !AU.on; AU.master.gain.value = AU.on ? 0.85 : 0; hint(AU.on ? 'Sonido encendido' : 'Sonido apagado', 1200); }\n});\naddEventListener('keyup', (e) => { const l = LANE_KEYS.indexOf(e.code); if (l >= 0) { keyHeld[l] = false; release(l); } });\naddEventListener('blur', () => { for (let l = 0; l < 4; l++) if (keyHeld[l]) { keyHeld[l] = false; release(l); } });\ndocument.addEventListener('visibilitychange', () => { if (document.hidden && G.mode === 'play') togglePause(); });\n\n/* =========================================================\n   JUGABILIDAD\n   ========================================================= */\nconst WIN_PERFECT = 0.06;\nconst winGood = () => G.volaoT > 0 ? 0.17 : 0.13;\nconst multiplier = () => Math.min(4, 1 + Math.floor(G.combo / 10)) * (G.volaoT > 0 ? 2 : 1);\nfunction press(l) {\n  const t = songTime(), w = winGood();\n  let best = null, bd = 1e9;\n  for (const n of notes) { if (n.lane !== l || n.hit || n.missed) continue; const d = Math.abs(n.t - t); if (d <= w && d < bd) { best = n; bd = d; } if (n.t > t + w) break; }\n  flashes[l].t = 0.18;\n  if (!best) { G.mood = Math.max(0, G.mood - 1.2); sfx.pifia(); return; }\n  best.hit = true; best.gem.visible = false; best.g.children[1].visible = false; if (!best.dur) best.g.visible = false;\n  const perfect = bd <= WIN_PERFECT;\n  G.combo++; G.best = Math.max(G.best, G.combo); G.hits++; if (perfect) G.perfect++;\n  G.score += (perfect ? 100 : 60) * multiplier();\n  G.mood = Math.min(100, G.mood + (perfect ? 2 : 1.5) * (G.volaoT > 0 ? 1.5 : 1));\n  judge(perfect ? '¡Afinado!' : 'Bien', perfect ? 'perfect' : 'good');\n  sfx.voice(l); flashes[l].t = 0.35;\n  if (best.dur > 0) best.holding = true;\n  G.streak++; if (G.streak % 12 === 0 && G.bongs < 3) { G.bongs++; hint('+1 bong cargado (ESPACIO)', 1600); }\n  if (G.combo === 10 || G.combo === 20 || G.combo === 30) showCenter('×' + (1 + G.combo / 10), 700, '');\n}\nfunction release(l) { for (const n of notes) if (n.lane === l && n.holding) { n.holding = false; n.holdEnd = true; if (n.tail) n.tail.material.opacity = 0.25; } }\nfunction missNote(n) {\n  n.missed = true; G.combo = 0; G.streak = 0; G.misses++;\n  G.mood = Math.max(0, G.mood - (songTime() < 12 ? 3 : 6)); sfx.miss(); judge('¡Desafinaste!', 'miss'); G.red = 0.35;\n  if (n.tail) n.tail.material.opacity = 0.2;\n}\nfunction useBong() {\n  if (G.bongs <= 0) { hint('No tienes bong cargado: encadena 12 notas seguidas', 1800); return; }\n  G.bongs--; G.vola += 42; G.volaoT = 8; sfx.bong(); G.flash = 0.12;\n  const m = mouthOf(tironi); for (let i = 0; i < 8; i++) puff(m.x, m.y, m.z, 0xeeeeea, 0.5, 2.2, 0.45);\n  if (G.vola >= 100) { startLose('papa'); return; }\n  showCenter('VOLAO ×2', 900, 'green');\n  if (G.vola > 55) hint('Huele fuerte… si fumas otra vez ahora, entra el papá', 3000);\n}\nfunction updatePlay(dt) {\n  const t = songTime();\n  G.vola = Math.max(0, G.vola - 2 * dt); G.volaoT = Math.max(0, G.volaoT - dt);\n  if (t > 12 && G.volaoT <= 0) G.mood = Math.max(0, G.mood - 0.9 * dt);\n  if (G.vola > 75 && !G.steps) { G.steps = true; hint('Se escuchan pasos en el pasillo… 👀', 2600); } else if (G.vola < 60) G.steps = false;\n  // notas\n  for (const n of notes) {\n    const z = (t - n.t) * SPEED;\n    const tailEnd = n.t + n.dur;\n    if ((n.hit && !n.holding) || z > 1.5 + (n.dur ? n.dur * SPEED : 0) || z < -LEN) { n.g.visible = false; }\n    else { n.g.visible = true; n.g.position.set(n.x, 0, Math.min(z, n.holding ? 0 : z)); }\n    if (!n.hit && !n.missed && t - n.t > winGood()) missNote(n);\n    if (n.holding) {\n      n.g.position.z = 0;\n      const rem = Math.max(0, tailEnd - t); n.tail.scale.z = Math.max(0.001, rem * SPEED); n.tail.position.z = -rem * SPEED / 2;\n      G.score += 40 * dt * multiplier();\n      if (t >= tailEnd) { n.holding = false; n.holdEnd = true; n.g.visible = false; G.score += 50 * multiplier(); }\n      flashes[n.lane].t = Math.max(flashes[n.lane].t, 0.12);\n    }\n  }\n  // líneas de pulso\n  const bp = 60 / CHART.bpm, beat = (t - CHART.b0) / bp;\n  beatLines.forEach((m, i) => { const b = Math.floor(beat) + i; const bz = (t - (CHART.b0 + b * bp)) * SPEED; m.position.z = bz; m.visible = bz <= 0.05 && bz > -LEN + 1; m.material.opacity = b % 4 === 0 ? 0.28 : 0.1; });\n  // ánimo\n  if (G.mood <= 0 && t > 6) { startLose('papao'); return; }\n  if (G.vola >= 100) { startLose('papa'); return; }\n  // letra\n  const LY = SONG.id === 'mirador' ? TXT.letra : []; let li = -1; for (let i = 0; i < LY.length; i++) if (t >= LY[i][0]) li = i;\n  if (li !== G.lyric) { G.lyric = li; H.lyNow.textContent = li >= 0 ? LY[li][1] : ''; H.lyNext.textContent = LY[li + 1] ? LY[li + 1][1] : ''; }\n  if (t >= CHART.end) startOutro();\n}\nfunction updateHUD(t) {\n  H.score.textContent = Math.floor(G.score).toLocaleString('es-CL');\n  H.mult.textContent = '×' + multiplier(); H.multw.classList.toggle('volao', G.volaoT > 0); H.combo.textContent = 'Combo ' + G.combo;\n  H.mood.style.width = G.mood + '%'; H.moodbar.classList.toggle('warn', G.mood < 15);\n  H.moodL.textContent = G.mood < 15 ? '¡se va a rendir!' : G.mood < 40 ? 'trabado' : G.mood < 70 ? 'entusiasmándose' : 'prendido';\n  H.vola.style.width = Math.min(100, G.vola) + '%'; H.volabar.classList.toggle('warn', G.vola > 60);\n  H.volaL.textContent = G.vola < 10 ? 'sobrio' : G.vola < 40 ? 'relajao' : G.vola < 60 ? 'volao' : 'huele fuerte';\n  H.bongs.forEach((b, i) => b.classList.toggle('on', i < G.bongs));\n  H.prog.style.width = clamp(t / CHART.end, 0, 1) * 100 + '%';\n}\n\n/* =========================================================\n   ANIMACIÓN DE PERSONAJES Y CÁMARA\n   ========================================================= */\nconst _cp = new THREE.Vector3(), _cl = new THREE.Vector3();\nfunction setCam(p, l, fov) { camera.position.copy(p); camera.lookAt(l); if (camera.fov !== fov) { camera.fov = fov; camera.updateProjectionMatrix(); } }\nconst PLAY_CAM = { p:V(0.25, 1.9, 2.65), l:V(0.25, 1.05, -0.8), fov:58 };\nfunction animateChars(dt, beat, mood) {\n  const m = mood / 100, ph = beat * Math.PI * 2;\n  // Xakira: encorvado cuando está bajoneado, cabecea al ritmo cuando se prende\n  const nod = Math.max(0, Math.sin(ph)) * 0.18 * smooth((m - 0.25) / 0.5);\n  xakira.headG.rotation.x = lerp(0.42, 0.05, smooth(m * 1.6)) + nod;\n  xakira.headG.rotation.y = 0.15 + Math.sin(beat * 0.5) * 0.08 * m;\n  xakira.armG.forEach((g, i) => { g.rotation.x = Math.max(0, Math.sin(ph * 2 + i * Math.PI)) * 0.08 * m; });\n  pads.forEach((p, i) => p.color.setHex(m > 0.2 && ((Math.floor(beat * 2) + i) % 3 === 0) ? LANE_COL[i % 4] : 0x222230));\n  // Tironi: se mece y gesticula con la mano libre\n  tironi.root.rotation.z = Math.sin(ph * 0.5) * 0.03;\n  tironi.headG.rotation.x = -0.12 + Math.sin(ph) * 0.04;\n  tironi.armG[1].rotation.x = -0.4 - Math.max(0, Math.sin(ph)) * 0.5 * (0.4 + m); tironi.armG[1].rotation.z = -0.25;\n  // luces según el ánimo\n  bulb.intensity = 0.25 + 0.55 * m; faceLight.intensity = 1.4 * smooth(m);\n  ledLight.intensity = 1.2 * smooth((m - 0.2) / 0.6); ledMat.color.setHSL((beat * 0.05) % 1, 0.9, 0.35 + 0.25 * m); ledLight.color.copy(ledMat.color);\n  xakira.headG.getWorldPosition(_w); faceLight.position.set(_w.x + 0.25, _w.y + 0.05, _w.z + 0.45);\n  bongGlass.emissive.setHex(G.volaoT > 0 ? 0x2a6a3a : 0x000000);\n}\n// pantalla DAW (se redibuja)\nfunction drawDAW(t) {\n  const c = T.screenA.userData.canvas, g = c.getContext('2d'), w = c.width, h = c.height;\n  g.fillStyle = '#14161e'; g.fillRect(0, 0, w, h); g.fillStyle = '#1c2030'; g.fillRect(0, 0, w, 24);\n  g.fillStyle = '#9fb3ff'; g.font = 'bold 14px sans-serif'; g.fillText(SONG.id + '_v7_FINAL_ahora_si.prj', 10, 17);\n  const cols = ['#ff4f4f', '#ffd23a', '#3fa0ff', '#4fd36b', '#b46aff'];\n  for (let r = 0; r < 5; r++) { g.fillStyle = '#1a1e2a'; g.fillRect(0, 34 + r * 50, w, 44); for (let k = 0; k < 12; k++) { if ((k * 7 + r * 3) % 5 === 0) continue; g.fillStyle = cols[r]; g.globalAlpha = 0.75; g.fillRect(90 + k * 36, 38 + r * 50, 32, 36); g.globalAlpha = 1; } g.fillStyle = '#c8c8d8'; g.font = '12px sans-serif'; g.fillText(['Bajo', 'Batería', 'Synth', 'Voz', 'FX'][r], 10, 60 + r * 50); }\n  const x = 90 + ((t / CHART.end) * 432) % 432; g.fillStyle = '#fff'; g.fillRect(x, 24, 2, h);\n  T.screenA.needsUpdate = true;\n}\nfunction updateCamera(dt) {\n  if (G.mode === 'play' || G.mode === 'pause') { camera.position.lerp(PLAY_CAM.p, 1 - Math.exp(-3 * dt)); camera.lookAt(PLAY_CAM.l); if (camera.fov !== PLAY_CAM.fov) { camera.fov = PLAY_CAM.fov; camera.updateProjectionMatrix(); } return; }\n  if (G.mode === 'title' || G.mode === 'chat' || G.mode === 'end' || G.mode === 'lost') {\n    const a = G.t * 0.12; setCam(_cp.set(Math.sin(a) * 0.8 + 0.2, 1.7 + Math.sin(a * 0.7) * 0.1, 2.3), _cl.set(-0.2, 1.0, -0.9), 58);\n  }\n}\n\n/* ---------- Cinemáticas ---------- */\nfunction introStep(dt) {\n  G.cineT += dt; const t = G.cineT;\n  const shot = t < 4 ? 0 : t < 8 ? 1 : 2;\n  if (shot !== G.shot) {\n    G.shot = shot;\n    if (shot === 0) { G.stepN = -1; G.doorShut = false; sfx.door(); setTimeout(() => G.mode === 'intro' && say('Tironi', TXT.cineInicio.tironi1), 1500); }\n    if (shot === 1) say('Xakira', TXT.cineInicio.xakira);\n    if (shot === 2) say('Tironi', TXT.cineInicio.tironi2);\n  }\n  // puerta y caminata\n  door.rotation.y = -1.7 * smooth(t / 0.9) * (1 - smooth((t - 3.2) / 0.8)) + 0;\n  if (t < 1.8) { const k1 = smooth((t - 0.6) / 1.2); tironi.root.position.set(lerp(2.0, 1.0, k1), 0, 0.95); }\n  else { const k2 = smooth((t - 1.8) / 1.2); tironi.root.position.set(lerp(1.0, 1.4, k2), 0, lerp(0.95, -0.3, k2)); }\n  tironi.root.rotation.y = lerp(-Math.PI / 2, -1.05, smooth((t - 1.8) / 1.4));\n  const walking = t > 0.6 && t < 3.0, wp = (t - 0.6) * 8.4, amp = walking ? smooth((t - 0.6) / 0.35) * (1 - smooth((t - 2.65) / 0.35)) : 0;\n  tironi.legG.forEach((g, i) => {\n    const ph = wp + i * Math.PI, kn = g.userData.knee;\n    g.rotation.x = amp > 0 ? Math.sin(ph) * 0.42 * amp : g.rotation.x * 0.8;\n    if (kn) kn.rotation.x = amp > 0 ? (0.12 + 0.75 * Math.max(0, -Math.cos(ph))) * amp : kn.rotation.x * 0.8;\n  });\n  // brazo libre (izquierdo) se balancea opuesto a la pierna; el del celular apenas se mueve\n  const la = tironi.armG[1], lf = la.userData.fore;\n  la.rotation.x = amp > 0 ? Math.sin(wp) * 0.38 * amp : la.rotation.x * 0.85; la.rotation.z = -0.06 * amp;\n  if (lf) lf.rotation.x = amp > 0 ? -(0.18 + 0.2 * Math.max(0, Math.sin(wp))) * amp : lf.rotation.x * 0.85;\n  tironi.armG[0].rotation.x = Math.sin(wp * 2) * 0.05 * amp;\n  // cuerpo: sube y baja, se mece de lado y la cabeza mira la pieza\n  tironi.root.position.y = Math.abs(Math.cos(wp)) * 0.028 * amp;\n  tironi.root.rotation.z = Math.sin(wp) * 0.035 * amp;\n  tironi.headG.rotation.set(-0.05 + Math.sin(wp * 2) * 0.02 * amp, Math.sin(t * 1.3) * 0.35 * smooth((t - 0.8) / 0.6) * (1 - smooth((t - 2.6) / 0.6)), 0);\n  // pasos\n  const stepN = walking ? Math.floor(wp / Math.PI) : -1;\n  if (stepN !== G.stepN) { G.stepN = stepN; if (stepN >= 0) sfx.step(stepN % 2); }\n  if (t > 3.95 && !G.doorShut) { G.doorShut = true; sfx.doorClose(); }\n  if (shot === 0) setCam(_cp.set(-0.6, 1.7, 2.1), _cl.set(1.1, 1.2, 0.1), 55);\n  else if (shot === 1) { xakira.headG