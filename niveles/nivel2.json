"<title data-own>Tironi y Xakira</title>\n<meta data-own name=\"claude:viewport-fit-sides\" content=\"cover\">\n<link data-own rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link data-own rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link data-own rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Bungee&family=Chakra+Petch:wght@400;600;700&display=swap\">\n<style data-own>\n/* Layout: lienzo 3D a pantalla completa (pieza de Xakira + pista de notas encima); capas de interfaz superpuestas. Look único oscuro. */\n:root{\n  --void:#14101d;\n  --panel:rgba(24,19,35,.9);\n  --line:#463c61;\n  --text:#f4eddf;\n  --muted:#b9aecb;\n  --bencina:#ffc23a;\n  --bencina-ink:#1c1406;\n  --morado:#5a2a8a;\n  --pito:#8fd694;\n  --rojo:#ff5f4e;\n  --pasao:#ff4fd8;\n  --me:#2e6a4b;\n  --them:#2d2742;\n  --phone:#100e17;\n  --l0:#4fd36b; --l1:#ff4f4f; --l2:#ffd23a; --l3:#3fa0ff;\n  --f-display:\"Bungee\", Impact, \"Arial Black\", sans-serif;\n  --f-ui:\"Chakra Petch\", \"Trebuchet MS\", Verdana, sans-serif;\n  color-scheme:dark;\n}\n[hidden]{display:none!important}\nhtml,body{height:100%}\nbody{margin:0;background:var(--void);color:var(--text);font-family:var(--f-ui);overflow:hidden;-webkit-font-smoothing:antialiased}\n#gl{position:fixed;inset:0;width:100%;height:100%;display:block;z-index:2}\n.layer{position:fixed;inset:0;box-sizing:border-box;z-index:5;\n  padding-top:calc(20px + env(safe-area-inset-top,0px));padding-bottom:calc(20px + env(safe-area-inset-bottom,0px));\n  padding-left:max(16px, env(safe-area-inset-left,0px));padding-right:max(16px, env(safe-area-inset-right,0px))}\n.overlay{display:flex;align-items:center;justify-content:center;overflow:auto;background:linear-gradient(180deg,rgba(20,16,29,.2),rgba(20,16,29,.75))}\nh1,h2,p{margin:0}\n.tag{display:inline-block;font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:12px;color:var(--muted)}\n.muted{color:var(--muted)}\n\n/* ---------- Título ---------- */\n.title-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:32px;width:min(1080px,100%);align-items:end}\n@media (max-width:860px){.title-grid{grid-template-columns:minmax(0,1fr);gap:20px}}\n.title-left,.title-right{display:flex;flex-direction:column;gap:14px;min-width:0}\n.logo{font-family:var(--f-display);font-weight:400;font-size:clamp(64px,10vw,124px);line-height:.86;color:var(--bencina);text-shadow:5px 5px 0 var(--morado),10px 10px 0 rgba(0,0,0,.55)}\n.subtitle{font-family:var(--f-display);font-size:clamp(18px,2.4vw,26px);line-height:1.15;text-shadow:3px 3px 0 #000;text-wrap:balance}\n.card{background:var(--panel);border:2px solid var(--line);padding:16px 18px;display:flex;flex-direction:column;gap:8px}\n.card h2{font-size:21px;font-weight:700;text-wrap:balance}\n.card p{font-size:15px;line-height:1.5;color:var(--muted);max-width:60ch}\n.small-h{font-family:var(--f-display);font-weight:400;font-size:20px;text-shadow:2px 2px 0 #000}\n.keys{display:grid;grid-template-columns:auto minmax(0,1fr);gap:6px 14px;font-size:14px;background:var(--panel);border:2px solid var(--line);padding:12px 14px;margin:0}\n.keys dt{white-space:nowrap}\n.keys dd{margin:0;color:var(--muted)}\nkbd{font-family:var(--f-ui);font-weight:700;font-size:12px;padding:1px 6px;border:2px solid var(--line);border-bottom-width:4px;background:var(--void);color:var(--text)}\nkbd.l0{border-color:var(--l0)}kbd.l1{border-color:var(--l1)}kbd.l2{border-color:var(--l2)}kbd.l3{border-color:var(--l3)}\n.actions{display:flex;gap:12px;align-items:center;flex-wrap:wrap}\n.btn{font-family:var(--f-display);font-size:22px;background:var(--bencina);color:var(--bencina-ink);border:0;padding:13px 28px;cursor:pointer;box-shadow:5px 5px 0 var(--morado)}\n.btn:hover{filter:brightness(1.06)}\n.btn:active{transform:translate(3px,3px);box-shadow:2px 2px 0 var(--morado)}\n.btn:disabled{opacity:.6;cursor:wait}\n.btn.ghost{background:transparent;color:var(--text);border:2px solid var(--line);box-shadow:none;font-family:var(--f-ui);font-weight:700;font-size:15px;padding:10px 16px}\n.btn.small{font-size:17px;padding:10px 18px}\n:focus-visible{outline:3px solid var(--pito);outline-offset:3px}\n.note{font-weight:700;color:var(--bencina)}\n\n/* ---------- Chat ---------- */\n.phone{width:min(390px,100%);height:min(680px,100%);display:flex;flex-direction:column;background:var(--phone);border:3px solid #2b2540;box-shadow:8px 8px 0 rgba(0,0,0,.5)}\n.phone header{display:flex;gap:12px;align-items:center;padding:12px 14px;background:#1d2a23;border-bottom:2px solid #13201a}\n.avatar{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;font-family:var(--f-display);background:linear-gradient(135deg,#5a2a35,#6f5a42);color:#fff;flex:none;border:2px solid #2d3a33}\n.who{min-width:0}\n.who b{display:block;font-size:17px}\n.who span{font-size:13px;color:#a9d6b6}\n.msgs{flex:1;min-height:0;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:6px;background:#15121f}\n.msg{max-width:82%;padding:7px 10px 5px;font-size:15px;line-height:1.38;overflow-wrap:anywhere}\n.msg time{display:block;text-align:right;font-size:11px;color:rgba(255,255,255,.5);margin-top:2px}\n.msg.me{align-self:flex-end;background:var(--me);border-radius:10px 10px 2px 10px}\n.msg.them{align-self:flex-start;background:var(--them);border-radius:10px 10px 10px 2px}\n.msg.sys{align-self:center;background:rgba(255,194,58,.1);color:var(--bencina);font-size:13px;text-align:center;border:1px dashed rgba(255,194,58,.5);max-width:94%}\n.typing{align-self:flex-start;background:var(--them);border-radius:10px;padding:10px 12px;display:flex;gap:4px}\n.typing i{width:6px;height:6px;border-radius:50%;background:var(--muted);animation:dot 1s infinite}\n.typing i:nth-child(2){animation-delay:.15s}.typing i:nth-child(3){animation-delay:.3s}\n@keyframes dot{0%,60%,100%{opacity:.3}30%{opacity:1}}\n.phone footer{padding:12px;display:flex;gap:10px;justify-content:space-between;align-items:center;flex-wrap:wrap;border-top:2px solid #241f33;background:#1a1626}\n.draft{font-size:12px;color:var(--muted);padding:6px 14px 0;background:#15121f}\n\n/* ---------- HUD ---------- */\n.hud{pointer-events:none}\n.hud-l{position:absolute;top:calc(14px + env(safe-area-inset-top,0px));left:max(16px, env(safe-area-inset-left,0px));display:flex;flex-direction:column;gap:6px;width:min(260px,30vw)}\n.hud-r{position:absolute;top:calc(14px + env(safe-area-inset-top,0px));right:max(16px, env(safe-area-inset-right,0px));display:flex;flex-direction:column;gap:6px;width:min(260px,30vw);align-items:stretch}\n.score{font-family:var(--f-display);font-size:40px;line-height:1;text-shadow:3px 3px 0 #000;font-variant-numeric:tabular-nums}\n.mult{display:inline-flex;align-items:center;gap:8px;font-weight:700;font-size:16px;text-shadow:2px 2px 0 #000;text-transform:uppercase;letter-spacing:.06em}\n.mult b{font-family:var(--f-display);font-weight:400;font-size:26px;color:var(--bencina)}\n.mult.volao b{color:var(--pito)}\n.meter-label{display:flex;justify-content:space-between;font-weight:700;font-size:13px;text-transform:uppercase;letter-spacing:.08em;text-shadow:2px 2px 0 #000}\n.meter{height:16px;border:2px solid #000;background:rgba(10,8,16,.75);position:relative}\n.meter i{display:block;height:100%;width:50%}\n#m-mood{background:linear-gradient(90deg,#ff5f4e,#ffc23a 45%,#8fd694)}\n#m-vola{background:var(--pito)}\n.meter.warn{animation:blink .4s steps(2) infinite}\n@keyframes blink{50%{opacity:.4}}\n.bongs{display:flex;gap:6px;justify-content:flex-end}\n.bongs i{width:18px;height:26px;border:2px solid #000;border-radius:9px 9px 6px 6px;background:rgba(10,8,16,.7)}\n.bongs i.on{background:linear-gradient(180deg,#bff5c8,#4fb46a)}\n#lyrics{position:absolute;top:calc(14px + env(safe-area-inset-top,0px));left:50%;transform:translateX(-50%);width:min(560px,36vw);text-align:center;background:rgba(10,8,16,.72);border:2px solid var(--line);padding:8px 12px}\n#lyrics .now{font-weight:700;font-size:clamp(15px,1.6vw,20px);line-height:1.3;min-height:1.3em}\n#lyrics .next{font-size:13px;color:var(--muted);min-height:1.2em}\n#prog{position:absolute;left:50%;transform:translateX(-50%);top:calc(6px + env(safe-area-inset-top,0px));width:min(560px,36vw);height:4px;background:rgba(255,255,255,.15)}\n#prog i{display:block;height:100%;width:0;background:var(--bencina)}\n#judge{position:absolute;left:50%;bottom:31%;transform:translateX(-50%);font-family:var(--f-display);font-size:clamp(22px,3vw,34px);text-shadow:3px 3px 0 #000;opacity:0;transition:opacity .12s}\n#judge.show{opacity:1}\n#judge.perfect{color:var(--pito)}#judge.good{color:#fff}#judge.miss{color:var(--rojo)}\n#center{position:absolute;top:34%;left:0;right:0;text-align:center;font-family:var(--f-display);font-size:clamp(44px,8vw,100px);color:var(--bencina);text-shadow:5px 5px 0 var(--morado),9px 9px 0 rgba(0,0,0,.5);opacity:0;transition:opacity .15s}\n#center.show{opacity:1}\n#center.green{color:var(--pito)}\n#hint{position:absolute;bottom:calc(22px + env(safe-area-inset-bottom,0px));left:50%;transform:translateX(-50%);max-width:min(560px,70vw);text-align:center;font-weight:700;font-size:15px;background:rgba(10,8,16,.8);border:2px solid var(--line);padding:6px 12px;opacity:0;transition:opacity .25s}\n#hint.show{opacity:1}\n\n/* ---------- Cinemáticas ---------- */\n#letterbox{position:fixed;inset:0;pointer-events:none;z-index:6}\n#letterbox i{position:absolute;left:0;right:0;height:0;background:#000;transition:height .5s ease}\n#letterbox i:first-child{top:0}#letterbox i:last-child{bottom:0}\nbody.cine #letterbox i{height:11vh}\n#subs{position:fixed;z-index:7;left:50%;bottom:calc(11vh + 18px);transform:translateX(-50%);width:min(760px,88vw);text-align:center;font-size:clamp(17px,2vw,22px);font-weight:700;line-height:1.35;text-shadow:2px 2px 0 #000;opacity:0;transition:opacity .2s;pointer-events:none}\n#subs.show{opacity:1}\n#subs b{color:var(--bencina);margin-right:.5em;text-transform:uppercase;letter-spacing:.06em}\nbody.wsp #subs{bottom:auto;top:50%;left:auto;right:max(16px, calc(50vw - var(--pw) / 2 - 330px));transform:translateY(-50%);width:min(280px,calc(50vw - var(--pw) / 2 - 40px));text-align:left;background:rgba(10,8,16,.8);border:2px solid var(--line);padding:12px 14px}\n#skip{position:fixed;z-index:8;right:max(16px, env(safe-area-inset-right,0px));bottom:calc(16px + env(safe-area-inset-bottom,0px));background:rgba(10,8,16,.7)}\n/* celular con WhatsApp del final */\n:root{--ph:min(74vh,150vw);--pw:calc(var(--ph) * 9 / 16)}\n#wsp{pointer-events:none;position:fixed;left:50%;top:50%;width:var(--pw);height:var(--ph);transform:translate(-50%,-40%) scale(.9);opacity:0;z-index:6;border-radius:calc(var(--ph) * .05);overflow:hidden;background:#0d1418;display:flex;flex-direction:column;\n  box-shadow:0 0 0 calc(var(--ph) * .022) #0b0b0f,0 0 0 calc(var(--ph) * .027) #3a3a46,0 30px 120px 40px rgba(0,0,0,.6);transition:opacity .5s,transform .7s cubic-bezier(.2,.8,.2,1);font-size:calc(var(--ph) * .022)}\nbody.wsp #wsp{opacity:1;transform:translate(-50%,-50%) scale(1)}\n#wsp header{display:flex;gap:.7em;align-items:center;padding:1.6em .9em .7em;background:#1f2c33}\n#wsp header .av{width:2.2em;height:2.2em;border-radius:50%;background:linear-gradient(135deg,#b83a3a,#2b59cc);display:grid;place-items:center;font-family:var(--f-display)}\n#wsp header b{display:block}#wsp header span{font-size:.8em;color:#9fb3ba}\n#wsp .w-msgs{flex:1;padding:.8em;display:flex;flex-direction:column;gap:.5em;justify-content:flex-end;background:#0b141a}\n#wsp .w-msg{align-self:flex-end;max-width:85%;background:#005c4b;border-radius:.6em .6em .15em .6em;padding:.5em .7em;opacity:0;transform:translateY(8px);transition:opacity .3s,transform .3s}\n#wsp .w-msg.show{opacity:1;transform:none}\n#wsp .w-audio{display:flex;align-items:center;gap:.6em;min-width:12em}\n#wsp .w-audio i{width:2em;height:2em;border-radius:50%;background:#7fdcc6;flex:none;position:relative}\n#wsp .w-audio i::after{content:\"\";position:absolute;left:.75em;top:.55em;border-left:.65em solid #005c4b;border-top:.45em solid transparent;border-bottom:.45em solid transparent}\n#wsp .w-wave{flex:1;height:1.6em;background:repeating-linear-gradient(90deg,#b8e6da 0 2px,transparent 2px 5px);mask:linear-gradient(0deg,transparent 0 20%,#000 20% 80%,transparent 80%);opacity:.8}\n#wsp .w-meta{font-size:.75em;color:#b6d6cc;text-align:right;margin-top:.2em}\n#wsp footer{padding:.6em .8em 1.4em;background:#0b141a;color:#7d8f96;font-size:.9em}\n/* panel de derrota */\n.lose-card{background:var(--panel);border:2px solid var(--line);padding:22px;display:flex;flex-direction:column;gap:12px;align-items:flex-start;width:min(420px,100%)}\n.lose-card h2{font-family:var(--f-display);font-weight:400;font-size:34px;color:var(--rojo)}\n.lose-card p{line-height:1.5;color:var(--muted)}\n.pause-card{background:var(--panel);border:2px solid var(--line);padding:22px;display:flex;flex-direction:column;gap:14px;align-items:flex-start;width:min(360px,100%)}\n.pause-card h2{font-family:var(--f-display);font-weight:400;font-size:34px;color:var(--bencina)}\n#fatal{max-width:46ch;line-height:1.5}\n/* ---------- Editor de textos ---------- */\n#editor{z-index:9;align-items:flex-start}\n.ed{width:min(880px,100%);max-height:100%;display:flex;flex-direction:column;background:var(--panel);border:2px solid var(--line);box-shadow:8px 8px 0 rgba(0,0,0,.5);margin:auto;min-height:0}\n.ed header{padding:16px 18px;border-bottom:2px solid var(--line);display:flex;flex-direction:column;gap:6px}\n.ed header h2{font-family:var(--f-display);font-weight:400;font-size:26px;color:var(--bencina)}\n.ed header p{color:var(--muted);font-size:14px;line-height:1.45;max-width:66ch}\n.ed-body{overflow-y:auto;padding:4px 18px 18px;display:flex;flex-direction:column;gap:10px;min-height:0}\n.ed-sec{display:flex;flex-direction:column;gap:6px;padding-top:10px;border-top:1px solid rgba(255,255,255,.08)}\n.ed-sec:first-child{border-top:0}\n.ed-sec h3{font-size:15px;text-transform:uppercase;letter-spacing:.08em;margin:4px 0 0}\n.ed-sec .hint{color:var(--muted);font-size:13px;margin:0 0 4px;line-height:1.4}\n.ed-row{display:grid;grid-template-columns:140px minmax(0,1fr) auto;gap:8px;align-items:start}\n.ed-row.timed{grid-template-columns:96px minmax(0,1fr) auto}\n.ed select,.ed input,.ed textarea{font:inherit;font-size:14px;background:var(--void);color:var(--text);border:2px solid var(--line);padding:6px 8px;min-width:0;box-sizing:border-box}\n.ed textarea{resize:vertical;min-height:38px;line-height:1.35;width:100%}\n.ed select:focus,.ed input:focus,.ed textarea:focus{border-color:var(--bencina);outline:none}\n.ed .field{display:grid;grid-template-columns:210px minmax(0,1fr);gap:8px;align-items:start}\n.ed .field label{color:var(--muted);font-size:13px;padding-top:9px}\n.ed .tools{display:flex;gap:4px}\n.ed .ib{background:transparent;border:2px solid var(--line);color:var(--text);width:34px;height:34px;cursor:pointer;font:inherit;font-weight:700}\n.ed .ib:hover{border-color:var(--muted)}\n.ed .ib:disabled{opacity:.3;cursor:default}\n.ed .add{align-self:flex-start;background:transparent;border:2px dashed var(--line);color:var(--muted);padding:6px 12px;font:inherit;font-weight:700;cursor:pointer}\n.ed .add:hover{color:var(--text);border-color:var(--muted)}\n.ed footer{padding:12px 18px;border-top:2px solid var(--line);display:flex;gap:10px;flex-wrap:wrap;align-items:center}\n.ed-status{color:var(--muted);font-size:14px;flex:1 1 220px;min-width:0}\n.ed-status.err{color:var(--rojo, #ff5f4e)}\n.ed-status.ok{color:var(--pito)}\n#edit-btn{font-size:14px}\n@media (max-width:640px){.ed-row,.ed-row.timed,.ed .field{grid-template-columns:minmax(0,1fr)}.ed .field label{padding-top:0}}\n@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n\n/* ---------- Tutorial: cómo se juega ---------- */\n#tuto{z-index:8;align-items:flex-start}\n.tuto{width:min(1000px,100%);margin:auto;background:var(--panel);border:2px solid var(--line);box-shadow:8px 8px 0 rgba(0,0,0,.5);display:flex;flex-direction:column;max-height:100%;min-height:0}\n.tuto-head{padding:18px 22px 14px;border-bottom:2px solid var(--line);display:flex;flex-direction:column;gap:10px}\n.tuto-head h2{font-family:var(--f-display);font-weight:400;font-size:clamp(26px,3.2vw,38px);line-height:1.05;color:var(--bencina);text-shadow:3px 3px 0 var(--morado)}\n.tuto-goal{display:flex;gap:10px;align-items:flex-start;background:rgba(255,194,58,.1);border:2px solid rgba(255,194,58,.45);padding:10px 12px;font-size:16px;line-height:1.45;font-weight:600;max-width:80ch}\n.tuto-goal b{color:var(--bencina);text-transform:uppercase;letter-spacing:.1em;font-size:13px;padding-top:2px;white-space:nowrap}\n.tuto-body{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:20px 28px;padding:16px 22px;overflow-y:auto;min-height:0}\n.tuto h3{font-size:13px;text-transform:uppercase;letter-spacing:.14em;color:var(--muted);margin:0 0 10px}\n.tuto-ctl{display:grid;grid-template-columns:auto minmax(0,1fr);gap:12px 14px;align-items:center}\n.tuto-keys{display:flex;gap:5px;flex-wrap:nowrap;justify-content:flex-end}\n.tuto kbd{font-family:var(--f-ui);font-weight:700;font-size:15px;min-width:24px;text-align:center;padding:5px 9px;border:2px solid var(--line);border-bottom-width:5px;background:var(--void);color:var(--text);transition:transform .06s,background-color .06s}\n.tuto kbd.l0{border-color:#4fd36b}.tuto kbd.l1{border-color:#ff4f4f}.tuto kbd.l2{border-color:#ffd23a}.tuto kbd.l3{border-color:#3fa0ff}\n.tuto kbd.on{background:var(--bencina);color:var(--bencina-ink);border-color:var(--bencina);transform:translateY(3px);border-bottom-width:2px}\n.tuto-ctl p{font-size:15px;line-height:1.4;margin:0}\n.tuto-side{display:flex;flex-direction:column;gap:18px;min-width:0}\n.tuto-hud{display:flex;flex-direction:column;gap:12px}\n.tuto-h{display:grid;grid-template-columns:118px minmax(0,1fr);gap:12px;align-items:center}\n.tuto-h p{font-size:14px;line-height:1.4;color:var(--muted);margin:0}\n.tuto-mini{display:flex;flex-direction:column;gap:4px;font-weight:700;font-size:11px;text-transform:uppercase;letter-spacing:.08em}\n.tuto-meter{height:12px;border:2px solid #000;background:rgba(10,8,16,.75)}\n.tuto-meter i{display:block;height:100%}\n.tuto-meter.box{position:relative}\n.tuto-meter.box b{position:absolute;top:-4px;bottom:-4px;left:45%;width:38%;border:2px solid #8fd694}\n.tuto-icons{display:flex;gap:7px}\n.tuto-icons i{display:block;width:22px;height:7px;background:#f2efe6;border:2px solid #000;position:relative}\n.tuto-icons i::after{content:\"\";position:absolute;right:-6px;top:-2px;width:5px;height:7px;background:#ff7a2e;border:2px solid #000;border-left:0}\n.tuto-icons.bong i{width:14px;height:20px;border-radius:7px 7px 5px 5px;background:linear-gradient(180deg,#bff5c8,#4fb46a)}\n.tuto-icons.bong i::after{display:none}\n.tuto-map{width:64px;height:64px;background:rgba(10,8,16,.75);border:2px solid rgba(255,255,255,.25)}\n.tuto-tips{margin:0;padding-left:18px;display:flex;flex-direction:column;gap:7px;font-size:14px;line-height:1.4}\n.tuto-foot{padding:12px 22px;border-top:2px solid var(--line);display:flex;gap:14px;align-items:center;justify-content:space-between;flex-wrap:wrap}\n.tuto-foot span{color:var(--muted);font-size:14px}\n@media (max-width:760px){.tuto-body{grid-template-columns:minmax(0,1fr)}.tuto-h{grid-template-columns:minmax(0,1fr)}}\n\n.sg-item.locked{opacity:.5;cursor:not-allowed;filter:grayscale(.7)}\n.sg-item.locked:hover{border-color:var(--line)}\n.sg-cover em{font-style:normal;font-size:24px;align-self:center;margin-bottom:-12px}\n/* ---------- elegir tema ---------- */\n#songs{z-index:8}\n.sg{width:min(640px,100%);margin:auto;background:var(--panel);border:2px solid var(--line);box-shadow:8px 8px 0 rgba(0,0,0,.5);display:flex;flex-direction:column;max-height:100%;min-height:0}\n.sg-head{padding:18px 22px 12px;border-bottom:2px solid var(--line);display:flex;flex-direction:column;gap:6px}\n.sg-head h2{font-family:var(--f-display);font-weight:400;font-size:clamp(28px,3.4vw,40px);line-height:1.05;color:var(--bencina);text-shadow:3px 3px 0 var(--morado)}\n.sg-head p{color:var(--muted);font-size:15px}\n.sg-list{display:flex;flex-direction:column;gap:8px;padding:14px 16px;overflow-y:auto;min-height:0}\n.sg-item{display:grid;grid-template-columns:64px minmax(0,1fr) auto;gap:14px;align-items:center;text-align:left;background:rgba(10,8,16,.55);border:2px solid var(--line);padding:9px 12px;cursor:pointer;color:var(--text);font:inherit;transition:transform .12s,border-color .12s}\n.sg-item:hover{border-color:var(--muted)}\n.sg-item.on{border-color:var(--bencina);background:rgba(255,194,58,.08);box-shadow:4px 4px 0 var(--bencina);transform:translate(-2px,-2px)}\n.sg-item:focus-visible{outline:3px solid var(--pito);outline-offset:2px}\n.sg-cover{width:64px;height:64px;display:flex;align-items:flex-end;justify-content:center;gap:4px;padding-bottom:12px;box-sizing:border-box;border:2px solid #000}\n.sg-cover i{width:7px;height:10px;background:rgba(255,255,255,.85);display:block}\n.sg-item.on .sg-cover i{animation:eq .7s ease-in-out infinite alternate}\n.sg-item.on .sg-cover i:nth-child(2){animation-delay:.2s}.sg-item.on .sg-cover i:nth-child(3){animation-delay:.4s}.sg-item.on .sg-cover i:nth-child(4){animation-delay:.1s}\n@keyframes eq{from{height:8px}to{height:34px}}\n.sg-c0{background:linear-gradient(135deg,#ff8a3a,#5a2a8a)}\n.sg-c1{background:linear-gradient(135deg,#3fd3c8,#2a3a9a)}\n.sg-c2{background:linear-gradient(135deg,#ff4fb8,#2a1240)}\n.sg-c3{background:linear-gradient(135deg,#8fd694,#1f6a8a 60%,#ffd23a)}\n.sg-tx{display:flex;flex-direction:column;gap:3px;min-width:0}\n.sg-tx b{font-size:clamp(18px,2vw,22px);font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.sg-meta{font-size:13px;color:var(--muted);font-variant-numeric:tabular-nums}\n.sg-stars{display:flex;flex-direction:column;align-items:flex-end;gap:2px}\n.sg-st{displ