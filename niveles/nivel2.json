n.x, 0.5, 1 - Math.exp(-3 * dt));\n  if (t > 5.5) showLose();\n}\n\n/* =========================================================\n   BUCLE\n   ========================================================= */\nlet last = performance.now();\nlet _bp = 60 / CHART.bpm;\nfunction resize() {\n  const w = Math.max(1, innerWidth), h = Math.max(1, innerHeight);\n  PR = Math.min(window.devicePixelRatio || 1, 2); renderer.setPixelRatio(PR); renderer.setSize(w, h, false);\n  rt.setSize(Math.round(w * PR), Math.round(h * PR));\n  camera.aspect = w / h; camera.updateProjectionMatrix(); hlCam.aspect = w / h; hlCam.updateProjectionMatrix();\n  const narrow = w / h < 1.3; hlCam.position.set(0, narrow ? 4.2 : 3.3, narrow ? 5.6 : 4.1); hlCam.lookAt(0, 0, -5.2);\n}\naddEventListener('resize', resize); resize();\nfunction frame(now) {\n  requestAnimationFrame(frame);\n  const dt = Math.min(0.05, (now - last) / 1000); last = now;\n  if (G.mode !== 'pause') step(dt);\n  postMat.uniforms.uTime.value = G.t;\n  renderer.setRenderTarget(rt); renderer.render(scene, camera);\n  renderer.setRenderTarget(null); renderer.render(postScene, postCam);\n  if (G.mode === 'play' || G.mode === 'pause') { renderer.autoClear = false; renderer.clearDepth(); renderer.render(hlScene, hlCam); renderer.autoClear = true; }\n}\nfunction step(dt) {\n  G.t += dt;\n  const st = (G.mode === 'play' || G.mode === 'outro') ? songTime() : G.t;\n  const beat = (st - CHART.b0) / _bp;\n  if (G.mode === 'play') { updatePlay(dt); updateHUD(st); drawDAW(st); }\n  else if (G.mode === 'intro') introStep(dt);\n  else if (G.mode === 'outro') { outroStep(dt); G.mood = Math.min(100, G.mood + 40 * dt); }\n  else if (G.mode === 'losecine') loseStep(dt);\n  animateChars(dt, beat, G.mode === 'play' || G.mode === 'outro' || G.mode === 'losecine' ? G.mood : (G.mode === 'title' ? 55 : 20));\n  for (let l = 0; l < 4; l++) {\n    const f = flashes[l]; f.t = Math.max(0, f.t - dt); f.sp.material.opacity = Math.min(1, f.t * 4);\n    targets[l].fill