=================================================\n   PERSONAJES LOW-POLY: mallas continuas con ropa y cara pintadas en texturas\n   ========================================================= */\nlet chSeed = 11;\nconst chR = () => (chSeed = (chSeed * 16807) % 2147483647) / 2147483647;\nconst chHex = (n) => '#' + (n >>> 0).toString(16).padStart(6, '0');\nfunction chCanvas(w, h, fn) {\n  const c = document.createElement('canvas'); c.width = w; c.height = h; const g = c.getContext('2d'); fn(g, w, h);\n  const t = new THREE.CanvasTexture(c); t.wrapS = THREE.RepeatWrapping; t.anisotropy = 4; return t;\n}\nfunction chNoise(g, w, h, amt, n, y0) {\n  for (let i = 0; i < n; i++) {\n    g.fillStyle = chR() < 0.5 ? 'rgba(0,0,0,' + (amt * chR()).toFixed(3) + ')' : 'rgba(255,255,255,' + (amt * 0.6 * chR()).toFixed(3) + ')';\n    g.fillRect(chR() * w | 0, (y0 || 0) + (chR() * h | 0), 1 + (chR() * 2 | 0), 1 + (chR() * 2 | 0));\n  }\n}\nfunction chWrap(g, w, h, k) {\n  const gr = g.createLinearGradient(0, 0, w, 0);\n  gr.addColorStop(0, 'rgba(0,0,0,' + k + ')'); gr.addColorStop(0.28, 'rgba(0,0,0,0)'); gr.addColorStop(0.72, 'rgba(0,0,0,0)'); gr.addColorStop(1, 'rgba(0,0,0,' + k + ')');\n  g.fillStyle = gr; g.fillRect(0, 0, w, h);\n}\nfunction chFolds(g, w, h, n, col, lw) {\n  g.lineCap = 'round';\n  for (let i = 0; i < n; i++) {\n    const x = chR() * w, y = chR() * h, l = 8 + chR() * 20, a = (chR() - 0.5) * 16, b = (chR() - 0.5) * 12;\n    g.strokeStyle = 'rgba(255,255,255,.10)'; g.lineWidth = (lw || 2) * 0.8; g.beginPath(); g.moveTo(x - 2, y); g.quadraticCurveTo(x - 2 + a, y + l * 0.5, x - 2 + b, y + l); g.stroke();\n    g.strokeStyle = col; g.lineWidth = lw || 2; g.beginPath(); g.moveTo(x, y); g.quadraticCurveTo(x + a, y + l * 0.5, x + b, y + l); g.stroke();\n  }\n}\n// sombra \"horneada\" en los extremos de una pieza (axilas, cintura, rodillas) y luz al medio\nfunction chBake(g, w, h, top, bot) {\n  const gr = g.createLinearGradient(0, 0, 0, h);\n  gr.addColorStop(0, 'rgba(0,0,0,' + top + ')'); gr.addColorStop(0.15, 'rgba(0,0,0,0)'); gr.addColorStop(0.85, 'rgba(0,0,0,0)'); gr.addColorStop(1, 'rgba(0,0,0,' + bot + ')');\n  g.fillStyle = gr; g.fillRect(0, 0, w, h);\n}\nconst chMat = (map, o) => new THREE.MeshPhongMaterial(Object.assign({ map:map || null, flatShading:true, shininess:6, specular:0x111111 }, o || {}));\n// Malla tipo \"loft\": anillos (polígonos) a lo largo de +y. u rodea el cuerpo (frente en u=0.5), v sube por la altura.\n// rz = radio hacia adelante, rzb = hacia atrás, sq = exponente (2 = óvalo, más alto = más cuadrado). shape(x, y, z, phi) puede deformar cada vértice (phi = 0 al frente).\nfunction chLoft(rings, sides, capBot, capTop, shape) {\n  const pos = [], uv = [], idx = [], S = sides, R = rings.length, y0 = rings[0].y, span = (rings[R - 1].y - y0) || 1;\n  for (let r = 0; r < R; r++) {\n    const q = rings[r], e = 2 / (q.sq || 2);\n    for (let s = 0; s <= S; s++) {\n      const th = Math.PI + s / S * Math.PI * 2, sn = Math.sin(th), cs = Math.cos(th);\n      let x = (q.x || 0) + Math.sign(sn) * Math.pow(Math.abs(sn), e) * q.rx, z = (q.z || 0) + Math.sign(cs) * Math.pow(Math.abs(cs), e) * (cs < 0 && q.rzb != null ? q.rzb : q.rz);\n      if (shape) { const o = shape(x, q.y, z, th - Math.PI * 2); x = o[0]; z = o[1]; }\n      pos.push(x, q.y, z); uv.push(s / S, (q.y - y0) / span);\n    }\n  }\n  for (let r = 0; r < R - 1; r++) for (let s = 0; s < S; s++) { const a = r * (S + 1) + s, b = a + 1, c = a + S + 1, d = c + 1; idx.push(a, b, c, b, d, c); }\n  const cap = (r, top) => { const q = rings[r], ci = pos.length / 3; pos.push(q.x || 0, q.y, q.z || 0); uv.push(0.5, top ? 1 : 0); for (let s = 0; s < S; s++) { const a = r * (S + 1) + s, b = a + 1; if (top) idx.push(ci, a, b); else idx.push(ci, b, a); } };\n  if (capBot) cap(0, false); if (capTop) cap(R - 1, true);\n  const geo = new THREE.BufferGeometry(); geo.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3)); geo.setAttribute('uv', new THREE.Float32BufferAttribute(uv, 2)); geo.setIndex(idx); geo.computeVertexNormals(); return geo;\n}\n// pieza entre A y B; fwd = hacia dónde mira el \"frente\" de la pieza (por defecto, adelante del personaje)\nconst chFwd = new THREE.Vector3(0, 0, 1), chMx = new THREE.Matrix4();\nfunction chSegment(A, B, prof, sides, mat, parent, cb, ct, fwd) {\n  const d = new THREE.Vector3().subVectors(B, A), len = d.length(); d.normalize();\n  const m = new THREE.Mesh(chLoft(prof.map(([t, rx, rz, rzb, sq]) => ({ y:t * len, rx, rz, rzb, sq })), sides, cb, ct), mat);\n  let z = (fwd || chFwd).clone().addScaledVector(d, -d.dot(fwd || chFwd));\n  if (z.lengthSq() < 1e-4) z = new THREE.Vector3(0, -1, 0).addScaledVector(d, d.y);\n  z.normalize(); const x = new THREE.Vector3().crossVectors(d, z);\n  chMx.makeBasis(x, d, z); m.quaternion.setFromRotationMatrix(chMx);\n  m.position.copy(A); parent.add(m); return m;\n}\n// ---- texturas pintadas ----\nfunction chTorsoTex(c) {\n  return chCanvas(128, 128, (g, w, h) => {\n    g.fillStyle = chHex(c.top); g.fillRect(0, 0, w, h); chNoise(g, w, h, 0.07, 1400);\n    const y = (t) => (1 - t) * h;\n    if (c.kind === 'uc') {\n      g.fillStyle = '#c8202e'; g.fillRect(0, y(0.66), w, 4); g.fillRect(0, y(0.47) - 4, w, 4);\n      g.fillStyle = '#1b3f95'; g.fillRect(0, y(0.66) + 4, w, y(0.47) - y(0.66) - 8); g.fillRect(0, 0, w, y(0.94));\n      g.beginPath(); g.moveTo(52, 0); g.lineTo(64, 13); g.lineTo(76, 0); g.fill();\n      chFolds(g, w, h, 12, 'rgba(60,60,80,.16)');\n    } else if (c.kind === 'jacket') {\n      g.fillStyle = 'rgba(0,0,0,.35)'; g.fillRect(62, 0, 4, h); g.fillStyle = 'rgba(255,255,255,.4)'; for (let yy = 2; yy < h; yy += 4) g.fillRect(63, yy, 2, 2);\n      g.fillStyle = 'rgba(0,0,0,.2)'; g.fillRect(34, 86, 20, 14); g.fillRect(74, 86, 20, 14); g.fillRect(0, h - 9, w, 9);\n      g.fillStyle = 'rgba(0,0,0,.15)'; g.fillRect(31, 0, 2, h); g.fillRect(95, 0, 2, h);\n      chFolds(g, w, h, 18, 'rgba(60,40,20,.2)', 2.5);\n    } else if (c.kind === 'shirt') {\n     