t-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>';\nfunction edStatus(text, cls) { const s = $('#ed-status'); s.textContent = text; s.className = 'ed-status ' + (cls || ''); }\nfunction edTextarea(value, onInput) {\n  const ta = document.createElement('textarea'); ta.value = value; ta.rows = Math.min(4, Math.max(1, Math.ceil(String(value).length / 64)));\n  ta.addEventListener('input', () => onInput(ta.value)); return ta;\n}\nfunction edBtn(label, title, fn, disabled) { const b = document.createElement('button'); b.type = 'button'; b.className = 'ib'; b.textContent = label; b.title = title; b.setAttribute('aria-label', title); b.disabled = !!disabled; b.addEventListener('click', fn); return b; }\nfunction edRender() {\n  const body = $('#ed-body'), keep = body.scrollTop; body.innerHTML = '';\n  for (const sec of TX_SCHEMA) {\n    const s = document.createElement('section'); s.className = 'ed-sec';\n    const h = document.createElement('h3'); h.textContent = sec.label; s.appendChild(h);\n    if (sec.hint) { const p = document.createElement('p'); p.className = 'hint'; p.textContent = sec.hint; s.appendChild(p); }\n    if (sec.type === 'chat' || sec.type === 'timed') {\n      const list = ED.draft[sec.key];\n      list.forEach((row, i) => {\n        const r = document.createElement('div'); r.className = 'ed-row' + (sec.type === 'timed' ? ' timed' : '');\n        if (sec.type === 'chat') {\n          const sel = document.createElement('select'); sel.setAttribute('aria-label', 'Quién habla');\n          for (const [v, l] of Object.entries(sec.who)) { const o = document.createElement('option'); o.value = v; o.textContent = l; sel.appendChild(o); }\n          sel.value = row[0]; sel.addEventListener('change', () => { row[0] = sel.value; }); r.appendChild(sel);\n        } else {\n          const n = document.createElement('input'); n.type = 'number'; n.min = '0'; n.step = '0.1'; n.value = row[0]; n.setAttribute('aria-label', 'Segundo de la canción');\n          n.addEventListener('input', () => { row[0] = parseFloat(n.value) || 0; }); r.appendChild(n);\n        }\n        const ta = edTextarea(row[1], (v) => { row[1] = v; }); ta.setAttribute('aria-label', sec.type === 'chat' ? 'Mensaje' : 'Línea'); r.appendChild(ta);\n        const tools = document.createElement('div'); tools.className = 'tools';\n        tools.append(\n          edBtn('↑', 'Subir', () => { [list[i - 1], list[i]] = [list[i], list[i - 1]]; edRender(); }, i === 0),\n          edBtn('↓', 'Bajar', () => { [list[i + 1], list[i]] = [list[i], list[i + 1]]; edRender(); }, i === list.length - 1),\n          edBtn('✕', 'Borrar', () => { list.splice(i, 1); edRender(); }));\n        r.appendChild(tools); s.appendChild(r);\n      });\n      const add = document.createElement('button'); add.type = 'button'; add.className = 'add'; add.textContent = sec.type === 'chat' ? '+ Agregar mensaje' : '+ Agregar línea';\n      add.addEventListener('click', () => { list.push(sec.type === 'chat' ? [Object.keys(sec.who)[0], ''] : [list.length ? Math.round((list[list.length - 1][0] + 5) * 10) / 10 : 0, '']); edRender(); });\n      s.appendChild(add);\n    } else {\n      for (const [k, label] of sec.fields) {\n        const f = document.createElement('div'); f.className = 'field';\n        const id = 'ed-' + sec.key + '-' + k; const lb = document.createElement('label'); lb.htmlFor = id; lb.textContent = label;\n        const ta = edTextarea(ED.draft[sec.key][k], (v) => { ED.draft[sec.key][k] = v; }); ta.id = id;\n        f.append(lb, ta); s.appendChild(f);\n      }\n    }\n    body.appendChild(s);\n  }\n  body.scrollTop = keep;\n}\nfunction edClean(d) {\n  const o = clone(d);\n  for (const sec of TX_SCHEMA) {\n    if (sec.type === 'chat') o[sec.key] = o[sec.key].filter((r) => String(r[1]).trim()).map((r) => [r[0], String(r[1]).trim()]);\n    if (sec.type === 'timed') o[sec.key] = o[sec.key].filter((r) => String(r[1]).trim()).map((r) => [Number(r[0]) || 0, String(r[1]).trim()]).sort((a, b) => a[0] - b[0]);\n  }\n  return o;\n}\nfunction openEditor() { ED.draft = clone(TXT); edRender(); edStatus(''); $('#editor').hidden = false; $('#ed-body').scrollTop = 0; $('#ed-close').focus(); }\nfunction closeEditor() { $('#editor').hidden = true; $('#edit-btn').focus(); }\nasync function saveTexts() {\n  if (ED.saving || !ED.art) return;\n  ED.saving = true; $('#ed-save').disabled = true; edStatus('Guardando…');\n  const data = edClean(ED.draft);\n  const json = JSON.stringify(data, null, 1).replace(/</g, '\\\\u003c');\n  let doc = null;\n  try { const r = await fetch('index.html', { cache:'no-store' }); if (r.ok) { const t = await r.text(); if (/^<!doctype html>/i.test(t) && t.indexOf('data-tx=\"1\"') > 0) doc = t; } } catch (e) {}\n  if (!doc) doc = SKEL_HEAD + '\\n' + PRISTINE + '\\n</body></html>';\n  const re = /(<script type=\"application\\/json\" id=\"textos\" data-tx=\"1\"[^>]*>)[\\s\\S]*?(<\\/script>)/;\n  if (!re.test(doc)) { edStatus('No pude preparar la versión nueva. Avísale a Claude.', 'err'); ED.saving = false; $('#ed-save').disabled = false; return; }\n  doc = doc.replace(re, (m, a, b) => a + json + b);\n  try {\n    await ED.art.publish(doc);\n    edStatus('Guardado. El juego se está recargando con los textos nuevos.', 'ok');\n  } catch (e) {\n    const code = e && e.code;\n    edStatus(code === 'conflict' ? 'Alguien guardó otra versión recién. El juego se va a recargar; vuelve a hacer tus cambios.'\n      : (code === 'not_writer' || code === 'not_granted') ? 'No tienes permiso para guardar este juego. Puedes usar \"Probar sin guardar\".'\n      : 'No se pudo guardar (' + (code || 'error') + '). Tus cambios siguen aquí: intenta de nuevo.', 'err');\n    ED.saving = false; $('#ed-save').disabled = false;\n  }\n}\n$('#edit-btn').addEven