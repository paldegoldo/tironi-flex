eInicio\": {\n  \"tironi1\": \"Ya po, Xakira, conéctate. Falta uno pa la partida.\",\n  \"xakira\": \"No puedo… estoy trabado con el tema. No me sale nada.\",\n  \"tironi2\": \"A ver, dale play. Yo le pongo la voz.\"\n },\n \"letra\": [],\n \"cineFinal\": {\n  \"xakira1\": \"¡ESO! Eso era lo que le faltaba al tema.\",\n  \"contacto\": \"Papao 🎛️\",\n  \"archivo\": \"Mirador (base nueva).mp3 · 2:41\",\n  \"mensaje\": \"ahí está el tema, te toca tu parte\",\n  \"xakira2\": \"Listo, se lo mandé al Papao. Ahora hay que esperar que haga su parte…\",\n  \"tironi\": \"Y mientras… ¿una partidita?\",\n  \"xakira3\": \"Ya po. Me conecto.\"\n },\n \"chatWin\": [\n  [\n   \"them\",\n   \"quedó la raja el tema\"\n  ],\n  [\n   \"them\",\n   \"ya me conecto, abran la sala\"\n  ],\n  [\n   \"sys\",\n   \"Xakira se unió al grupo «Partida LoL»\"\n  ]\n ],\n \"derrota\": {\n  \"papao\": \"¡JAJAJA! ¿Quién está maullando? Tironi, cállate, hermano, me tení los oídos sangrando.\",\n  \"papa\": \"¿¡Qué es este olor!? ¡Simón! ¡Se acabó la junta, todos pa fuera!\",\n  \"tituloPapao\": \"Entró el Papao\",\n  \"textoPapao\": \"Desafinaste tanto que Xakira se desanimó y el Papao entró a molestar. Acierta más notas para mantener el ánimo arriba.\",\n  \"tituloPapa\": \"Entró el papá\",\n  \"textoPapa\": \"Fumaste demasiado seguido y el olor llegó al living. Deja que baje la volá antes de volver al bong.\"\n }\n}</script>\n<section id=\"editor\" class=\"layer overlay\" hidden data-own>\n  <div class=\"ed\" role=\"dialog\" aria-labelledby=\"ed-title\">\n    <header>\n      <h2 id=\"ed-title\">Editar textos</h2>\n      <p>Cambia los chats, diálogos y textos de este nivel. \"Probar sin guardar\" los usa solo en esta pestaña. \"Guardar\" publica una versión nueva del juego para todos los que tengan el enlace.</p>\n    </header>\n    <div class=\"ed-body\" id=\"ed-body\"></div>\n    <footer>\n      <button class=\"btn small\" id=\"ed-save\">Guardar</button>\n      <button class=\"btn ghost\" id=\"ed-