 * push; b.z += nz * push; } }\n  }\n}\n// conducción: Tironi le pega un toquecito y la pelota rueda adelante; si gira, la pelota sigue un poco por su lado\nfunction dribble(dt) {\n  // conducción tipo juego de fútbol: la pelota va pegada adelante del pie y con cada zancada Tironi le da un toquecito\n  // (sale un poco adelante y él la vuelve a alcanzar). En las curvas la pelota sigue su dirección con un leve retraso.\n  const sp = TP.spd, moving = sp > 0.5;\n  if (B.hd == null) B.hd = Math.atan2(B.x - TP.x, B.z - TP.z);\n  let dd = TP.face - B.hd; while (dd > Math.PI) dd -= 2 * Math.PI; while (dd < -Math.PI) dd += 2 * Math.PI;\n  B.hd += dd * (1 - Math.exp(-11 * dt));\n  const u = ((TP.ph / (Math.PI * 2)) % 1 + 1) % 1;\n  if (moving && TP.lastU != null && u < TP.lastU - 0.5) { TP.touchT = 0.16; sfx.touch(sp / 9); }\n  TP.lastU = u;\n  TP.dribA = lerp(TP.dribA || 0, moving ? 0.2 + sp * 0.055 * (TP.sprint ? 1.45 : 1) : 0, 1 - Math.exp(-6 * dt));\n  const rel = u < 0.22 ? Math.sin(u / 0.22 * Math.PI / 2) : Math.cos((u - 0.22) / 0.78 * Math.PI / 2);\n  const d = 0.42 + TP.dribA * rel, tx = TP.x + Math.sin(B.hd) * d, tz = TP.z + Math.cos(B.hd) * d;\n  const k = 1 - Math.exp(-26 * dt), ox = B.x, oz = B.z;\n  B.x += (tx - B.x) * k; B.z += (tz - B.z) * k; B.y = 0.11; B.vy = 0;\n  B.vx = (B.x - ox) / Math.max(dt, 1e-4); B.vz = (B.z - oz) / Math.max(dt, 1e-4);\n}\nfunction updateBall(dt) {\n  B.pz = B.z; B.noPick = Math.max(0, B.noPick - dt);\n  if (B.owner === TP && G.mode === 'play') { dribble(dt); return; }\n  if (B.owner) {\n    const o = B.owner, sp = Math.hypot(o.vx, o.vz), lead = 0.5 + Math.abs(Math.sin(o.ph * 0.5)) * 0.18 * Math.min(1, sp / 4);\n    B.x = o.x + Math.sin(o.face) * lead; B.z = o.z + Math.cos(o.face) * lead; B.y = 0.11; B.vx = o.vx; B.vz = o.vz; B.vy = 0;\n  } else {\n    if (B.y > 0.11 || B.vy > 0) B.vy -= 9.8 * dt;\n    B.x += B.vx * dt; B.y += B.vy * dt; B.z += B.vz * dt;\n    if (B.y <= 0.11) { B.y = 0.11; B.vy = B.vy < -1.5 ? -B.vy * 0.45 : 0; }\n 