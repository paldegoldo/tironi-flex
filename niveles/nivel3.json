; return; }\n  const shooterU = PEN.k % 2 === 0; PEN.t = 0; PEN.cel = false; reticle.visible = false; penHelp(null);\n  Object.assign(B, { x:0, y:0.11, z:SPOT_Z, vx:0, vy:0, vz:0, owner:null, kicker:null, shot:false, inNet:false });\n  if (shooterU) {\n    PEN.phase = 'u-walk'; TP.keeping = false; TP.dive = 0; TP.x = 2.2; TP.z = SPOT_Z + 3.2; TP.face = Math.PI;\n    gk.x = 0; gk.z = GZ + 0.3; gk.face = 0; gk.dive = 0;\n    if (PEN.shooter) { PEN.shooter.x = PEN.shooter.hx; PEN.shooter.z = -2; PEN.shooter.face = Math.PI; }\n    if (Math.random() < 0.55 && TXT.quejas.length) { PEN.quejaIdx = (PEN.quejaIdx + 1 + Math.floor(Math.random() * Math.max(1, TXT.quejas.length - 1))) % TXT.quejas.length; setTimeout(() => { if (G.mode === 'pens') thought(TXT.quejas[PEN.quejaIdx][1], 2600); }, 400); }\n  } else {\n    PEN.phase = 'c-walk'; TP.keeping = true; TP.dive = 0; TP.x = 0; TP.z = GZ + 0.35; TP.face = 0;\n    gk.x = 9; gk.z = -2; gk.face = Math.PI; gk.dive = 0;\n    PEN.isZ = !PEN.zampUsado && penWouldDecide('C'); if (PEN.isZ) { PEN.zampUsado = true; if (EMB && EMB.evt) EMB.evt('zamp'); }\n    if (!PEN.isZ) { ZP.b.root.visible = ZP.sh.visible = false; }\n    const sh = PEN.isZ ? ZP : defs[Math.floor(PEN.k / 2) % defs.length]; sh.hx = sh.hx == null ? sh.x : sh.hx; PEN.shooter = sh;\n    if (PEN.isZ) { ZP.b.root.visible = ZP.sh.visible = true; }\n    PEN.side = Math.random() < 0.4 ? -1 : Math.random() < 0.67 ? 1 : 0; PEN.honest = Math.random() < (PEN.isZ ? 0.5 : 0.62); PEN.tellDir = PEN.honest ? PEN.side : (PEN.side ? -PEN.side : (Math.random() < 0.5 ? 1 : -1));\n    sh.x = 1.7; sh.z = SPOT_Z + 1.9; sh.face = Math.PI - 0.6; PEN.dive = null; PEN.diveAt = -1;\n    if (PEN.isZ && !PEN.zampDicho) {\n      PEN.zampDicho = true; PEN.phase = 'zamp'; PEN.t = 0; PEN.zr = 0;\n      sh.x = 0.05; sh.z = SPOT_Z + 0.45; sh.face = Math.PI; crowd(0.25, 0.6);\n    } else if (!PEN.arqueroDicho) { PEN.arqueroDicho = true; setTimeout(() => { if (G.mode === 'pens') thought(TXT.penales.arquero, 2800); }, 300); }\n  }\n}\nfunction penLock() {\n  if (PEN.phase !== 'u-aim') return;\n  PEN.phase = 'u-power'; PEN.lx = PEN.ax; PEN.ly = PEN.ay; G.charge = 0; HU.power.hidden = false; reticle.userData.mat.color.setHex(0xff5fa8);\n  penHelp('Suelta <kbd>K</kbd> con la barra en el verde');\n}\nfunction penShoot() {\n  if (PEN.phase !== 'u-power') return;\n  PEN.pw = clamp(G.charge, 0.05, 1); G.charge = -1; HU.power.hidden = true; PEN.phase = 'u-run'; PEN.t = 0; penHelp(null);\n}\nfunction penKickU() {\n  const p = PEN.pw, wob = G.pasaoT > 0 ? 0.55 : 0.12;\n  PEN.tx = PEN.lx + gauss() * wob; PEN.ty = PEN.ly + gauss() * wob * 0.6 + (p > 0.86 ? 0.9 + (p - 0.86) * 9 : 0);\n  PEN.flT = lerp(0.85, 0.42, p); PEN.fl = 0; PEN.phase = 'u-fly'; TP.kickT = 0.35; sfx.kick(0.4 + p * 0.6);\n  // el arquero se tira: izquierda, al medio o derecha\n  const r = Math.random(); PEN.gkSide = r < 0.4 ? -1 : r < 0.8 ? 1 : 0;\n}\nfunction penDive(dir) {\n  if (PEN.phase !== 'c-walk' && PEN.phase !== 'c-run' && !(PEN.phase === 'c-fly' && PEN.fl < 0.16)) return;\n  if (PEN.dive != null) return;\n  PEN.dive = dir; PEN.diveAt = PEN.phase === 'c-fly' ? 0 : -1;\n}\nfunction penResolve() {\n  // decide qué pasa cuando la pelota llega a la línea\n  const U = PEN.phase === 'u-fly';\n  const x = U ? PEN.tx : PEN.tx, y = U ? PEN.ty : PEN.ty, ax = Math.abs(x);\n  let res;\n  if (ax > GW / 2 + 0.12 || y > GH + 0.12) res = (Math.abs(ax - GW / 2) < 0.25 && y < GH) || (Math.abs(y - GH) < 0.22 && ax < GW / 2) ? 'palo' : 'afuera';\n  else if (ax > GW / 2 - 0.12 && y < GH) res = 'palo';\n  else {\n    const kSide = U ? PEN.gkSide : (PEN.dive == null ? 0 : PEN.dive), kx = kSide * 2.3, reach = kSide === 0 ? 0.8 : 1.5;\n    let pSave = 0;\n    if (Math.abs(x - kx) < reach && y < (kSide === 0 ? 2.0 : 1.95)) {\n      pSave = kSide === 0 ? (U || !PEN.isZ ? 0.88 : 0.7) : (U ? 0.78 : PEN.isZ ? 0.55 : 0.68);\n      if (U) { const pw = PEN.pw; pSave *= pw < 0.35 ? 1.15 : pw > 0.6 ? 0.7 : 1; }\n      if (ax > 2.7 && y > 1.6) pSave *= 0.45;   // al ángulo\n    }\n    res = Math.random() < pSave ? 'atajada' : 'gol';\n  }\n  PEN.res = res; return res;\n}\nfunction penAfter(res) {\n  const U = PEN.phase === 'u-fly', scored = res === 'gol';\n  (U ? PEN.u : PEN.c).push(scored); if (EMB && EMB.evt) EMB.evt('penal', { u:U, res, z:!U && !!PEN.isZ }); penHUD(); PEN.phase = 'result'; PEN.t = 0; reticle.visible = false; penHelp(null);\n  if (scored) {\n    B.inNet = true; B.vz = -6; B.vy = 1; NETS[0].bulge = 1;\n    if (U) { showCenter('¡GOOOL!', 1700, 'blue'); golPlay(); G.flash = 0.25; PEN.cel = true; setTimeout(() => { if (G.mode === 'pens') thought(TXT.penales.gol, 2200); }, 500); }\n    else { showCenter(PEN.isZ ? 'Gol de Zampedri' : 'Gol de la Católica', 1500, 'red'); sfx.sad(); if (PEN.isZ) setTimeout(() => { if (G.mode === 'pens') thought(TXT.penales.gol_idolo, 2400); }, 600); }\n  } else {\n    const dir = B.x >= 0 ? 1 : -1;\n    if (res === 'atajada') { B.vx = dir * (3 + Math.random() * 3); B.vz = 6; B.vy = 3; sfx.kick(0.5); }\n    else if (res === 'palo') { B.vz = 4; B.vx = -dir * 2; B.vy = 1.5; sfx.post(); }\n    else { B.vz = -4; }\n    if (U) { showCenter(res === 'atajada' ? '¡Atajó!' : res === 'palo' ? '¡PALO!' : '¡Afuera!', 1500, 'red'); sfx.uuh(); setTimeout(() => { if (G.mode === 'pens') thought(TXT.penales.fallo, 2200); }, 500); }\n    else { showCenter(res === 'atajada' ? '¡LA TAPÓ TIRONI!' : res === 'palo' ? '¡PALO!' : '¡Afuera!', 1700, res === 'atajada' ? 'blue' : 'green'); crowd(0.9, 0.1); G.flash = 0.2; PEN.cel = res === 'atajada'; if (res === 'atajada') setTimeout(() => { if (G.mode === 'pens') thought(PEN.isZ ? TXT.penales.ataje_idolo : TXT.penales.ataje, 2400); }, 500); }\n  }\n}\nfunction penEnd(w) {\n  PEN.done = true; reticle.visible = false; penHelp(null); HU.power.hidden = true;\n  G.penU = penGoals(PEN.u); G.penC = penGoals(PEN.c);\n  if (w === 'U') { showCenter(TXT.penales.ganar, 2600, 'blue'); golPlay(); startConfetti(0, SPOT_Z); PEN.phase = 'fin'; PEN.t = 0; G.won = true; }\n  else { PEN.phase = 'fin'; PEN.t = 0; sfx.whistle(3, true); }\n  PEN.winner = w;\n}\nfunction penStep(dt) {\n  PEN.t += dt; G.phaseT += dt;\n  G.slowT = Math.max(0, G.slowT - dt); G.vola = Math.max(0, G.vola - 2.6 * dt);\n  if (G.pasaoT > 0) { G.pasaoT -= dt; if (G.pasaoT <= 0) HU.hud.classList.remove('pasao'); }\n  if (G.charge >= 0) G.charge = Math.min(1, G.charge + dt / 0.9);\n  const P = PEN.phase;\n  if (P === 'intro') { if (PEN.t > 3.4) penNext(); }\n  else if (P === 'u-walk') { steer(TP, 1.7, SPOT_Z + 1.5, 2.5, dt); if (PEN.t > 1.2) { TP.vx = TP.vz = 0; TP.face = Math.PI - 0.6; PEN.phase = 'u-aim'; PEN.aimT = Math.random() * 6; sfx.whistle(1); reticle.visible = true; reticle.userData.mat.color.setHex(0xffd23a); penHelp('Apunta: <kbd>K</kbd> fija la mira (mantenla apretada para cargar) · <kbd>Espacio</kbd> pito'); } }\n  else if (P === 'u-aim' || P === 'u-power') {\n    if (P === 'u-aim') {\n      const sp = (G.slowT > 0 ? 0.45 : 1) * (G.pasaoT > 0 ? 1.7 : 1); PEN.aimT += dt * sp;\n      const a = PEN.aimT;\n      PEN.ax = (GW / 2 + 0.35) * Math.sin(a * 1.3) + (G.pasaoT > 0 ? Math.sin(a * 9) * 0.35 : 0);\n      PEN.ay = 1.22 + (GH / 2 + 0.2) * Math.sin(a * 2.1 + 0.7) + (G.pasaoT > 0 ? Math.cos(a * 7) * 0.25 : 0);\n    }\n    reticle.position.set(P === 'u-aim' ? PEN.ax : PEN.lx, P === 'u-aim' ? PEN.ay : PEN.ly, GZ + 0.05);\n    TP.vx = TP.vz = 0;\n  }\n  else if (P === 'u-run') { steer(TP, 0.25, SPOT_Z + 0.55, 5.5, dt, 12); if (PEN.t > 0.45) penKickU(); }\n  else if (P === 'zamp') {\n    ZP.vx = ZP.vz = 0; ZP.face = Math.PI; TP.vx = TP.vz = 0;\n    if (PEN.t > 3.35 && !PEN.zr) { PEN.zr = 1; banner('ZAMPEDRI', TXT.penales.zampedri, 3600); crowd(1.0, 0.15); G.flash = 0.25; sfx.whistle(1); }\n    if (PEN.t > 4.8 && PEN.zr === 1) { PEN.zr = 2; say('Tironi', TXT.penales.idolo); }\n    if (PEN.t > 8.6) { clearSay(); ZP.x = 1.7; ZP.z = SPOT_Z + 1.9; ZP.face = Math.PI - 0.6; PEN.phase = 'c-walk'; PEN.t = 0; crowd(0.5, 0.6); }\n  }\n  else if (P === 'c-walk') {\n    const sh = PEN.shooter; sh.vx = sh.vz = 0; sh.face = Math.PI - 0.6;\n    TP.vx = TP.vz = 0; TP.x = Math.sin(G.t * 3) * 0.15;   // el arquero baila en la línea\n    if (PEN.t > 1.0) { PEN.phase = 'c-run'; PEN.t = 0; sfx.whistle(1); penHelp('Tírate antes de que patee: <kbd>A</kbd> izquierda · <kbd>W</kbd> al medio · <kbd>D</kbd> derecha'); }\n  }\n  else if (P === 'c-run') {\n    const sh = PEN.shooter; steer(sh, 0, SPOT_Z + 0.55, 4.2, dt, 10);\n    // en el último tramo se le nota (a veces engaña) pa qué lado va\n    const tell = PEN.tellDir * 0.6 * smooth((PEN.t - 0.7) / 0.35);\n    sh.face = Math.PI - tell;\n    TP.vx = TP.vz = 0;\n    if (PEN.t > 1.25) {\n      sh.kickT = 0.35; sfx.kick(0.85); PEN.phase = 'c-fly'; PEN.fl = 0; PEN.flT = 0.55;\n      const miss = Math.random() < (PEN.isZ ? 0.03 : 0.08);\n      PEN.tx = PEN.side * (2.35 + Math.random() * 0.9) + (PEN.side === 0 ? (Math.random() - 0.5) * 0.8 : 0) + (miss ? PEN.side * 1.2 + (PEN.side === 0 ? 4.5 : 0) : 0);\n      PEN.ty = 0.3 + Math.random() * 1.6 + (miss && Math.random() < 0.5 ? 1.6 : 0);\n    }\n  }\n  else if (P === 'u-fly' || P === 'c-fly') {\n    PEN.fl += dt / PEN.flT; const u = Math.min(1, PEN.fl);\n    B.x = lerp(0, PEN.tx, u); B.z = lerp(SPOT_Z, GZ, u); B.y = 0.11 + (PEN.ty - 0.11) * u + Math.sin(u * Math.PI) * 0.35;\n    B.vx = PEN.tx / PEN.flT; B.vz = (GZ - SPOT_Z) / PEN.flT;\n    // los arqueros se tiran\n    if (P === 'u-fly') { if (PEN.fl > 0.08) { gk.diveDir = PEN.gkSide || (Math.random() < 0.5 ? 1 : -1); gk.dive = PEN.gkSide ? Math.min(1, gk.dive + dt * 5) : 0; gk.x = lerp(gk.x, PEN.gkSide * 2.1, 1 - Math.exp(-7 * dt)); if (!PEN.gkSide) gk.y = Math.sin(Math.min(1, PEN.fl) * Math.PI) * 0.2; } }\n    else if (PEN.dive != null) { TP.diveDir = PEN.dive; TP.dive = PEN.dive ? Math.min(1, TP.dive + dt * 5) : 0; TP.x = lerp(TP.x, PEN.dive * 2.1, 1 - Math.exp(-7 * dt)); }\n    if (u >= 1) { penAfter(penResolve()); }\n  }\n  else if (P === 'result') {\n    updateBall(dt);\n    if (PEN.cel) { if (PEN.k % 2 === 0) { TP.cel = 1; TP.vx = TP.vz = 0; } }\n    if (PEN.t > 2.4) { gk.dive = 0; TP.dive = 0; gk.y = 0; PEN.k++; penNext(); }\n  }\n  else if (P === 'fin') {\n    updateBall(dt);\n    if (PEN.winner === 'U') { TP.cel = 1; TP.vx = TP.vz = 0; if (PEN.t > 3.2) { HU.hud.classList.remove('pens'); $('#pens').hidden = true; startOutro(); } }\n    else { defs.forEach((d) => { d.cel = 1; }); if (PEN.t > 2.6) { HU.hud.classList.remove('pens'); $('#pens').hidden = true; startLose(); } }\n  }\n}\n// chat al ganar: el mensaje de Kapu (el que antes salía en el celular de la cinemática) va antes de su último mensaje\nfunction winLines() {\n  const L = clone(TXT.chatWin), m = String((TXT.cineFinal && TXT.cineFinal.mensaje) || '').trim(); if (!m) return L;\n  let k = L.length; for (let i = L.length - 1; i >= 0; i--) if (L[i][0] === 'them') { k = i; break; }\n  L.splice(k, 0, ['them', m]); return L;\n}\nfunction finalLine() {\n  return G.pens ? 'Final: UCH ' + G.gU + ' – ' + G.gC + ' UC · Penales ' + (G.penU || 0) + '–' + (G.penC || 0) : 'Final: UCH ' + G.gU + ' – ' + G.gC + ' UC';\n}\n\n/* =========================================================\n   BUCLE\n   ========================================================= */\nlet last = performance.now();\nfunction resize() {\n  const w = Math.max(1, innerWidth), h = Math.max(1, innerHeight);\n  PR = Math.min(window.devicePixelRatio || 1, 2); renderer.setPixelRatio(PR); renderer.setSize(w, h, false);\n  const rh = Math.min(PS1_H, Math.round(h * PR)), rw = Math.max(1, Math.round(rh * w / h)); rt.setSize(rw, rh); postMat.uniforms.uRes.value.set(rw, rh);\n  camera.aspect = w / h; camera.updateProjectionMatrix();\n}\naddEventListener('resize', resize); resize();\nfunction frame(now) {\n  requestAnimationFrame(frame);\n  const dt = Math.min(0.05, (now - last) / 1000); last = now;\n  if (G.mode !== 'pause') step(dt);\n  postMat.uniforms.uTime.value = G.t;\n  renderer.setRenderTarget(rt); renderer.render(scene, camera);\n  renderer.setRenderTarget(null); renderer.render(postScene, postCam);\n}\nfunction step(dt) {\n  if (G.bulletT > 0) { G.bulletT -= dt; dt *= 0.32; }   // el tiro va al arco: cámara lenta cortita\n  G.shotCam = Math.max(0, G.shotCam - dt); G.shake = Math.max(0, G.shake - dt * 1.4);\n  G.t += dt;\n  if (G.mode === 'pre') {\n    G.phaseT += dt; for (const p of PL_ALL) { p.vx *= 0.8; p.vz *= 0.8; }\n    if (G.phaseT > 1.6) { G.mode = 'play'; sfx.whistle(1); }\n  } else if (G.mode === 'play') { updatePlay(dt); if (G.mode === 'play' || G.mode === 'goal') recFrame(); }\n  else if (G.mode === 'post') {\n    G.phaseT += dt; const wd = dt * 0.7;\n    const o = B.owner; if (o && o.team === 'UC') { steer(o, o.x * 0.9, o.z + 8, 5, wd); }\n    for (const p of PL_ALL) if (p !== o) { p.vx *= 0.94; p.vz *= 0.94; p.x += p.vx * wd; p.z += p.vz * wd; }\n    updateBall(wd); if (G.phaseT > 2.4) nextJugada();\n  } else if (G.mode === 'goal') {\n    G.phaseT += dt; TP.cel = 1; TP.vx *= 0.9; TP.vz *= 0.9; if (G.t < (G.recEnd || 0)) recFrame();\n    mates.forEach((m) => { m.cel = 1; steer(m, TP.x + (m.x > TP.x ? 1 : -1), TP.z + 1, 6.5, dt); });\n    defs.forEach((d) => { d.vx *= 0.9; d.vz *= 0.9; });\n    updateBall(dt); NETS[0].bulge = Math.max(NETS[0].bulge, 0.6);\n    if ((tearT -= dt) <= 0 && G.phaseT > 0.5) { tearT = 0.15; const tr = tears[tearIdx++ % tears.length]; const sx = tearIdx % 2 ? 0.045 : -0.045; tr.s.position.copy(TP.b.headG.localToWorld(new THREE.Vector3(sx, 0.0, 0.1))); tr.vx = (Math.random() - 0.5) * 0.3; tr.vy = 0.4; tr.vz = 0.3; tr.t = 0.8; tr.s.visible = true; }\n    if (G.phaseT > 3.6) { PL_ALL.forEach((p) => { p.cel = 0; }); startReplay(); }\n  }\n  else if (G.mode === 'pens') penStep(dt);\n  else if (G.mode === 'replay') replayStep(dt);\n  else if (G.mode === 'penintro') penIntroStep(dt);\n  else if (G.mode === 'intro') introStep(dt);\n  else if (G.mode === 'outro') outroStep(dt);\n  else if (G.mode === 'losecine') loseStep(dt);\n  if (G.mode !== 'outro' && G.mode !== 'goal' && G.mode !== 'replay' && !(G.mode === 'pens' && (PEN.cel || PEN.phase === 'fin'))) TP.cel = 0;\n  if (G.mode !== 'losecine' && G.mode !== 'replay' && !(G.mode === 'pens' && PEN.phase === 'fin')) defs.forEach((d) => { if (G.mode !== 'lost') d.cel = 0; });\n  for (const p of PL_ALL) animP(p, G.mode === 'replay' ? 0 : dt);\n  hairStep(G.mode === 'replay' ? dt * 0.42 : dt);\n  if (ZP.b.root.visible) animP(ZP, dt);\n  if (G.mode === 'pens' && PEN.phase === 'zamp') {\n    const up = smooth((PEN.t - 2.3) / 1.0), c = 1 - up, r = ZP.b.root, th = 1.25 * c, Hh = 1.0;\n    const fx = Math.sin(ZP.face), fz = Math.cos(ZP.face), back = Hh * Math.sin(th);\n    r.rotation.x = th; r.position.set(ZP.x - fx * back, Hh * (1 - Math.cos(th)) - 0.05 * c, ZP.z - fz * back);\n    ZP.b.legG.forEach((g, i) => { g.rotation.set(-th + 0.1 * c, 0, (i ? 1 : -1) * 0.07 * c); const kn = g.userData.knee; if (kn) kn.rotation.x = 0.22 * c; });\n    ZP.b.armG.forEach((g, i) => { g.rotation.set(-th - 0.35 * c, 0, (i ? 1 : -1) * 0.1 * c); const f = g.userData.fore; if (f) { f.quaternion.identity(); f.rotation.set(-0.25 * c, 0, 0); } });\n    ZP.b.headG.rotation.set(0.45 * c - 0.08 * up, 0, 0);\n    // la pelota: en sus manos hasta que la deja en el punto penal\n    r.updateMatrixWorld(true);\n    const hands = ZP.b.armG.map((g) => { const f = g.userData.fore; return f ? f.localToWorld(g.userData.hand.clone().sub(f.position)) : g.localToWorld(g.userData.hand.clone()); });\n    const hx = (hands[0].x + hands[1].x) / 2, hy = (hands[0].y + hands[1].y) / 2 - 0.1, hz = (hands[0].z + hands[1].z) / 2 + fz * 0.04;\n    const put = smooth((PEN.t - 1.5) / 0.45);\n    B.owner = null; B.vx = B.vy = B.vz = 0; B.x = lerp(hx, 0, put); B.y = lerp(hy, 0.11, put); B.z = lerp(hz, SPOT_Z, put);\n  } else if (ZP.b.root.visible) ZP.b.headG.rotation.set(0, 0, 0);\n  animBall(dt);\n  // humo, lágrimas, papelitos\n  for (const p of puffs) {\n    if (p.life <= 0) continue; p.life -= dt; if (p.life <= 0) { p.sp.visible = false; continue; }\n    const k = 1 - p.life / p.max; p.sp.position.x += p.vx * dt; p.sp.position.y += p.vy * dt; p.sp.position.z += p.vz * dt;\n    p.sp.scale.setScalar(p.grow * (0.4 + k * 1.4)); p.sp.material.opacity = 0.7 * (1 - k);\n  }\n  if (G.slowT > 0 && G.mode === 'play' && Math.random() < dt * 3) { TP.b.headG.getWorldPosition(_w); puff(_w.x, _w.y + 0.1, _w.z, 0xdfe8d8, 0.3, 1.6, 0.35); }\n  for (const tr of tears) { if (!tr.s.visible) continue; tr.t -= dt; tr.vy -= 2.5 * dt; tr.s.position.x += tr.vx * dt; tr.s.position.y += tr.vy * dt; tr.s.position.z += tr.vz * dt; if (tr.t <= 0) tr.s.visible = false; }\n  if (confetti.visible) { for (let i = 0; i < CONF_N; i++) { confPos[i * 3 + 1] -= confV[i] * dt; confPos[i * 3] += Math.sin(G.t * 3 + i) * dt * 0.6; if (confPos[i * 3 + 1] < 0) confPos[i * 3 + 1] = 0.02; } confGeo.attributes.position.needsUpdate = true; }\n  // red del arco, banderas y galería saltando\n  for (const n of NETS) { n.bulge = Math.max(0, n.bulge - dt * 0.8); n.back.position.z = n.z0 + n.dir * n.bulge * 0.6; }\n  for (const fl of FLAGS) { const a = fl.f.geometry.attributes.position; for (let i = 0; i < a.count; i++) { const x0 = fl.base[i * 3]; a.setZ(i, Math.sin(G.t * 4 + x0 * 1.8 + fl.ph) * 0.25 * (x0 + 1.5) / 3); } a.needsUpdate = true; }\n  const party = G.mode === 'goal' || G.mode === 'replay' || (G.mode === 'outro' && G.cineT > 4.6) ? 1 : 0;\n  // la barra salta cuando Tironi ataca cerca del área\n  const attack = !party && (G.mode === 'play' || G.mode === 'pens') && B.z < GZ + 30 ? 1 : 0;\n  G.hype = lerp(G.hype || 0, party ? 1 : attack ? 0.6 : 0, 1 - Math.exp(-2 * dt));\n  T.crowdU.offset.y = Math.abs(Math.sin(G.t * lerp(4.2, 9, G.hype))) * lerp(0.02, 0.05, G.hype);\n  T.crowdMix.offset.y = G.hype > 0.5 ? Math.abs(Math.sin(G.t * 8 + 1)) * 0.03 * G.hype : 0;\n  updateFans(lerp(0.06, 0.32, G.hype), lerp(4.2, 9, G.hype));\n  const flareN = ['title', 'chat', 'end', 'lost'].includes(G.mode) ? 6 : party ? 12 : G.mode === 'losecine' ? 0 : 7 + Math.round(G.hype * 2);\n  flaresStep(dt, flareN); papelStep(dt);\n  if (AU.ctx && G.mode !== 'title' && G.mode !== 'chat' && G.mode !== 'end' && G.mode !== 'lost' && !(G.mode === 'outro' && G.cineT > 9)) schedBombo();\n  // globo de pensamiento sobre Tironi\n  if (!HU.bubble.hidden) {\n    TP.b.headG.getWorldPosition(_w); _w.y += 0.42; _w.project(camera);\n    if (_w.z < 1) { HU.bubble.style.left = ((_w.x * 0.5 + 0.5) * innerWidth).toFixed(0) + 'px'; HU.bubble.style.top = ((-_w.y * 0.5 + 0.5) * innerHeight).toFixed(0) + 'px'; }\n  }\n  updateCamera(dt);\n  if (PLAYING.includes(G.mode)) updateHUD();\n  G.flash = Math.max(0, G.flash - dt * 1.2); G.red = Math.max(0, G.red - dt * 1.5);\n  postMat.uniforms.uFlash.value = G.flash; postMat.uniforms.uRed.value = G.red;\n  postMat.uniforms.uSlow.value = lerp(postMat.uniforms.uSlow.value, (G.slowT > 0 && (G.mode === 'play' || G.mode === 'pens')) || G.bulletT > 0 || G.mode === 'replay' ? 1 : 0, 1 - Math.exp(-5 * dt));\n  postMat.uniforms.uVola.value = lerp(postMat.uniforms.uVola.value, Math.min(1, G.vola / 100), 1 - Math.exp(-3 * dt));\n  postMat.uniforms.uPasado.value = lerp(postMat.uniforms.uPasado.value, G.pasaoT > 0 ? 1 : 0, 1 - Math.exp(-3 * dt));\n}\nfunction updateHUD() {\n  HU.sc.textContent = G.gU + ' – ' + G.gC; HU.min.textContent = G.mode === 'pens' || G.pens ? 'PEN' : MINS[Math.min(G.jug, MINS.length - 1)]; HU.jug.textContent = 'Jugada ' + Math.min(G.jug + 1, MINS.length) + '/' + MINS.length;\n  const left = clamp(1 - G.playT / JUG_T, 0, 1); HU.jt.style.width = (G.mode === 'pre' ? 100 : left * 100) + '%'; HU.jtw.classList.toggle('warn', left < 0.25);\n  HU.culpa.style.width = G.culpa + '%'; HU.culpabar.classList.toggle('warn', G.culpa > 80);\n  HU.culpaL.textContent = G.crisisT > 0 ? '¡crisis!' : G.culpa < 30 ? 'tranqui' : G.culpa < 60 ? 'incómodo' : G.culpa < 85 ? 'arrepentido' : 'a punto de llorar';\n  HU.vola.style.width = Math.min(100, G.vola) + '%'; HU.volabar.classList.toggle('warn', G.vola > 65);\n  HU.volaL.textContent = G.pasaoT > 0 ? 'pasao' : G.slowT > 0 ? 'en cámara lenta' : G.vola < 10 ? 'sobrio' : G.vola < 65 ? 'volao' : '¡ojo!';\n  HU.pitos.forEach((p, i) => p.classList.toggle('on', i < G.pitos));\n  HU.air.style.width = G.air + '%'; HU.airbar.classList.toggle('warn', G.airLock);\n  if (G.charge >= 0) { HU.pw.style.width = (G.charge * 100) + '%'; HU.pw.classList.toggle('over', G.charge > 0.83); }\n}\n\n/* =========================================================\n   EDITOR DE TEXTOS (solo para quien puede editar el juego)\n   ========================================================= */\nconst ED = { art:null, draft:null, saving:false };\nconst clone = (o) => JSON.parse(JSON.stringify(o));\nconst SKEL_HEAD = '<!doctype html><html><head><meta charset=utf8><meta name=viewport content=\"width=device-width,initial-scale=1,viewport-fit=cover\"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>';\nfunction edStatus(text, cls) { const s = $('#ed-status'); s.textContent = text; s.className = 'ed-status ' + (cls || ''); }\nfunction edTextarea(value, onInput) {\n  const ta = document.createElement('textarea'); ta.value = value; ta.rows = Math.min(4, Math.max(1, Math.ceil(String(value).length / 64)));\n  ta.addEventListener('input', () => onInput(ta.value)); return ta;\n}\nfunction edBtn(label, title, fn, disabled) { const b = document.createElement('button'); b.type = 'button'; b.className = 'ib'; b.textContent = label; b.title = title; b.setAttribute('aria-label', title); b.disabled = !!disabled; b.addEventListener('click', fn); return b; }\nfunction edRender() {\n  const body = $('#ed-body'), keep = body.scrollTop; body.innerHTML = '';\n  for (const sec of TX_SCHEMA) {\n    const s = document.createElement('section'); s.className = 'ed-sec';\n    const h = document.createElement('h3'); h.textContent = sec.label; s.appendChild(h);\n    if (sec.hint) { const p = document.createElement('p'); p.className = 'hint'; p.textContent = sec.hint; s.appendChild(p); }\n    if (sec.type === 'chat' || sec.type === 'timed') {\n      const list = ED.draft[sec.key];\n      list.forEach((row, i) => {\n        const r = document.createElement('div'); r.className = 'ed-row' + (sec.type === 'timed' ? ' timed' : '');\n        if (sec.type === 'chat') {\n          const sel = document.createElement('select'); sel.setAttribute('aria-label', 'Quién habla');\n          for (const [v, l] of Object.entries(sec.who)) { const o = document.createElement('option'); o.value = v; o.textContent = l; sel.appendChild(o); }\n          sel.value = row[0]; sel.addEventListener('change', () => { row[0] = sel.value; }); r.appendChild(sel);\n        } else {\n          const n = document.createElement('input'); n.type = 'number'; n.min = '0'; n.step = '0.1'; n.value = row[0]; n.setAttribute('aria-label', 'Segundo de la canción');\n          n.addEventListener('input', () => { row[0] = parseFloat(n.value) || 0; }); r.appendChild(n);\n        }\n        const ta = edTextarea(row[1], (v) => { row[1] = v; }); ta.setAttribute('aria-label', sec.type === 'chat' ? 'Mensaje' : 'Línea'); r.appendChild(ta);\n        const tools = document.createElement('div'); tools.className = 'tools';\n        tools.append(\n          edBtn('↑', 'Subir', () => { [list[i - 1], list[i]] = [list[i], list[i - 1]]; edRender(); }, i === 0),\n          edBtn('↓', 'Bajar', () => { [list[i + 1], list[i]] = [list[i], list[i + 1]]; edRender(); }, i === list.length - 1),\n          edBtn('✕', 'Borrar', () => { list.splice(i, 1); edRender(); }));\n        r.appendChild(tools); s.appendChild(r);\n      });\n      const add = document.createElement('button'); add.type = 'button'; add.className = 'add'; add.textContent = sec.type === 'chat' ? '+ Agregar mensaje' : '+ Agregar línea';\n      add.addEventListener('click', () => { list.push(sec.type === 'chat' ? [Object.keys(sec.who)[0], ''] : [list.length ? Math.round((list[list.length - 1][0] + 5) * 10) / 10 : 0, '']); edRender(); });\n      s.appendChild(add);\n    } else {\n      for (const [k, label] of sec.fields) {\n        const f = document.createElement('div'); f.className = 'field';\n        const id = 'ed-' + sec.key + '-' + k; const lb = document.createElement('label'); lb.htmlFor = id; lb.textContent = label;\n        const ta = edTextarea(ED.draft[sec.key][k], (v) => { ED.draft[sec.key][k] = v; }); ta.id = id;\n        f.append(lb, ta); s.appendChild(f);\n      }\n    }\n    body.appendChild(s);\n  }\n  body.scrollTop = keep;\n}\nfunction edClean(d) {\n  const o = clone(d);\n  for (const sec of TX_SCHEMA) {\n    if (sec.type === 'chat') o[sec.key] = o[sec.key].filter((r) => String(r[1]).trim()).map((r) => [r[0], String(r[1]).trim()]);\n    if (sec.type === 'timed') o[sec.key] = o[sec.key].filter((r) => String(r[1]).trim()).map((r) => [Number(r[0]) || 0, String(r[1]).trim()]).sort((a, b) => a[0] - b[0]);\n  }\n  return o;\n}\nfunction openEditor() { ED.draft = clone(TXT); edRender(); edStatus(''); $('#editor').hidden = false; $('#ed-body').scrollTop = 0; $('#ed-close').focus(); }\nfunction closeEditor() { $('#editor').hidden = true; $('#edit-btn').focus(); }\nasync function saveTexts() {\n  if (ED.saving || !ED.art) return;\n  ED.saving = true; $('#ed-save').disabled = true; edStatus('Guardando…');\n  const data = edClean(ED.draft);\n  const json = JSON.stringify(data, null, 1).replace(/</g, '\\\\u003c');\n  let doc = null;\n  try { const r = await fetch('index.html', { cache:'no-store' }); if (r.ok) { const t = await r.text(); if (/^<!doctype html>/i.test(t) && t.indexOf('data-tx=\"1\"') > 0) doc = t; } } catch (e) {}\n  if (!doc) doc = SKEL_HEAD + '\\n' + PRISTINE + '\\n</body></html>';\n  const re = /(<script type=\"application\\/json\" id=\"textos\" data-tx=\"1\"[^>]*>)[\\s\\S]*?(<\\/script>)/;\n  if (!re.test(doc)) { edStatus('No pude preparar la versión nueva. Avísale a Claude.', 'err'); ED.saving = false; $('#ed-save').disabled = false; return; }\n  doc = doc.replace(re, (m, a, b) => a + json + b);\n  try {\n    await ED.art.publish(doc);\n    edStatus('Guardado. El juego se está recargando con los textos nuevos.', 'ok');\n  } catch (e) {\n    const code = e && e.code;\n    edStatus(code === 'conflict' ? 'Alguien guardó otra versión recién. El juego se va a recargar; vuelve a hacer tus cambios.'\n      : (code === 'not_writer' || code === 'not_granted') ? 'No tienes permiso para guardar este juego. Puedes usar \"Probar sin guardar\".'\n      : 'No se pudo guardar (' + (code || 'error') + '). Tus cambios siguen aquí: intenta de nuevo.', 'err');\n    ED.saving = false; $('#ed-save').disabled = false;\n  }\n}\n$('#edit-btn').addEventListener('click', openEditor);\n$('#ed-close').addEventListener('click', closeEditor);\n$('#ed-try').addEventListener('click', () => { TXT = edClean(ED.draft); applyStaticTexts(); closeEditor(); hint('Probando textos nuevos en esta pestaña (no están guardados)', 3200); });\n$('#ed-reset').addEventListener('click', () => { ED.draft = clone(DEFAULT_TX); edRender(); edStatus('Volviste a los textos originales. Falta guardar.'); });\n$('#ed-save').addEventListener('click', saveTexts);\n(async () => {\n  try {\n    if (!window.claude || !window.claude.use) return;\n    const [art, user] = await Promise.all([window.claude.use('artifact'), window.claude.use('user')]);\n    if (!art || !user) return;\n    if (!(await user.canEdit())) return;\n    ED.art = art; $('#edit-btn').hidden = false;\n  } catch (e) {}\n})();\n\nfunction applyStaticTexts() {\n  const f = TXT.cineFinal;\n  $('#w-contact').textContent = f.contacto; $('#w-av').textContent = (f.contacto || '?').trim().charAt(0).toUpperCase();\n  $('#w-file').textContent = f.archivo; $('#w-text').textContent = f.mensaje;\n}\napplyStaticTexts();\ngoTitle();\nrequestAnimationFrame((t) => { last = t; frame(t); });\nif (EMB) setTimeout(() => { audioInit(); startIntro(); embReady = true; }, 60);\n})();\n</script>\n"