ion.y = 0.012; scene.add(glowF);\n}\n// líneas de cal\n{\n  const lm = new THREE.MeshBasicMaterial({ color:0xe9efe6 });\n  const L = (cx, cz, sx, sz) => { const m = new THREE.Mesh(new THREE.PlaneGeometry(sx, sz), lm); m.rotation.x = -Math.PI / 2; m.position.set(cx, 0.02, cz); scene.add(m); };\n  const w = 0.24;\n  L(-PW / 2, 0, w, PL); L(PW / 2, 0, w, PL); L(0, -PL / 2, PW, w); L(0, PL / 2, PW, w); L(0, 0, PW, w);\n  for (const s of [-1, 1]) {\n    const gz = s * PL / 2;\n    L(0, gz - s * 16.5, 40.32, w); L(-20.16, gz - s * 8.25, w, 16.5); L(20.16, gz - s * 8.25, w, 16.5);\n    L(0, gz - s * 5.5, 18.32, w); L(-9.16, gz - s * 2.75, w, 5.5); L(9.16, gz - s * 2.75, w, 5.5);\n    const spot = new THREE.Mesh(new THREE.CircleGeometry(0.13, 10), lm); spot.rotation.x = -Math.PI / 2; spot.position.set(0, 0.02, gz - s * 11); scene.add(spot);\n    const arcC = s < 0 ? Math.PI * 1.5 : Math.PI * 0.5;\n    const arc = new THREE.Mesh(new THREE.RingGeometry(9.03, 9.27, 24, 1, arcC - 0.93, 1.86), lm); arc.rotation.x = -Math.PI / 2; arc.position.set(0, 0.02, gz - s * 11); scene.add(arc);\n  }\n  const circ = new THREE.Mesh(new THREE.RingGeometry(9.03, 9.27, 48), lm); circ.rotation.x = -Math.PI / 2; circ.position.y = 0.02; scene.add(circ);\n  const cs = new THREE.Mesh(new THREE.CircleGeometry(0.15, 10), lm); cs.rotation.x = -Math.PI / 2; cs.position.y = 0.02; scene.add(cs);\n}\n// arcos\nconst NETS = [];\nfunction makeGoal(zl, dir) {\n  const g = new THREE.Group(); scene.add(g);\n  const postM = new THREE.MeshPhongMaterial({ color:0xf6f6f6, shininess:40, flatShading:true });\n  for (const sx of [-1, 1]) { const p = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.06, GH, 8), postM); p.position.set(sx * GW / 2, GH / 2, zl); g.add(p); }\n  const bar = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.06, GW + 0.12, 8), postM); bar.rotation.z = Math.PI / 2; bar.position.set(0, GH, zl); g.add(bar);\n  const D = 2.1, mk = (rx, ry) => { const t = T.net.clone(); t.needsUpdate = true; t.repeat.set(rx, ry); return new THREE.MeshBasicMaterial({ map:t, transparent:true, side:THREE.DoubleSide, depthWrite:false }); };\n  const back = new THREE.Mesh(new THREE.PlaneGeometry(GW, GH), mk(9, 3)); back.position.set(0, GH / 2, zl + dir * D); g.add(back);\n  const top = new THREE.Mesh(new THREE.PlaneGeometry(GW, D), mk(9, 3)); top.rotation.x = Math.PI / 2; top.position.set(0, GH, zl + dir * D / 2); g.add(top);\n  for (const sx of [-1, 1]) { const sd = new THREE.Mesh(new THREE.PlaneGeometry(D, GH), mk(3, 3)); sd.rotation.y = Math.PI / 2; sd.position.set(sx * GW / 2, GH / 2, zl + dir * D / 2); g.add(sd); }\n  for (const sx of [-1, 1]) { const p = new THREE.Mesh(new THREE.CylinderGeometry(0.03, 0.03, GH, 6), postM); p.position.set(sx * GW / 2, GH / 2, zl + dir * D); g.add(p); }\n  NETS.push({ back, z0:back.position.z, dir, bulge:0 });\n  return g;\n}\nmakeGoal(GZ, -1); makeGoal(-GZ, 1);\n// banderines\nfor (const sx of [-1, 1]) for (const sz of [-1, 1]) {\n  seg(V(sx * PW / 2, 0, sz * PL / 2), V(sx * PW / 2, 1.5, sz * PL / 2), 0.025, 0.02, SOFT(0xf2f2f2), scene, 6);\n  const f = new THREE.Mesh(new THREE.PlaneGeometry(0.4, 0.3), new THREE.MeshPhongMaterial({ color:0xffd23a, side:THREE.DoubleSide, flatShading:true })); f.position.set(sx * PW / 2 + 0.2, 1.33, sz * PL / 2); scene.add(f);\n}\n// carteles LED alrededor de la cancha\n{\n  let k = 0; const mk = (x, z, ry, len) => { const m = new THREE.Mesh(new THREE.BoxGeometry(len, 0.9, 0.12), [SOFT(0x15151a), SOFT(0x15151a), SOFT(0x15151a), SOFT(0x15151a), new THREE.MeshBasicMaterial({ map:BOARDS[k++ % BOARDS.length] }), SOFT(0x15151a)]); m.position.set(x, 0.45, z); m.rotation.y = ry; scene.add(m); };\n  for (let z = -45; z <= 45; z += 10) { mk(-PW / 2 - 3, z, Math.PI / 2, 9.6); mk(PW / 2 + 3, z, -Math.PI / 2, 9.6); }\n  for (let x = -30; x <= 30; x += 10) { if (Math.abs(x) < 6) continue; mk(x, GZ - 4, 0, 9.6); mk(x, -GZ + 4, Math.PI, 9.6); }\n}\n// galerías: cuatro tramos, cada uno con su público\nconst ROWS = [[49, tierY(49)], [56, tierY(56)], [63, tierY(63)], [70, tierY(70)], [77, tierY(77)], [86, tierY(86)]];\nconst crowdMats = [T.crowdMix, T.crowdU, T.crowdMix, T.crowdUC].map((t) => new THREE.MeshPhongMaterial({ map:t, color:0x8a8c9c, shininess:2, flatShading:true, side:THREE.DoubleSide }));\nconst STANDS = [];\nfor (let sg = 0; sg < 4; sg++) {\n  const n = sg % 2 ? 26 : 12;\n  STANDS.push(ringStrip(sg, n, ROWS, crowdMats[sg], 9, 1));\n  ringStrip(sg, n, [[48.6, -0.05], [48.6, 1.0], [49, 1.0]], SOFT(0x1d2350), 10, 1);                          // muro bajo\n  ringStrip(sg, n, [[86, tierY(86)], [86.5, 30.5], [88.5, 31.2]], SOFT(0xb8b8c0), 10, 1);                     // borde blanco de arriba (el Nacional no tiene techo)\n}\nT.crowdU.repeat.set(1, 1);\n// lienzos de la barra y de los cruzados\n{\n  const put = (t, text, bg, fg, stripe) => { const [x, z] = perim(t, 49.8); const m = new THREE.Mesh(new THREE.PlaneGeometry(14, 1.8), new THREE.MeshPhongMaterial({ map:bannerTex(bg, fg, text, stripe), side:THREE.DoubleSide })); m.position.set(x, 1.6, z); m.lookAt(0, 1.6, 0); scene.add(m); };\n  put(1.35, 'VAMOS LA U', '#1d3fa6', '#ffffff', '#c8202e'); put(1.65, 'SIEMPRE CONTIGO', '#f2f2f2', '#1d3fa6', '#c8202e');\n  put(3.5, 'CRUZADOS', '#f2f2f2', '#1b3f95', '#c8202e');\n}\n// banderas en la galería de la U\nconst FLAGS = [];\nfor (let i = 0; i < 14; i++) {\n  const t = 1.08 + i * 0.06, r = 56 + (i % 3) * 7, [x, z] = perim(t, r), y = tierY(r);\n  const pole = seg(V(x, y, z), V(x, y + 4.2, z), 0.04, 0.03, SOFT(0x888888), scene, 5);\n  const f = new THREE.Mesh(new THREE.PlaneGeometry(3, 1.8, 6, 1), new THREE.MeshPhongMaterial({ color:i % 3 === 1 ? 0xc8202e : i % 3 === 2 ? 0xf2f2f2 : 0x1d3fa6, side:THREE.DoubleSide, flatShading:true }));\n  f.position.set(x + 1.5, y + 3.3, z); scene.add(f); FLAGS.push({ f, base:f.geometry.attributes.position.array.slice(), ph:i });\n}\n// bengalas de la barra (detrás del arco que ataca Tironi), con su humo rojo y papelitos\nconst FLARES = [], BSMOKE = [];\nconst barraLight = new THREE.PointLight(0xff3a1c, 0, 40, 1.6); barraLight.position.set(0, tierY(56) + 4, -STR - 56); scene.add(barraLight);\n{\n  const coreM = new THREE.SpriteMaterial({ map:T.glow, color:0xfff0e0, transparent:true, depthWrite:false, blending:THREE.AdditiveBlending, fog:false });\n  // t: posición en el contorno (1.x = galería de la U detrás del arco; 3.x = la del otro arco; 0.x y 2.x = los costados)\n  const SPOTS = [1.32, 1.5, 1.68, 1.42, 1.6, 3.4, 3.62, 0.3, 0.72, 2.28, 2.7, 3.5];\n  for (let i = 0; i < SPOTS.length; i++) {\n    const r = 52 + (i % 3) * 4, [x, z] = perim(SPOTS[i], r), y = tierY(r) + 1.9;\n    const haloM = new THREE.SpriteMaterial({ map:T.glow, color:0xff2a12, transparent:true, opacity:0.9, depthWrite:false, blending:THREE.AdditiveBlending, fog:false });\n    const core = new THREE.Sprite(coreM), halo = new THREE.Sprite(haloM); core.position.set(x, y, z); halo.position.set(x, y, z); core.visible = halo.visible = false; scene.add(core, halo);\n    FLARES.push({ core, halo, x, y, z, ph:rnd() * 10, emit:0, on:false });\n  }\n  for (let i = 0; i < 90; i++) { const sp = new THREE.Sprite(new THREE.SpriteMaterial({ map:T.puff, color:0xb08080, transparent:true, opacity:0, depthWrite:false })); sp.visible = false; scene.add(sp); BSMOKE.push({ sp, life:0, max:1, vx:0, vy:0, vz:0, s0:1 }); }\n}\nlet bsIdx = 0;\nfunction flaresStep(dt, n) {\n  let lit = 0;\n  FLARES.forEach((f, i) => {\n    const on = i < n; if (on !== f.on) { f.on = on; f.core.visible = f.halo.visible = on; } if (!on) return; lit++;\n    const fl = 0.75 + 0.25 * Math.sin(G.t * 31 + f.ph) * Math.sin(G.t * 17.3 + f.ph * 2) + (Math.random() - 0.5) * 0.3;\n    f.core.scale.setScalar(0.7 + 0.25 * fl); f.halo.scale.setScalar(4.2 * (0.8 + 0.35 * fl)); f.halo.material.opacity = 0.75 + 0.2 * fl;\n    f.emit += dt * 3.2; while (f.emit > 1) { f.emit -= 1; const p = BSMOKE[bsIdx++ % BSMOKE.length]; p.sp.visible = true; p.sp.position.set(f.x + (Math.random() - 0.5) * 0.6, f.y + 0.4, f.z + (Math.random() - 0.5) * 0.6); p.life = p.max = 4 + Math.random() * 2.5; p.vx = 0.5 + Math.random() * 0.5; p.vy = 1.2 + Math.random() * 0.9; p.vz = (Math.random() - 0.5) * 0.5; p.s0 = 1.2 + Math.random(); }\n  });\n  for (const p of BSMOKE) {\n    if (p.life <= 0) continue; p.life -= dt; if (p.life <= 0) { p.sp.visible = false; continue; }\n    const k = 1 - p.life / p.max; p.vy *= Math.exp(-0.25 * dt);\n    p.sp.position.x += p.vx * dt; p.sp.position.y += p.vy * dt; p.sp.position.z += p.vz * dt;\n    p.sp.scale.setScalar(p.s0 * (1 + k * 4.5)); p.sp.material.opacity = 0.42 * Math.min(1, k * 6) * (1 - k);\n    p.sp.material.color.setRGB(lerp(1.0, 0.55, k), lerp(0.42, 0.52, k), lerp(0.38, 0.58, k));\n  }\n  barraLight.intensity = lit ? (0.6 + Math.min(lit, 5) * 0.16) * (0.8 + 0.4 * Math.random()) : 0;\n}\n// papelitos cayendo sobre la barra\nconst PAP_N = 420, papGeo = new THREE.BufferGeometry(), papPos = new Float32Array(PAP_N * 3), papCol = new Float32Array(PAP_N * 3), papV = new Float32Array(PAP_N), papR = new Float32Array(PAP_N);\nfunction papSpawn(i, top) { const r = 50 + rnd() * 18, t = rnd() < 0.55 ? 1.1 + rnd() * 0.8 : rnd() * 4, [x, z] = perim(t, r); papR[i] = tierY(r); papPos.set([x, papR[i] + (top ? 8 + rnd() * 10 : rnd() * 18), z], i * 3); }\nfor (let i = 0; i < PAP_N; i++) { papCol.set([[0.15, 0.3, 0.8], [0.96, 0.96, 0.96], [0.82, 0.15, 0.2], [0.96, 0.96, 0.96]][i % 4], i * 3); papV[i] = 0.5 + rnd() * 0.9; papSpawn(i, false); }\npapGeo.setAttribute('position', new THREE.BufferAttribute(papPos, 3)); papGeo.setAttribute('color', new THREE.BufferAttribute(papCol, 3));\nconst papel = new THREE.Points(papGeo, new THREE.PointsMaterial({ size:0.22, vertexColors:true })); papel.frustumCulled = false; scene.add(papel);\nfunction papelStep(dt) { for (let i = 0; i < PAP_N; i++) { papPos[i * 3 + 1] -= papV[i] * dt; papPos[i * 3] += Math.sin(G.t * 2.3 + i) * dt * 0.5; if (papPos[i * 3 + 1] < papR[i]) papSpawn(i, true); } papGeo.attributes.position.needsUpdate = true; }\n// torres de focos: cuatro postes blancos altos en las esquinas, cada uno con un panel lleno de focos\nconst TOWERS = [[1, 1], [-1, 1], [1, -1], [-1, -1]].map(([sx, sz]) => V(sx * 70, 60, sz * 112));\n{\n  const poleM = new THREE.MeshPhongMaterial({ color:0xe6e6ea, shininess:20, flatShading:true });\n  const frameM = new THREE.MeshPhongMaterial({ color:0xb8963a, shininess:30, flatShading:true });\n  const lampT = tex(64, 48, (g, w, h) => {\n    g.fillStyle = '#2a2418'; g.fillRect(0, 0, w, h);\n    for (let y = 0; y < 6; y++) for (let x = 0; x < 8; x++) { const cx = 4 + x * 8, cy = 4 + y * 8, gr = g.createRadialGradient(cx, cy, 0, cx, cy, 4); gr.addColorStop(0, '#ffffff'); gr.addColorStop(0.5, '#fff2c8'); gr.addColorStop(1, 'rgba(255,220,150,.2)'); g.fillStyle = gr; g.fillRect(cx - 4, cy - 4, 8, 8); }\n  }, false);\n  const lampM = new THREE.MeshBasicMaterial({ map:lampT, fog:false });\n  const glowM = new THREE.SpriteMaterial({ map:T.glow, color:0xfff2d0, transparent:true, opacity:0.9, depthWrite:false, blending:THREE.AdditiveBlending, fog:false });\n  const haloM = new THREE.SpriteMaterial({ map:T.glow, color:0xffe6b0, transparent:true, opacity:0.3, depthWrite:false, blending:THREE.AdditiveBlending, fog:false });\n  const beamT = tex(4, 64, (g, w, h) => { const gr = g.createLinearGradient(0, 0, 0, h); gr.addColorStop(0, 'rgba(255,244,215,.9)'); gr.addColorStop(0.5, 'rgba(255,240,205,.25)'); gr.addColorStop(1, 'rgba(255,240,205,0)'); g.fillStyle = gr; g.fillRect(0, 0, w, h); }, false);\n  const beamM = new THREE.MeshBasicMaterial({ map:beamT, transparent:true, opacity:0.05, depthWrite:false, blending:THREE.AdditiveBlending, side:THREE.DoubleSide, fog:false });\n  for (const P of TOWERS) {\n    // poste (más grueso abajo) y el panel inclinado mirando a la cancha\n    const pole = new THREE.Mesh(new THREE.CylinderGeometry(0.75, 1.25, P.y - 3, 10), poleM); pole.position.set(P.x, (P.y - 3) / 2, P.z); scene.add(pole);\n    const head = new THREE.Group(); head.position.copy(P); scene.add(head);\n    head.lookAt(0, 0, 0);   // el panel queda de frente a la cancha, inclinado hacia abajo\n    const box = new THREE.Mesh(new THREE.BoxGeometry(15, 11, 1.2), frameM); head.add(box);\n    const face = new THREE.Mesh(new THREE.PlaneGeometry(14, 10), lampM); face.position.z = 0.62; head.add(face);\n    const lip = new THREE.Mesh(new THREE.BoxGeometry(15.4, 1.4, 2.6), frameM); lip.position.set(0, -5.9, 0.6); head.add(lip);\n    const s1 = new THREE.Sprite(glowM); s1.scale.setScalar(22); s1.position.set(0, 0, 1.4); head.add(s1);\n    const s2 = new THREE.Sprite(haloM); s2.scale.setScalar(70); s2.position.set(0, 0, 1.0); head.add(s2);\n    // dos conos de luz por torre, que se pierden en la neblina antes de llegar al pasto\n    for (const off of [-0.5, 0.5]) {\n      const top = P.clone(), bot = V(P.x * 0.3 + off * 14 * Math.sign(P.z), 10, P.z * 0.3), len = top.distanceTo(bot);\n      const cone = new THREE.Mesh(new THREE.CylinderGeometry(4, 13, len, 14, 1, true), beamM);\n      cone.position.copy(top).add(bot).multiplyScalar(0.5); cone.quaternion.setFromUnitVectors(V(0, 1, 0), top.clone().sub(bot).normalize()); scene.add(cone);\n    }\n  }\n}\n// pantalla del marcador sobre la galería de la U\nconst screenMesh = new THREE.Mesh(new THREE.PlaneGeometry(26, 10.2), new THREE.MeshBasicMaterial({ map:T.screen }));\nscreenMesh.position.set(0, 27.6, -STR - 63.6); scene.add(screenMesh);\naddBox(27, 11, 0.6, SOFT(0x15151a), 0, 27.6, -STR - 64);\nfor (const sx of [-1, 1]) addBox(0.3, 3, 0.3, SOFT(0x3a3c48), sx * 10, 33.6, -STR - 64);\nfunction drawScreen(min) {\n  const c = T.screen.userData.canvas, g = c.getContext('2d'), w = c.width, h = c.height;\n  g.fillStyle = '#05060c'; g.fillRect(0, 0, w, h);\n  g.fillStyle = '#1d3fa6'; g.fillRect(14, 50, 170, 90); g.fillStyle = '#f2f2f2'; g.fillRect(w - 184, 50, 170, 90); g.fillStyle = '#1b3f95'; g.fillRect(w - 184, 82, 170, 24);\n  g.textAlign = 'center'; g.textBaseline = 'middle';\n  g.fillStyle = '#9fb3ff'; g.font = 'bold 26px Impact, sans-serif'; g.fillText('ESTADIO NACIONAL', w / 2, 24);\n  g.fillStyle = '#ffffff'; g.font = 'bold 50px Impact, sans-serif'; g.fillText('UCH', 99, 96);\n  g.fillStyle = '#ffffff'; g.fillText('UC', w - 99, 96);\n  g.fillStyle = '#ffd23a'; g.font = 'bold 84px Impact, sans-serif'; g.fillText(G.gU + '-' + G.gC, w / 2, 100);\n  g.fillStyle = '#ffffff'; g.font = 'bold 34px Impact, sans-serif'; g.fillText(min, w / 2, 172);\n  g.fillStyle = 'rgba(0,0,0,.35)'; for (let y = 0; y < h; y += 3) g.fillRect(0, y, w, 1);\n  T.screen.needsUpdate = true;\n}\n// banca y DT al costado de la cancha\naddBox(8, 0.5, 1.2, SOFT(0x2a2c38), PW / 2 + 5.5, 0.25, -6); addBox(8, 1.8, 0.1, new THREE.MeshPhongMaterial({ color:0x9fc0e0, transparent:true, opacity:0.35 }), PW / 2 + 6.1, 1.0, -6);\n\n/* =========================================================\n   PERSONAJES\n   ========================================================= */\n/* =========================================================\n   PERSONAJES LOW-POLY: mallas continuas con ropa y cara pintadas en texturas\n   ========================================================= */\nlet chSeed = 11;\nconst chR = () => (chSeed = (chSeed * 16807) % 2147483647) / 2147483647;\nconst chHex = (n) => '#' + (n >>> 0).toString(16).padStart(6, '0');\nfunction chCanvas(w, h, fn) {\n  const c = document.createElement('canvas'); c.width = w; c.height = h; const g = c.getContext('2d'); fn(g, w, h);\n  const t = new THREE.CanvasTexture(c); t.wrapS = THREE.RepeatWrapping; t.anisotropy = 4; return t;\n}\nfunction chNoise(g, w, h, amt, n, y0) {\n  for (let i = 0; i < n; i++) {\n    g.fillStyle = chR() < 0.5 ? 'rgba(0,0,0,' + (amt * chR()).toFixed(3) + ')' : 'rgba(255,255,255,' + (amt * 0.6 * chR()).toFixed(3) + ')';\n    g.fillRect(chR() * w | 0, (y0 || 0) + (chR() * h | 0), 1 + (chR() * 2 | 0), 1 + (chR() * 2 | 0));\n  }\n}\nfunction chWrap(g, w, h, k) {\n  const gr = g.createLinearGradient(0, 0, w, 0);\n  gr.addColorStop(0, 'rgba(0,0,0,' + k + ')'); gr.addColorStop(0.28, 'rgba(0,0,0,0)'); gr.addColorStop(0.72, 'rgba(0,0,0,0)'); gr.addColorStop(1, 'rgba(0,0,0,' + k + ')');\n  g.fillStyle = gr; g.fillRect(0, 0, w, h);\n}\nfunction chFolds(g, w, h, n, col, lw) {\n  g.lineCap = 'round';\n  for (let i = 0; i < n; i++) {\n    const x = chR() * w, y = chR() * h, l = 8 + chR() * 20, a = (chR() - 0.5) * 16, b = (chR() - 0.5) * 12;\n    g.strokeStyle = 'rgba(255,255,255,.10)'; g.lineWidth = (lw || 2) * 0.8; g.beginPath(); g.moveTo(x - 2, y); g.quadraticCurveTo(x - 2 + a, y + l * 0.5, x - 2 + b, y + l); g.stroke();\n    g.strokeStyle = col; g.lineWidth = lw || 2; g.beginPath(); g.moveTo(x, y); g.quadraticCurveTo(x + a, y + l * 0.5, x + b, y + l); g.stroke();\n  }\n}\n// sombra \"horneada\" en los extremos de una pieza (axilas, cintura, rodillas) y luz al medio\nfunction chBake(g, w, h, top, bot) {\n  const gr = g.createLinearGradient(0, 0, 0, h);\n  gr.addColorStop(0, 'rgba(0,0,0,' + top + ')'); gr.addColorStop(0.15, 'rgba(0,0,0,0)'); gr.addColorStop(0.85, 'rgba(0,0,0,0)'); gr.addColorStop(1, 'rgba(0,0,0,' + bot + ')');\n  g.fillStyle = gr; g.fillRect(0, 0, w, h);\n}\nconst chMat = (map, o) => new THREE.MeshPhongMaterial(Object.assign({ map:map || null, flatShading:true, shininess:6, specular:0x111111 }, o || {}));\n// Malla tipo \"loft\": anillos (polígonos) a lo largo de +y. u rodea el cuerpo (frente en u=0.5), v sube por la altura.\n// rz = radio hacia adelante, rzb = hacia atrás, sq = exponente (2 = óvalo, más alto = más cuadrado). shape(x, y, z, phi) puede deformar cada vértice (phi = 0 al frente).\nfunction chLoft(rings, sides, capBot, capTop, shape) {\n  const pos = [], uv = [], idx = [], S = sides, R = rings.length, y0 = rings[0].y, span = (rings[R - 1].y - y0) || 1;\n  for (let r = 0; r < R; r++) {\n    const q = rings[r], e = 2 / (q.sq || 2);\n    for (let s = 0; s <= S; s++) {\n      const th = Math.PI + s / S * Math.PI * 2, sn = Math.sin(th), cs = Math.cos(th);\n      let x = (q.x || 0) + Math.sign(sn) * Math.pow(Math.abs(sn), e) * q.rx, z = (q.z || 0) + Math.sign(cs) * Math.pow(Math.abs(cs), e) * (cs < 0 && q.rzb != null ? q.rzb : q.rz);\n      if (shape) { const o = shape(x, q.y, z, th - Math.PI * 2); x = o[0]; z = o[1]; }\n      pos.push(x, q.y, z); uv.push(s / S, (q.y - y0) / span);\n    }\n  }\n  for (let r = 0; r < R - 1; r++) for (let s = 0; s < S; s++) { const a = r * (S + 1) + s, b = a + 1, c = a + S + 1, d = c + 1; idx.push(a, b, c, b, d, c); }\n  const cap = (r, top) => { const q = rings[r], ci = pos.length / 3; pos.push(q.x || 0, q.y, q.z || 0); uv.push(0.5, top ? 1 : 0); for (let s = 0; s < S; s++) { const a = r * (S + 1) + s, b = a + 1; if (top) idx.push(ci, a, b); else idx.push(ci, b, a); } };\n  if (capBot) cap(0, false); if (capTop) cap(R - 1, true);\n  const geo = new THREE.BufferGeometry(); geo.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3)); geo.setAttribute('uv', new THREE.Float32BufferAttribute(uv, 2)); geo.setIndex(idx); geo.computeVertexNormals(); return geo;\n}\n// pieza entre A y B; fwd = hacia dónde mira el \"frente\" de la pieza (por defecto, adelante del personaje)\nconst chFwd = new THREE.Vector3(0, 0, 1), chMx = new THREE.Matrix4();\nfunction chSegment(A, B, prof, sides, mat, parent, cb, ct, fwd) {\n  const d = new THREE.Vector3().subVectors(B, A), len = d.length(); d.normalize();\n  const m = new THREE.Mesh(chLoft(prof.map(([t, rx, rz, rzb, sq]) => ({ y:t * len, rx, rz, rzb, sq })), sides, cb, ct), mat);\n  let z = (fwd || chFwd).clone().addScaledVector(d, -d.dot(fwd || chFwd));\n  if (z.lengthSq() < 1e-4) z = new THREE.Vector3(0, -1, 0).addScaledVector(d, d.y);\n  z.normalize(); const x = new THREE.Vector3().crossVectors(d, z);\n  chMx.makeBasis(x, d, z); m.quaternion.setFromRotationMatrix(chMx);\n  m.position.copy(A); parent.add(m); return m;\n}\n// ---- texturas pintadas ----\nfunction chTorsoTex(c) {\n  return chCanvas(128, 128, (g, w, h) => {\n    g.fillStyle = chHex(c.top); g.fillRect(0, 0, w, h); chNoise(g, w, h, 0.07, 1400);\n    const y = (t) => (1 - t) * h;\n    if (c.kind === 'uc') {\n      g.fillStyle = '#c8202e'; g.fillRect(0, y(0.66), w, 4); g.fillRect(0, y(0.47) - 4, w, 4);\n      g.fillStyle = '#1b3f95'; g.fillRect(0, y(0.66) + 4, w, y(0.47) - y(0.66) - 8); g.fillRect(0, 0, w, y(0.94));\n      g.beginPath(); g.moveTo(52, 0); g.lineTo(64, 13); g.lineTo(76, 0); g.fill();\n      chFolds(g, w, h, 12, 'rgba(60,60,80,.16)');\n    } else if (c.kind === 'jacket') {\n      g.fillStyle = 'rgba(0,0,0,.35)'; g.fillRect(62, 0, 4, h); g.fillStyle = 'rgba(255,255,255,.4)'; for (let yy = 2; yy < h; yy += 4) g.fillRect(63, yy, 2, 2);\n      g.fillStyle = 'rgba(0,0,0,.2)'; g.fillRect(34, 86, 20, 14); g.fillRect(74, 86, 20, 14); g.fillRect(0, h - 9, w, 9);\n      g.fillStyle = 'rgba(0,0,0,.15)'; g.fillRect(31, 0, 2, h); g.fillRect(95, 0, 2, h);\n      chFolds(g, w, h, 18, 'rgba(60,40,20,.2)', 2.5);\n    } else if (c.kind === 'shirt') {\n      g.fillStyle = 'rgba(0,0,0,.1)'; g.fillRect(61, 0, 6, h); g.fillStyle = '#cfcfcf'; for (let yy = 14; yy < h; yy += 16) { g.beginPath(); g.arc(64, yy, 1.7, 0, 7); g.fill(); }\n      g.fillStyle = 'rgba(0,0,0,.18)'; g.beginPath(); g.moveTo(46, 0); g.lineTo(64, 12); g.lineTo(82, 0); g.lineTo(77, 0); g.lineTo(64, 8); g.lineTo(51, 0); g.fill();\n      if (c.shades) { g.fillStyle = '#121214'; g.beginPath(); g.ellipse(57, 34, 6, 4, 0.1, 0, 7); g.ellipse(71, 34, 6, 4, -0.1, 0, 7); g.fill(); g.fillRect(62, 33, 4, 1); }\n      chFolds(g, w, h, 12, 'rgba(70,70,90,.14)');\n    } else if (c.kind === 'suit') {\n      g.fillStyle = '#f2f2f0'; g.beginPath(); g.moveTo(44, 0); g.lineTo(64, 58); g.lineTo(84, 0); g.fill();\n      g.fillStyle = '#6a6a74'; g.beginPath(); g.moveTo(61, 4); g.lineTo(67, 4); g.lineTo(69, 46); g.lineTo(64, 54); g.lineTo(59, 46); g.fill();\n      g.fillStyle = 'rgba(255,255,255,.4)'; for (let i = 0; i < 14; i++) g.fillRect(60 + chR() * 8, 8 + chR() * 40, 1, 1);\n      g.strokeStyle = 'rgba(0,0,0,.5)'; g.lineWidth = 3; g.beginPath(); g.moveTo(42, 0); g.lineTo(64, 64); g.lineTo(86, 0); g.stroke();\n      g.fillStyle = '#16161a'; for (const yy of [76, 96]) { g.beginPath(); g.arc(64, yy, 2.2, 0, 7); g.fill(); }\n      chFolds(g, w, h, 10, 'rgba(0,0,0,.22)');\n    } else if (c.kind === 'tee') {\n      g.fillStyle = 'rgba(0,0,0,.28)'; g.beginPath(); g.ellipse(64, 0, 15, 8, 0, 0, Math.PI); g.fill();\n      g.strokeStyle = 'rgba(255,255,255,.12)'; g.lineWidth = 2; g.beginPath(); g.ellipse(64, 0, 16, 9, 0, 0.1, Math.PI - 0.1); g.stroke();\n      if (c.print != null) { g.fillStyle = 'rgba(0,0,0,.18)'; g.fillRect(74, 30, 16, 17); g.strokeStyle = chHex(c.print); g.globalAlpha = 0.5; g.lineWidth = 1; g.setLineDash([2, 2]); g.strokeRect(74.5, 30.5, 15, 16); g.setLineDash([]); g.globalAlpha = 1; }\n      if (c.shades) { g.fillStyle = '#111114'; g.beginPath(); g.ellipse(58, 15, 5.5, 3.6, 0.15, 0, 7); g.ellipse(70, 15, 5.5, 3.6, -0.15, 0, 7); g.fill(); g.fillRect(63, 13, 2, 1.5); g.fillStyle = 'rgba(255,255,255,.25)'; g.fillRect(55, 13, 2, 1); g.fillRect(67, 13, 2, 1); }\n      chFolds(g, w, h, 14, 'rgba(0,0,0,.18)');\n    } else if (c.kind === 'sweater') {\n      g.fillStyle = 'rgba(0,0,0,.12)'; for (let x = 0; x < w; x += 4) for (let yy = (x / 4) % 2 * 3; yy < h; yy += 6) g.fillRect(x, yy, 2, 3);\n      g.fillStyle = 'rgba(0,0,0,.2)'; g.fillRect(0, h - 12, w, 12); g.fillStyle = 'rgba(255,255,255,.12)'; for (let x = 0; x < w; x += 3) g.fillRect(x, h - 12, 1, 12);\n      g.fillStyle = 'rgba(0,0,0,.22)'; g.beginPath(); g.ellipse(64, 0, 15, 8, 0, 0, Math.PI); g.fill();\n      if (c.shirtCollar != null) { g.fillStyle = chHex(c.shirtCollar); g.beginPath(); g.moveTo(52, 0); g.lineTo(60, 10); g.lineTo(64, 3); g.lineTo(68, 10); g.lineTo(76, 0); g.fill(); g.fillStyle = 'rgba(0,0,0,.2)'; g.fillRect(63, 3, 2, 6); }\n      chFolds(g, w, h, 10, 'rgba(0,0,0,.18)', 2.5);\n    } else if (c.kind === 'kit') {\n      // camiseta de fútbol: cuello en V con ribete, franjas laterales y tela con rayitas\n      g.fillStyl