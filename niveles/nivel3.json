tion puff(x, y, z, color, spread, life, size) {\n  const p = puffs[puffIdx++ % puffs.length]; p.sp.material.color.setHex(color); p.sp.position.set(x, y, z); p.sp.visible = true;\n  p.life = p.max = life * (0.7 + rnd() * 0.6); p.vx = (rnd() - 0.5) * spread; p.vy = 0.25 + rnd() * 0.35; p.vz = (rnd() - 0.5) * spread; p.grow = size;\n}\nconst tears = [];\nfor (let i = 0; i < 12; i++) { const s = new THREE.Sprite(new THREE.SpriteMaterial({ color:0x8fd0ff, transparent:true, opacity:0.9, depthWrite:false })); s.scale.set(0.035, 0.05, 1); s.visible = false; scene.add(s); tears.push({ s, t:0, vx:0, vy:0, vz:0 }); }\nlet tearIdx = 0, tearT = 0;\nconst CONF_N = 700;\nconst confGeo = new THREE.BufferGeometry(), confPos = new Float32Array(CONF_N * 3), confCol = new Float32Array(CONF_N * 3), confV = new Float32Array(CONF_N);\nfor (let i = 0; i < CONF_N; i++) { const c = [[0.12, 0.25, 0.65], [0.95, 0.95, 0.95], [0.78, 0.13, 0.18]][i % 3]; confCol.set(c, i * 3); confV[i] = 0.6 + rnd() * 1.2; }\nconfGeo.setAttribute('position', new THREE.BufferAttribute(confPos, 3)); confGeo.setAttribute('color', new THREE.BufferAttribute(confCol, 3));\nconst confetti = new THREE.Points(confGeo, new THREE.PointsMaterial({ size:0.16, vertexColors:true })); confetti.visible = false; confetti.frustumCulled = false; scene.add(confetti);\nfunction startConfetti(cx, cz) { for (let i = 0; i < CONF_N; i++) confPos.set([cx + (rnd() - 0.5) * 30, 3 + rnd() * 16, cz + (rnd() - 0.5) * 30], i * 3); confGeo.attributes.position.needsUpdate = true; confetti.visible = true; }\n\n/* =========================================================\n   AUDIO (todo sintetizado)\n   ========================================================= */\nconst AU = { ctx:null, on:true };\nconst SND = { chant:null, gol:null, bytes:{} };\n// cánticos: van con un <audio> que parte al tiro (antes había que decodificar 5 minutos de audio y tardaba en sonar)\nconst chantEl = new Audio(); chantEl.loop = true; chantEl.preload = 'auto'; chantEl.volume = 0.32 * VOL.sfx;\n((typeof EMB !== 'undefined' && EMB) ? fetch('canticos.mp3').then((r) => r.blob()).then((b) => URL.createObjectURL(b)) : Promise.resolve('canticos.mp3'))\n  .then((u) => { chantEl.src = u; chantEl.load(); SND.chant = true; if (wantChant()) chantPlay(); }).catch(() => {});\nfor (const [k, url] of [['gol', 'gol.mp3']]) fetch(url).then((r) => r.ok ? r.arrayBuffer() : null).then((b) => { if (b) { SND.bytes[k] = b; decodeSnd(); } }).catch(() => {});\nfunction decodeSnd() {\n  if (!AU.ctx) return;\n  for (const k of ['gol']) {\n    const b = SND.bytes[k]; if (!b || SND[k] || SND['dec_' + k]) continue; SND['dec_' + k] = true;\n    AU.ctx.decodeAudioData(b.slice(0)).then((buf) => { SND[k] = buf; }).catch(() => {});\n  }\n}\nconst wantChant = () => ['chat', 'intro', 'pre', 'play', 'post', 'losecine', 'pens', 'penintro'].includes(G.mode) || (G.mode === 'pause' && G.prev !== 'goal');\nfunction chantPlay() {\n  if (!SND.chant || !chantEl.paused) return;\n  chantEl.muted = !AU.on; const p = chantEl.play(); if (p && p.catch) p.catch(() => {});\n}\nfunction chantStop() { if (!chantEl.paused) chantEl.pause(); }\nfunction golPlay() {\n  if (!AU.ctx) return; crowd(0.9, 0.1); setTimeout(() => crowd(SND.chant ? 0.18 : 0.45, 1.5), 3500);\n  if (!SND.gol) { sfx.roar(); return; }\n  golSound(1, 0);\n}\n// el grito del gol: una sola instancia a la vez; en la repetición vuelve a sonar un poco más lento y se apaga al terminar\nfunction golSound(rate, off) {\n  if (!AU.ctx || !SND.gol) return; golFade(0.15);\n  const s = AU.ctx.createBufferSource(), g = AU.ctx.createGain(); s.buffer = SND.gol; s.playbackRate.value = rate || 1; g.gain.value = 0.5; s.connect(g); g.connect(AU.master); s.start(0, off || 0);\n  SND.golNow = { s, g };\n}\nfunction golFade(sec) {\n  const n = SND.golNow; if (!n || !AU.ctx) return; SND.golNow = null; const t = AU.ctx.currentTime;\n  try { n.g.gain.cancelScheduledValues(t); n.g.gain.setValueAtTime(n.g.gain.value, t); n.g.gain.linearRampToValueAt