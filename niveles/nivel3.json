"<title data-own>Tironi y Kapu</title>\n<meta data-own name=\"claude:viewport-fit-sides\" content=\"cover\">\n<link data-own rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link data-own rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link data-own rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Bungee&family=Chakra+Petch:wght@400;600;700&display=swap\">\n<style data-own>\n/* Layout: estadio 3D a pantalla completa; capas de interfaz encima (menú, chat, HUD del partido). Look único oscuro. */\n:root{\n  --void:#14101d;\n  --panel:rgba(24,19,35,.9);\n  --line:#463c61;\n  --text:#f4eddf;\n  --muted:#b9aecb;\n  --bencina:#ffc23a;\n  --bencina-ink:#1c1406;\n  --morado:#5a2a8a;\n  --pito:#8fd694;\n  --rojo:#ff5f4e;\n  --pasao:#ff4fd8;\n  --me:#2e6a4b;\n  --them:#2d2742;\n  --phone:#100e17;\n  --f-display:\"Bungee\", Impact, \"Arial Black\", sans-serif;\n  --f-ui:\"Chakra Petch\", \"Trebuchet MS\", Verdana, sans-serif;\n  color-scheme:dark;\n}\n[hidden]{display:none!important}\nhtml,body{height:100%}\nbody{margin:0;background:var(--void);color:var(--text);font-family:var(--f-ui);overflow:hidden;-webkit-font-smoothing:antialiased}\n#gl{position:fixed;inset:0;width:100%;height:100%;display:block;z-index:2}\n.layer{position:fixed;inset:0;box-sizing:border-box;z-index:5;\n  padding-top:calc(20px + env(safe-area-inset-top,0px));padding-bottom:calc(20px + env(safe-area-inset-bottom,0px));\n  padding-left:max(16px, env(safe-area-inset-left,0px));padding-right:max(16px, env(safe-area-inset-right,0px))}\n.overlay{display:flex;align-items:center;justify-content:center;overflow:auto;background:linear-gradient(180deg,rgba(20,16,29,.2),rgba(20,16,29,.75))}\nh1,h2,p{margin:0}\n.tag{display:inline-block;font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:12px;color:var(--muted)}\n.muted{color:var(--muted)}\n\n/* ---------- Título ---------- */\n.title-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:32px;width:min(1080px,100%);align-items:end}\n@media (max-width:860px){.title-grid{grid-template-columns:minmax(0,1fr);gap:20px}}\n.title-left,.title-right{display:flex;flex-direction:column;gap:14px;min-width:0}\n.logo{font-family:var(--f-display);font-weight:400;font-size:clamp(64px,10vw,124px);line-height:.86;color:var(--bencina);text-shadow:5px 5px 0 var(--morado),10px 10px 0 rgba(0,0,0,.55)}\n.subtitle{font-family:var(--f-display);font-size:clamp(18px,2.4vw,26px);line-height:1.15;text-shadow:3px 3px 0 #000;text-wrap:balance}\n.card{background:var(--panel);border:2px solid var(--line);padding:16px 18px;display:flex;flex-direction:column;gap:8px}\n.card h2{font-size:21px;font-weight:700;text-wrap:balance}\n.card p{font-size:15px;line-height:1.5;color:var(--muted);max-width:60ch}\n.small-h{font-family:var(--f-display);font-weight:400;font-size:20px;text-shadow:2px 2px 0 #000}\n.keys{display:grid;grid-template-columns:auto minmax(0,1fr);gap:6px 14px;font-size:14px;background:var(--panel);border:2px solid var(--line);padding:12px 14px;margin:0}\n.keys dt{white-space:nowrap}\n.keys dd{margin:0;color:var(--muted)}\nkbd{font-family:var(--f-ui);font-weight:700;font-size:12px;padding:1px 6px;border:2px solid var(--line);border-bottom-width:4px;background:var(--void);color:var(--text)}\n.actions{display:flex;gap:12px;align-items:center;flex-wrap:wrap}\n.btn{font-family:var(--f-display);font-size:22px;background:var(--bencina);color:var(--bencina-ink);border:0;padding:13px 28px;cursor:pointer;box-shadow:5px 5px 0 var(--morado)}\n.btn:hover{filter:brightness(1.06)}\n.btn:active{transform:translate(3px,3px);box-shadow:2px 2px 0 var(--morado)}\n.btn:disabled{opacity:.6;cursor:wait}\n.btn.ghost{background:transparent;color:var(--text);border:2px solid var(--line);box-shadow:none;font-family:var(--f-ui);font-weight:700;font-size:15px;padding:10px 16px}\n.btn.small{font-size:17px;padding:10px 18px}\n:focus-visible{outline:3px solid var(--pito);outline-offset:3px}\n.note{font-weight:700;color:var(--bencina)}\n\n/* ---------- Chat ---------- */\n.phone{width:min(390px,100%);height:min(680px,100%);display:flex;flex-direction:column;background:var(--phone);border:3px solid #2b2540;box-shadow:8px 8px 0 rgba(0,0,0,.5)}\n.phone header{display:flex;gap:12px;align-items:center;padding:12px 14px;background:#1d2a23;border-bottom:2px solid #13201a}\n.avatar{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;font-family:var(--f-display);background:linear-gradient(135deg,#5a2a35,#6f5a42);color:#fff;flex:none;border:2px solid #2d3a33}\n.who{min-width:0}\n.who b{display:block;font-size:17px}\n.who span{font-size:13px;color:#a9d6b6}\n.msgs{flex:1;min-height:0;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:6px;background:#15121f}\n.msg{max-width:82%;padding:7px 10px 5px;font-size:15px;line-height:1.38;overflow-wrap:anywhere}\n.msg time{display:block;text-align:right;font-size:11px;color:rgba(255,255,255,.5);margin-top:2px}\n.msg.me{align-self:flex-end;background:var(--me);border-radius:10px 10px 2px 10px}\n.msg.them{align-self:flex-start;background:var(--them);border-radius:10px 10px 10px 2px}\n.msg.sys{align-self:center;background:rgba(255,194,58,.1);color:var(--bencina);font-size:13px;text-align:center;border:1px dashed rgba(255,194,58,.5);max-width:94%}\n.typing{align-self:flex-start;background:var(--them);border-radius:10px;padding:10px 12px;display:flex;gap:4px}\n.typing i{width:6px;height:6px;border-radius:50%;background:var(--muted);animation:dot 1s infinite}\n.typing i:nth-child(2){animation-delay:.15s}.typing i:nth-child(3){animation-delay:.3s}\n@keyframes dot{0%,60%,100%{opacity:.3}30%{opacity:1}}\n.phone footer{padding:12px;display:flex;gap:10px;justify-content:space-between;align-items:center;flex-wrap:wrap;border-top:2px solid #241f33;background:#1a1626}\n.draft{font-size:12px;color:var(--muted);padding:6px 14px 0;background:#15121f}\n\n/* ---------- HUD del partido ---------- */\n.hud{pointer-events:none}\n.hud-l{position:absolute;top:calc(14px + env(safe-area-inset-top,0px));left:max(16px, env(safe-area-inset-left,0px));display:flex;flex-direction:column;gap:6px}\n/* marcador estilo transmisión de TV */\n.tv-top{display:flex;align-items:center;gap:8px;font-weight:700;font-size:11px;letter-spacing:.14em;text-transform:uppercase}\n.tv-top .live{display:flex;align-items:center;gap:5px;background:#d4202c;color:#fff;padding:2px 7px 2px 6px}\n.tv-top .live i{width:7px;height:7px;border-radius:50%;background:#fff;animation:blink 1.2s steps(2) infinite}\n.tv-top .tv-ch{color:#cfd6ea;text-shadow:1px 1px 0 #000}\n.tv-ch b,.tv-bug b,#wipe b{font-weight:900;color:var(--bencina);margin-left:1px}\n.board{display:flex;align-items:stretch;background:linear-gradient(180deg,#141b3a,#0a0e22);border:0;border-left:4px solid var(--bencina);padding:0;font-weight:700;text-transform:uppercase;letter-spacing:.08em;font-size:14px;box-shadow:4px 4px 0 rgba(0,0,0,.45);clip-path:polygon(0 0,100% 0,calc(100% - 10px) 100%,0 100%)}\n.board .tm{display:flex;align-items:center;gap:7px;padding:7px 10px;color:#fff}\n.board .tm i{width:6px;height:18px;display:block}\n.board .u i{background:linear-gradient(180deg,#1d3fa6 0 60%,#c8202e 60%)}\n.board .c i{background:linear-gradient(180deg,#f4f4f2 0 50%,#1b3f95 50%)}\n.board b{display:flex;align-items:center;padding:0 10px;background:#f4eddf;color:#0a0e22;font-family:var(--f-display);font-weight:400;font-size:24px;font-variant-numeric:tabular-nums;white-space:nowrap}\n.board em{display:flex;align-items:center;font-style:normal;background:var(--bencina);color:var(--bencina-ink);padding:0 16px 0 9px;font-variant-numeric:tabular-nums}\n.tv-bug{position:absolute;right:max(18px, env(safe-area-inset-right,0px));bottom:calc(16px + env(safe-area-inset-bottom,0px));font-weight:900;font-size:15px;letter-spacing:.06em;color:rgba(255,255,255,.55);text-shadow:1px 1px 0 rgba(0,0,0,.5)}\n.tv-bug b{color:rgba(255,194,58,.7)}\n.meter.thin{height:9px}\n#m-air{background:linear-gradient(90deg,#7fd0ff,#e9f6ff)}\n#hud.pens .air-l,#hud.pens #h-airbar{display:none}\n.meter-label small{font-size:10px;opacity:.7;letter-spacing:.06em}\n/* cortinilla entre jugadas y repetición */\n#wipe{position:fixed;inset:0;z-index:6;pointer-events:none;display:grid;place-items:center;transform:translateX(-110%);\n  background:repeating-linear-gradient(115deg,#1d3fa6 0 70px,#14297a 70px 140px,#c8202e 140px 156px,#f4f4f2 156px 166px)}\n#wipe span{font-weight:900;font-size:clamp(40px,7vw,90px);letter-spacing:.06em;color:#fff;text-shadow:5px 5px 0 rgba(0,0,0,.4);font-family:var(--f-display)}\n#wipe.run{animation:wipeRun 1.05s cubic-bezier(.7,0,.3,1) forwards}\n@keyframes wipeRun{0%{transform:translateX(-110%)}38%,58%{transform:translateX(0)}100%{transform:translateX(110%)}}\n#replay{position:fixed;z-index:7;top:calc(12vh + 18px);right:max(28px, env(safe-area-inset-right,0px));display:flex;align-items:center;gap:10px;font-weight:900;font-size:clamp(16px,2vw,22px);letter-spacing:.2em;text-transform:uppercase;color:#fff;text-shadow:2px 2px 0 #000;pointer-events:none}\n#replay b{display:grid;place-items:center;width:1.7em;height:1.7em;border-radius:50%;background:#d4202c;letter-spacing:0;font-size:1.1em;animation:blink 1.2s steps(2) infinite}\n.hud-line{font-weight:700;font-size:14px;letter-spacing:.08em;text-transform:uppercase;text-shadow:2px 2px 0 #000}\n.jt{width:min(240px,40vw);height:6px;background:rgba(255,255,255,.18);border:1px solid #000}\n.jt i{display:block;height:100%;width:100%;background:var(--text)}\n.jt.warn i{background:var(--rojo)}\n.hud-r{position:absolute;top:calc(14px + env(safe-area-inset-top,0px));right:max(16px, env(safe-area-inset-right,0px));display:flex;flex-direction:column;gap:6px;width:min(260px,30vw)}\n.meter-label{display:flex;justify-content:space-between;align-items:center;gap:8px;font-weight:700;font-size:13px;text-transform:uppercase;letter-spacing:.08em;text-shadow:2px 2px 0 #000}\n.meter{height:16px;border:2px solid #000;background:rgba(10,8,16,.75);position:relative}\n.meter i{display:block;height:100%;width:0}\n#m-culpa{background:linear-gradient(90deg,#8fd694,#ffc23a 55%,#ff5f4e)}\n#m-vola{background:var(--pito)}\n.meter.warn{animation:blink .4s steps(2) infinite}\n.hud.pasao #m-vola{background:var(--pasao)}\n@keyframes blink{50%{opacity:.4}}\n.pitos{display:flex;gap:9px}\n.pitos i{width:26px;height:8px;background:rgba(10,8,16,.7);border:2px solid #000;position:relative;display:block}\n.pitos i.on{background:#f2efe6}\n.pitos i.on::after{content:\"\";position:absolute;right:-7px;top:-2px;width:6px;height:8px;background:#ff7a2e;border:2px solid #000;border-left:0}\n#power{position:absolute;left:50%;bottom:calc(70px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);display:flex;align-items:center;gap:10px;font-weight:700;text-transform:uppercase;font-size:13px;letter-spacing:.08em;text-shadow:2px 2px 0 #000}\n.pw{width:min(240px,40vw);height:16px;border:2px solid #000;background:rgba(10,8,16,.8);position:relative}\n.pw i{display:block;height:100%;width:0;background:var(--bencina)}\n.pw i.over{background:var(--rojo)}\n.pw b{position:absolute;top:-4px;bottom:-4px;left:45%;width:38%;border:2px solid var(--pito);pointer-events:none}\n#banner{position:absolute;top:20%;left:0;right:0;text-align:center;font-family:var(--f-display);font-size:clamp(26px,4.4vw,52px);color:#fff;text-shadow:3px 3px 0 #000;opacity:0;transition:opacity .25s}\n#banner small{display:block;font-family:var(--f-ui);font-weight:700;font-size:15px;letter-spacing:.2em;text-transform:uppercase;color:var(--bencina);margin-top:4px}\n#banner.show{opacity:1}\n#center{position:absolute;top:36%;left:0;right:0;text-align:center;font-family:var(--f-display);font-size:clamp(44px,8vw,100px);color:var(--bencina);text-shadow:5px 5px 0 var(--morado),9px 9px 0 rgba(0,0,0,.5);opacity:0;transition:opacity .15s}\n#center.show{opacity:1}\n#center.green{color:var(--pito)}\n#center.red{color:var(--rojo);font-size:clamp(34px,6vw,72px)}\n#center.blue{color:#8fb6ff;text-shadow:5px 5px 0 #0d1f5a,9px 9px 0 rgba(0,0,0,.5)}\n#hint{position:absolute;bottom:calc(22px + env(safe-area-inset-bottom,0px));left:50%;transform:translateX(-50%);max-width:min(600px,80vw);text-align:center;font-weight:700;font-size:15px;background:rgba(10,8,16,.82);border:2px solid var(--line);padding:6px 12px;opacity:0;transition:opacity .25s}\n#hint.show{opacity:1}\n#bubble{position:fixed;left:0;top:0;z-index:5;transform:translate(-50%,-100%);background:#fff;color:#111;font-weight:700;font-size:14px;line-height:1.3;padding:6px 10px;border-radius:10px;max-width:240px;text-align:center;pointer-events:none;box-shadow:3px 3px 0 #000}\n#bubble::after{content:\"\";position:absolute;left:50%;bottom:-8px;transform:translateX(-50%);border:8px solid transparent;border-top-color:#fff;border-bottom:0}\n#cine-card{position:fixed;z-index:7;top:calc(11vh + 20px);left:max(28px, env(safe-area-inset-left,0px));opacity:0;transform:translateX(-12px);transition:opacity .5s,transform .5s;pointer-events:none}\n#cine-card.show{opacity:1;transform:none}\n#cine-card b{display:block;font-family:var(--f-display);font-weight:400;font-size:clamp(22px,3vw,32px);color:#fff;text-shadow:3px 3px 0 #000}\n#cine-card span{font-weight:700;letter-spacing:.14em;text-transform:uppercase;font-size:13px;color:#8fb6ff;text-shadow:2px 2px 0 #000}\n#wsp .w-msg.in{align-self:flex-start;background:#1f2c33;border-radius:.6em .6em .6em .15em}\n#wsp .w-msg.in .w-audio i{background:#8fb6ff}\n#wsp .w-msg.in .w-audio i::after{border-left-color:#1f2c33}\n#wsp header .av{background:linear-gradient(135deg,#1d3fa6,#c8202e)}\n.phone .avatar{background:linear-gradient(135deg,#1d3fa6,#c8202e)}\n\n/* ---------- Penales ---------- */\n#pens{position:absolute;top:calc(14px + env(safe-area-inset-top,0px));left:50%;transform:translateX(-50%);background:rgba(10,8,16,.82);border:2px solid var(--line);padding:8px 14px;display:flex;flex-direction:column;gap:6px;box-shadow:4px 4px 0 rgba(0,0,0,.4)}\n#pens .prow{display:flex;align-items:center;gap:7px}\n#pens .prow b{width:42px;font-family:var(--f-display);font-weight:400;font-size:16px}\n#pens .prow:first-child b{color:#8fb6ff}\n#pens .prow i{width:16px;height:16px;border-radius:50%;border:2px solid #5a5370;display:inline-block;box-sizing:border-box}\n#pens .prow i.ok{background:#4fd36b;border-color:#4fd36b}\n#pens .prow i.no{background:#ff5f4e;border-color:#ff5f4e}\n#pens .prow em{font-style:normal;font-weight:700;margin-left:6px;font-size:18px}\n#pen-help{position:absolute;left:50%;bottom:calc(118px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:rgba(10,8,16,.8);border:2px solid var(--line);padding:7px 14px;font-weight:700;font-size:15px;text-align:center;white-space:nowrap}\n#pen-help kbd{font-size:13px}\n#hud.pens .jt, #hud.pens #h-jug, #hud.pens #h-culpabar, #hud.pens .hud-r .meter-label:first-child{display:none}\n\n/* ---------- Cinemáticas ---------- */\n#letterbox{position:fixed;inset:0;pointer-events:none;z-index:6}\n#letterbox i{position:absolute;left:0;right:0;height:0;background:#000;transition:height .5s ease}\n#letterbox i:first-child{top:0}#letterbox i:last-child{bottom:0}\nbody.cine #letterbox i{height:11vh}\n#subs{position:fixed;z-index:7;left:50%;bottom:calc(11vh + 18px);transform:translateX(-50%);width:min(760px,88vw);text-align:center;font-size:clamp(17px,2vw,22px);font-weight:700;line-height:1.35;text-shadow:2px 2px 0 #000;opacity:0;transition:opacity .2s;pointer-events:none}\n#subs.show{opacity:1}\n#subs b{color:var(--bencina);margin-right:.5em;text-transform:uppercase;letter-spacing:.06em}\nbody.wsp #subs{bottom:auto;top:50%;left:auto;right:max(16px, calc(50vw - var(--pw) / 2 - 330px));transform:translateY(-50%);width:min(280px,calc(50vw - var(--pw) / 2 - 40px));text-align:left;background:rgba(10,8,16,.8);border:2px solid var(--line);padding:12px 14px}\n#skip{position:fixed;z-index:8;right:max(16px, env(safe-area-inset-right,0px));bottom:calc(16px + env(safe-area-inset-bottom,0px));background:rgba(10,8,16,.7)}\n/* celular con WhatsApp del final */\n:root{--ph:min(74vh,150vw);--pw:calc(var(--ph) * 9 / 16)}\n#wsp{pointer-events:none;position:fixed;left:50%;top:50%;width:var(--pw);height:var(--ph);transform:translate(-50%,-40%) scale(.9);opacity:0;z-index:6;border-radius:calc(var(--ph) * .05);overflow:hidden;background:#0d1418;display:flex;flex-direction:column;\n  box-shadow:0 0 0 calc(var(--ph) * .022) #0b0b0f,0 0 0 calc(var(--ph) * .027) #3a3a46,0 30px 120px 40px rgba(0,0,0,.6);transition:opacity .5s,transform .7s cubic-bezier(.2,.8,.2,1);font-size:calc(var(--ph) * .022)}\nbody.wsp #wsp{opacity:1;transform:translate(-50%,-50%) scale(1)}\n#wsp header{display:flex;gap:.7em;align-items:center;padding:1.6em .9em .7em;background:#1f2c33}\n#wsp header .av{width:2.2em;height:2.2em;border-radius:50%;background:linear-gradient(135deg,#b83a3a,#2b59cc);display:grid;place-items:center;font-family:var(--f-display)}\n#wsp header b{display:block}#wsp header span{font-size:.8em;color:#9fb3ba}\n#wsp .w-msgs{flex:1;padding:.8em;display:flex;flex-direction:column;gap:.5em;justify-content:flex-end;background:#0b141a}\n#wsp .w-msg{align-self:flex-end;max-width:85%;background:#005c4b;border-radius:.6em .6em .15em .6em;padding:.5em .7em;opacity:0;transform:translateY(8px);transition:opacity .3s,transform .3s}\n#wsp .w-msg.show{opacity:1;transform:none}\n#wsp .w-audio{display:flex;align-items:center;gap:.6em;min-width:12em}\n#wsp .w-audio i{width:2em;height:2em;border-radius:50%;background:#7fdcc6;flex:none;position:relative}\n#wsp .w-audio i::after{content:\"\";position:absolute;left:.75em;top:.55em;border-left:.65em solid #005c4b;border-top:.45em solid transparent;border-bottom:.45em solid transparent}\n#wsp .w-wave{flex:1;height:1.6em;background:repeating-linear-gradient(90deg,#b8e6da 0 2px,transparent 2px 5px);mask:linear-gradient(0deg,transparent 0 20%,#000 20% 80%,transparent 80%);opacity:.8}\n#wsp .w-meta{font-size:.75em;color:#b6d6cc;text-align:right;margin-top:.2em}\n#wsp footer{padding:.6em .8em 1.4em;background:#0b141a;color:#7d8f96;font-size:.9em}\n/* panel de derrota */\n.lose-card{background:var(--panel);border:2px solid var(--line);padding:22px;display:flex;flex-direction:column;gap:12px;align-items:flex-start;width:min(420px,100%)}\n.lose-card h2{font-family:var(--f-display);font-weight:400;font-size:34px;color:var(--rojo)}\n.lose-card p{line-height:1.5;color:var(--muted)}\n.pause-card{background:var(--panel);border:2px solid var(--line);padding:22px;display:flex;flex-direction:column;gap:14px;align-items:flex-start;width:min(360px,100%)}\n.pause-card h2{font-family:var(--f-display);font-weight:400;font-size:34px;color:var(--bencina)}\n#fatal{max-width:46ch;line-height:1.5}\n/* ---------- Editor de textos ---------- */\n#editor{z-index:9;align-items:flex-start}\n.ed{width:min(880px,100%);max-height:100%;display:flex;flex-direction:column;background:var(--panel);border:2px solid var(--line);box-shadow:8px 8px 0 rgba(0,0,0,.5);margin:auto;min-height:0}\n.ed header{padding:16px 18px;border-bottom:2px solid var(--line);display:flex;flex-direction:column;gap:6px}\n.ed header h2{font-family:var(--f-display);font-weight:400;font-size:26px;color:var(--bencina)}\n.ed header p{color:var(--muted);font-size:14px;line-height:1.45;max-width:66ch}\n.ed-body{overflow-y:auto;padding:4px 18px 18px;display:flex;flex-direction:column;gap:10px;min-height:0}\n.ed-sec{display:flex;flex-direction:column;gap:6px;padding-top:10px;border-top:1px solid rgba(255,255,255,.08)}\n.ed-sec:first-child{border-top:0}\n.ed-sec h3{font-size:15px;text-transform:uppercase;letter-spacing:.08em;margin:4px 0 0}\n.ed-sec .hint{color:var(--muted);font-size:13px;margin:0 0 4px;line-height:1.4}\n.ed-row{display:grid;grid-template-columns:140px minmax(0,1fr) auto;gap:8px;align-items:start}\n.ed-row.timed{grid-template-columns:96px minmax(0,1fr) auto}\n.ed select,.ed input,.ed textarea{font:inherit;font-size:14px;background:var(--void);color:var(--text);border:2px solid var(--line);padding:6px 8px;min-width:0;box-sizing:border-box}\n.ed textarea{resize:vertical;min-height:38px;line-height:1.35;width:100%}\n.ed select:focus,.ed input:focus,.ed textarea:focus{border-color:var(--bencina);outline:none}\n.ed .field{display:grid;grid-template-columns:210px minmax(0,1fr);gap:8px;align-items:start}\n.ed .field label{color:var(--muted);font-size:13px;padding-top:9px}\n.ed .tools{display:flex;gap:4px}\n.ed .ib{background:transparent;border:2px solid var(--line);color:var(--text);width:34px;height:34px;cursor:pointer;font:inherit;font-weight:700}\n.ed .ib:hover{border-color:var(--muted)}\n.ed .ib:disabled{opacity:.3;cursor:default}\n.ed .add{align-self:flex-start;background:transparent;border:2px dashed var(--line);color:var(--muted);padding:6px 12px;font:inherit;font-weight:700;cursor:pointer}\n.ed .add:hover{color:var(--text);border-color:var(--muted)}\n.ed footer{padding:12px 18px;border-top:2px solid var(--line);display:flex;gap:10px;flex-wrap:wrap;align-items:center}\n.ed-status{color:var(--muted);font-size:14px;flex:1 1 220px;min-width:0}\n.ed-status.err{color:var(--rojo, #ff5f4e)}\n.ed-status.ok{color:var(--pito)}\n#edit-btn{font-size:14px}\n@media (max-width:640px){.ed-row,.ed-row.timed,.ed .field{grid-template-columns:minmax(0,1fr)}.ed .field label{padding-top:0}}\n@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n\n/* ---------- Tutorial: cómo se juega ---------- */\n#tuto{z-index:8;align-items:flex-start}\n.tuto{width:min(1000px,100%);margin:auto;background:var(--panel);border:2px solid var(--line);box-shadow:8px 8px 0 rgba(0,0,0,.5);display:flex;flex-direction:column;max-height:100%;min-height:0}\n.tuto-head{padding:18px 22px 14px;border-bottom:2px solid var(--line);display:flex;flex-direction:column;gap:10px}\n.tuto-head h2{font-family:var(--f-display);font-weight:400;font-size:clamp(26px,3.2vw,38px);line-height:1.05;color:var(--bencina);te