.BoxGeometry(0.44, 0.6, 0.26), 1.1], [new THREE.BoxGeometry(0.2, 0.24, 0.22), 1.53], [new THREE.BoxGeometry(0.1, 0.48, 0.1), 0], [new THREE.BoxGeometry(0.1, 0.48, 0.1), 0]];\n  const shirts = [0x1d3fa6, 0x1d3fa6, 0x2a4fc0, 0xf2f2f2, 0xc8202e, 0x15151a];\n  for (let row = 0; row < 9; row++) {\n    const r = 49.9 + row * 1.3;\n    for (let x = -6.5; x <= 8.5; x += 0.62) {\n      const xx = x + (rnd() - 0.4) * 0.2; if (Math.abs(xx - KAPU_POS.x - 0.5) < 1.5 && row < 2) continue;\n      const a = Math.acos(clamp(xx / r, -1, 1)), z = -STR - r * Math.sin(a);\n      FANS.push({ x:xx, y:tierY(r), z, ph:rnd() * 6, up:rnd() < 0.35, shirt:shirts[(rnd() * shirts.length) | 0], skin:SKINS[(rnd() * SKINS.length) | 0] });\n    }\n  }\n  const mat = new THREE.MeshPhongMaterial({ color:0x9496aa, flatShading:true, shininess:4 }), col = new THREE.Color();\n  parts.forEach(([geo], k) => { const im = new THREE.InstancedMesh(geo, mat, FANS.length); FANS.forEach((f, i) => im.setColorAt(i, col.setHex(k === 0 ? 0x24262e : k === 2 || (k > 2 && f.up) ? f.skin : f.shirt))); im.instanceColor.needsUpdate = true; scene.add(im); FAN_PARTS.push(im); });\n}\nconst _fm = new THREE.Matrix4(), _fq = new THREE.Quaternion(), _fe = new THREE.Euler(), _fp = new THREE.Vector3(), _fs = new THREE.Vector3(1, 1, 1);\nfunction updateFans(bounce, speed) {\n  FANS.forEach((f, i) => {\n    const y = f.y + Math.abs(Math.sin(G.t * speed + f.ph)) * bounce, yaw = Math.atan2(-f.x, -f.z);\n    const place = (k, lx, ly, rz) => { _fe.set(0, yaw, rz || 0, 'YXZ'); _fq.setFromEuler(_fe); _fp.set(lx, ly, 0).applyAxisAngle(UPV, yaw); _fp.x += f.x; _fp.y += y; _fp.z += f.z; _fm.compose(_fp, _fq, _fs); FAN_PARTS[k].setMatrixAt(i, _fm); };\n    place(0, 0, 0.4); place(1, 0, 1.1); place(2, 0, 1.53);\n    place(3, -0.28, f.up ? 1.62 : 1.02, f.up ? 0.25 : 0); place(4, 0.28, f.up ? 1.62 : 1.02, f.up ? -0.25 : 0);\n  });\n  FAN_PARTS.forEach((m) => { m.instanceMatrix.needsUpdate = true; });\n}\ncoach.root.position.set(PW / 2 + 3.6, 0, -9