.45 * u, -0.72 * u, 0.05 * u); if (p.b.armG[1].userData.fore) p.b.armG[1].userData.fore.rotation.set(0, 0, 0);\n      p.b.headG.rotation.set(-0.22 * inhale + 0.1 * u, 0, 0);\n      jointG.visible = true; emberM.color.setRGB(1, 0.42 + 0.45 * inhale, 0.12 + 0.3 * inhale);\n      if (k > 0.66 && !p.exhaled) { p.exhaled = true; p.b.headG.getWorldPosition(_w); const fx = Math.sin(p.face), fz = Math.cos(p.face); for (let i = 0; i < 10; i++) puff(_w.x + fx * 0.15, _w.y - 0.05, _w.z + fz * 0.15, 0xeeeeea, 0.5, 2.4, 0.5); }\n      if (Math.random() < dt * 8) { jointG.getWorldPosition(_w); puff(_w.x, _w.y + 0.05, _w.z, 0xd8d8d0, 0.08, 1.2, 0.12); }\n    } else { jointG.visible = false; if (G.mode !== 'intro') p.b.headG.rotation.set(0, 0, 0); }\n  }\n  if (p.cel > 0) { if (p === TP) cryPose(p, G.t); else armsUp(p.b, G.t, 1); }\n  let y = Math.abs(s) * 0.06 * sw;\n  const isK = p === gk || p.keeping;\n  if (isK && p.dive > 0) {\n    // estirada: salto en arco hacia el lado, cuerpo casi horizontal, brazos estirados y piernas abiertas\n    p.diveT = (p.diveT || 0) + dt; const a = Math.min(1, p.diveT / 0.55), dir = p.diveDir || 1;\n    r.rotation.z = -dir * 1.5 * smooth(p.diveT / 0.28);\n    y += a < 1 ? 0.12 + 0.95 * Math.sin(a * Math.PI) : 0.12;\n    p.b.armG.forEach((g, i) => { g.rotation.set(-2.95, 0, (i ? -1 : 1) * 0.15); const f = g.userData.fore; if (f && g.userData.straight) f.quaternion.copy(g.userData.straight); });\n    p.b.legG.forEach((g, i) => { g.rotation.set(i ? -0.2 : 0.35, 0, (i ? 1 : -1) * 0.32); const kn = g.userData.knee; if (kn) kn.rotation.x = i ? 0.15 : 0.7; });\n  } else {\n    p.diveT = 0; r.rotation.z = p.lean || 0;\n    // arquero esperando: agachado, piernas abiertas y brazos afuera, dando saltitos\n    if (isK && sp < 1.5 && !p.cel && (G.mode === 'pens' || G.mode === 'play' || G.mode === 'pre')) {\n      const bob = Math.abs(Math.sin(G.t * 5 + (p === gk ? 1 : 0))) * 0.05;\n      p.b.legG.forEach((g, i) => { g.rotation.set(-0.35, 0, (i ? 1 : -1) * 0.2)