Dir() {\n  let ix = (keys.right ? 1 : 0) - (keys.left ? 1 : 0), iz = (keys.down ? 1 : 0) - (keys.up ? 1 : 0);\n  if (G.pasaoT > 0) ix = -ix;\n  const l = Math.hypot(ix, iz); if (l > 0) { ix /= l; iz /= l; }\n  return [ix, iz, l > 0];\n}\nfunction steer(p, tx, tz, spd, dt, acc) {\n  const dx = tx - p.x, dz = tz - p.z, d = Math.hypot(dx, dz);\n  let vx = 0, vz = 0; if (d > 0.12) { const s = Math.min(spd, d * 3); vx = dx / d * s; vz = dz / d * s; }\n  const k = Math.min(1, (acc || 7) * dt); p.vx += (vx - p.vx) * k; p.vz += (vz - p.vz) * k;\n  p.x += p.vx * dt; p.z += p.vz * dt;\n  if (Math.hypot(p.vx, p.vz) > 0.5) p.face = Math.atan2(p.vx, p.vz);\n}\nfunction kickTo(p, tx, tz, spd, vy) {\n  const dx = tx - B.x, dz = tz - B.z, d = Math.hypot(dx, dz) || 1;\n  B.owner = null; B.hd = null; B.vx = dx / d * spd; B.vz = dz / d * spd; B.vy = vy || 0; B.y = 0.12; B.noPick = 0.22; B.kicker = p; B.tried.clear();\n  p.kickT = 0.35; p.face = Math.atan2(dx, dz); sfx.kick(Math.min(1, spd / 30));\n}\nfunction passSpeed(d) { return clamp(d * 1.15 + 5.5, 9, 24); }\nfunction tironiPass() {\n  if (B.owner !== TP || G.crisisT > 0) return;\n  const [ix, iz, has] = inputDir(); const dx0 = has ? ix : Math.sin(TP.face), dz0 = has ? iz : Math.cos(TP.face);\n  let best = null, bs = -1e9;\n  for (const m of mates) { const dx = m.x - TP.x, dz = m.z - TP.z, d = Math.hypot(dx, dz) || 1, c = (dx * dx0 + dz * dz0) / d, s = c * 2 - d / 28; if (c > 0.15 && s > bs) { bs = s; best = m; } }\n  if (!best) best = mates.reduce((a, m) => Math.hypot(m.x - TP.x, m.z - TP.z) < Math.hypot(a.x - TP.x, a.z - TP.z) ? m : a);\n  // al pie: calcula dónde va a estar el compañero cuando llegue la pelota\n  let lx = best.x, lz = best.z;\n  for (let it = 0; it < 3; it++) { const d = Math.hypot(lx - B.x, lz - B.z), tt = d / (passSpeed(d) * 0.78); lx = best.x + best.vx * tt; lz = best.z + best.vz * tt; }\n  kickTo(TP, lx, lz, passSpeed(Math.hypot(lx - B.x, lz - B.z)), 0); best.recv = 1.6; G.culpa = Math.min(100, G.culpa + 1);\n  G.paredM = best; best.oneTouch = false;\n}\n// pared (1-2): si aprietas J otra vez mientras la pelota va al compañero (o justo cuando la recibe), te la devuelve al toque al espacio\nfunction tryPared() {\n  const m = G.paredM; if (!m || G.crisisT > 0) return;\n  if (!B.owner && B.kicker === TP) { m.oneTouch = true; return; }\n  if (B.owner === m && m.hold < 0.5) doPared(m);\n}\nfunction doPared(m) {\n  m.oneTouch = false; G.paredM = null;\n  const sp = Math.hypot(TP.vx, TP.vz), dx = sp > 1 ? TP.vx / sp : 0, dz = sp > 1 ? TP.vz / sp : -1;\n  let ux = dx * 0.55, uz = dz * 0.55 - 0.45; const ul = Math.hypot(ux, uz) || 1; ux /= ul; uz /= ul;\n  const tx = TP.x + ux * 5.5, tz = Math.max(GZ + 3, TP.z + uz * 5.5);\n  kickTo(m, tx, tz, passSpeed(Math.hypot(tx - B.x, tz - B.z)) + 3, 0); m.hold = 0;\n  G.paredT = 1.1; showCenter('¡Pared!', 800, 'green'); crowd(0.7, 0.2); setTimeout(() => crowd(0.45, 1), 900);\n}\nfunction tironiShoot() {\n  const c = clamp(G.charge, 0.12, 1);\n  const near = !B.owner && B.y < 1.4 && Math.hypot(TP.x - B.x, TP.z - B.z) < 1.6;\n  if ((B.owner !== TP && !near) || G.crisisT > 0) return;\n  const [ix] = inputDir();\n  const ax = ix !== 0 ? ix * 2.75 : (gk.x >= 0 ? -1.9 : 1.9);\n  const d0 = Math.hypot(ax - B.x, GZ - B.z);\n  const err = (0.22 + d0 / 30 + Math.max(0, G.culpa - 50) / 50 * 1.1 + (G.pasaoT > 0 ? 1.3 : 0)) * gauss();\n  const tx = ax + err, spd = 16 + 16 * c;\n  kickTo(TP, tx, GZ, spd, 1.0 + c * c * 6.4 + (Math.random() - 0.5) * 0.5);\n  B.shot = true; B.noPick = 0.4; G.culpa = Math.min(100, G.culpa + 9);\n  { const tg = (GZ - B.z) / (B.vz || -1), px = B.x + B.vx * tg; G.shake = 0.12 + 0.18 * c; if (tg > 0 && Math.abs(px) < GW / 2 + 1.6) { G.bulletT = 0.5; G.shotCam = 1.8; } }\n  gk.react = 0.17 + Math.random() * 0.12; gk.guess = Math.random() < 0.15 ? -1 : 1;\n  const tc = (gk.z - B.z) / B.vz; gk.predX = B.x + B.vx * tc;\n}\nfunction smoke() {\n  if (G.pitos <= 0) { hint('No te quedan pitos: te llega uno nuevo en la próxima jugada', 1800); return; }\n  G.pitos--; G.vola += 35; G.slowT = 4.5; G.culpa = Math.max(0, G.culpa - 40); G.flash = 0.12; sfx.smoke();\n  TP.smokeT = SMOKE_T; TP.exhaled = false;\n  if (G.vola >= 100) { G.pasaoT = 6; G.vola = 65; showCenter('¡PASAO!', 1200, 'red'); hint('Quedaste pasao: izquierda y derecha al revés por un rato', 3000); HU.hud.classList.add('pasao'); }\n  else showCenter('Cámara lenta', 900, 'green');\n}\nfunction steal(d) {\n  B.owner = d; B.shot = false; d.hold = 0; endJugada('robo');\n}\nfunction updatePlay(dt) {\n  G.playT += dt;\n  const slow = G.slowT > 0, ws = slow ? 0.45 : 1, wd = dt * ws, td = dt * (slow ? 0.82 : 1);\n  G.slowT = Math.max(0, G.slowT - dt); G.vola = Math.max(0, G.vola - 2.6 * dt);\n  if (G.pasaoT > 0) { G.pasaoT -= dt; if (G.pasaoT <= 0) HU.hud.classList.remove('pasao'); }\n  // culpa: sube mientras Tironi tiene la pelota\n  if (B.owner === TP) G.culpa = Math.min(100, G.culpa + 3.2 * dt); else G.culpa = Math.max(0, G.culpa - 0.5 * dt);\n  const mark = G.culpa >= 75 ? 2 : G.culpa >= 50 ? 1 : 0;\n  if (mark > G.culpaMark) { sayCulpa(); }\n  G.culpaMark = mark;\n  if (G.culpa >= 100 && G.crisisT <= 0) { G.crisisT = 1.8; G.culpa = 62; sfx.sad(); thought(TXT.culpa.length ? TXT.culpa[0][1] : '…', 1900); showCenter('Crisis de culpa', 1200, 'red'); }\n  G.crisisT = Math.max(0, G.crisisT - dt);\n  if (G.charge >= 0) G.charge = Math.min(1, G.charge + dt / 0.9);\n  controlTironi(td);\n  updateMates(wd); updateDefs(wd); updateGK(wd); updateRef(wd);\n  separate();\n  updateBall(wd);\n  if (G.mode === 'play' && G.playT > JUG_T) endJugada('tiempo');\n}\nfunction sayCulpa() { const L = TXT.culpa; if (!L.length) return; G.culpaIdx = (G.culpaIdx + 1 + Math.floor(Math.random() * Math.max(1, L.length - 1))) % L.length; thought(L[G.culpaIdx][1], 2300); }\nfunction controlTironi(dt) {\n  let [ix, iz, has] = inputDir();\n  if (G.culpa > 60 && has) { const a = Math.sin(G.t * 2.7) * 0.5 * (G.culpa - 60) / 40, c = Math.cos(a), s = Math.sin(a); [ix, iz] = [ix * c - iz * s, ix * s + iz * c]; }\n  if (G.crisisT > 0) { ix = iz = 0; has = false; }\n  const withBall = B.owner === TP;\n  const chase = false;\n  // sprint con Shift mientras quede aire (si se acaba, hay que esperar que se recupere un poco)\n  const sprint = keys.sprint && has && !chase && G.air > (G.airLock ? 30 : 1);\n  if (sprint) { G.air = Math.max(0, G.air - 28 * dt); if (G.air <= 1) G.airLock = true; } else { G.air = Math.min(100, G.air + 15 * dt); if (G.air >= 30) G.airLock = false; }\n  TP.sprint = sprint; G.paredT = Math.max(0, G.paredT - dt);\n  const max = (withBall ? 6.7 : 7.3) * (sprint ? 1.27 : 1) * (G.paredT > 0 ? 1.12 : 1);\n  // gira con peso: no da vuelta en seco, y un giro brusco lo frena\n  let da = 0;\n  if (has) { da = Math.atan2(ix, iz) - TP.face; while (da > Math.PI) da -= 2 * Math.PI; while (da < -Math.PI) da += 2 * Math.PI; const tr = (withBall ? 8.5 : 11) * dt * (TP.spd < 1.5 ? 2.2 : 1); TP.face += clamp(da, -tr, tr); }\n  const sharp = has ? clamp((Math.abs(da) - 0.7) / 1.6, 0, 1) : 0, target = chase ? Math.min(max * 0.5, Math.hypot(B.x - TP.x, B.z - TP.z) * 3) : has ? max * (1 - 0.6 * sharp) : 0;\n  const acc = target > TP.spd ? (sprint ? 12 : 10) : 18; TP.spd += clamp(target - TP.spd, -acc * dt, acc * dt);\n  TP.vx = Math.sin(TP.face) * TP.spd; TP.vz = Math.cos(TP.face) * TP.spd;\n  TP.x = clamp(TP.x + TP.vx * dt, -PW / 2 + 0.5, PW / 2 - 0.5); TP.z = clamp(TP.z + TP.vz * dt, GZ + 0.4, 30);\n  TP.lean = lerp(TP.lean, clamp(-da * TP.spd * 0.055, -0.3, 0.3), 1 - Math.exp(-8 * dt));\n  // recoger pelota suelta\n  if (!B.owner && B.y < 0.8 && (B.kicker !== TP || B.noPick <= 0) && Math.hypot(B.x - TP.x, B.z - TP.z) < 1.0 && !B.inNet) { B.owner = TP; B.shot = false; B.vx = TP.vx * 0.9; B.vz = TP.vz * 0.9; B.vy = 0; }\n}\nfunction updateMates(dt) {\n  mates.forEach((m, i) => {\n    if (B.owner === m) {\n      m.hold += dt; steer(m, m.x + Math.sin(G.t + i) * 0.5, m.z - 2, 3.5, dt);\n      if (m.hold > 0.55 + i * 0.1) {\n        const lx = TP.x + TP.vx * 0.75, lz = Math.max(GZ + 4, TP.z + TP.vz * 0.75 - 1.6);\n        kickTo(m, lx, lz, passSpeed(Math.hypot(lx - B.x, lz - B.z)), 0); m.hold = 0;\n      }\n      return;\n    }\n    if (m.recv > 0 && !B.owner) { m.recv -= dt; steer(m, B.x + B.vx * 0.25, B.z + B.vz * 0.25, 7, dt, 10); }\n    else {\n      const t = G.t * 0.6 + i * 2;\n      let tx, tz;\n      if (i === 0) { tx = clamp(TP.x - 13, -30, 8); tz = TP.z - 8 + Math.sin(t) * 3; }\n      else if (i === 1) { tx = clamp(TP.x + 13, -8, 30); tz = TP.z - 9 + Math.cos(t) * 3; }\n      else { tx = TP.x * 0.35 + Math.sin(t * 0.8) * 5; tz = TP.z - 15; }\n      steer(m, tx, clamp(tz, GZ + 7, 25), 6, dt);\n    }\n    if (!B.owner && B.y < 0.9 && B.kicker !== m && Math.hypot(B.x - m.x, B.z - m.z) < 0.9 && !B.inNet && !B.shot) { B.owner = m; m.hold = 0; m.recv = 0; if (m.oneTouch) doPared(m); }\n  });\n}\nfunction updateDefs(dt) {\n  const carrier = B.owner && B.owner.team === 'U' ? B.owner : null;\n  const rx = B.x, rz = B.z, diff = 1 + G.jug * 0.025;\n  const sorted = defs.slice().sort((a, b) => Math.hypot(a.x - rx, a.z - rz) - Math.hypot(b.x - rx, b.z - rz));\n  const presser = sorted[0], cover = sorted[1];\n  for (const d of defs) {\n    let tx, tz, spd;\n    if (d === presser) { tx = B.x + B.vx * 0.2; tz = B.z + B.vz * 0.2; spd = 5.5 * diff; }\n    else if (d === cover) { const gx = -rx, gz = GZ - rz, gl = Math.hypot(gx, gz) || 1; tx = rx + gx / gl * 5; tz = rz + gz / gl * 5; spd = 5.4 * diff; }\n    else { const m = d.mark; tx = m.x * 0.92; tz = m.z - 1.8; spd = 5.6 * diff; }\n    steer(d, tx, Math.max(tz, GZ + 2), spd, dt);\n    if (d === presser && carrier) {\n      const dist = Math.hypot(d.x - B.x, d.z - B.z);\n      const near = carrier === TP ? Math.max(dist, Math.hypot(d.x - TP.x, d.z - TP.z) - 0.7) : dist;   // a Tironi le cuesta un poco más quitársela: la pelota va adelante suyo\n      if (near < 0.7 && G.crisisT <= 0 || near < 1.2 && G.crisisT > 0) { d.steal += dt; if (d.steal > (carrier === TP ?