  if (!sfx.ok()) return; const ctx = AU.ctx, out = ctx.createGain(); out.gain.value = 0.9; out.connect(AU.master); AU.dem = out;\n  const t0 = ctx.currentTime + 0.1, st = 60 / 96 / 4, roots = [45, 41, 48, 43];\n  for (let bar = 0; bar < bars; bar++) for (let s = 0; s < 16; s++) {\n    const t = t0 + (bar * 16 + s) * st;\n    if (s % 4 === 0) { const o = tone(130, t, 0.18, 'sine', 0.55, out); o.frequency.exponentialRampToValueAtTime(42, t + 0.15); }\n    if (s === 3 || s === 6 || s === 11 || s === 14) { noise(t, 0.12, 0.3, 'bandpass', 1900, 0.9, out); tone(210, t, 0.07, 'triangle', 0.12, out); }\n    if (s % 2 === 0) noise(t, 0.035, 0.07, 'highpass', 7500, 0, out);\n    if (s === 0 || s === 6 || s === 10) tone(mf(roots[bar % 4]), t, 0.25, 'sawtooth', 0.14, out, ['lowpass', 380]);\n    if (s === 3 || s === 7 || s === 11) [0, 3, 7].forEach((iv) => tone(mf(roots[bar % 4] + 24 + iv), t, 0.1, 'square', 0.025, out, ['lowpass', 1800]));\n  }\n  demStop = t0 + bars * 16 * st;\n}\nfunction stopDembow() { if (AU.dem && AU.ctx) { AU.dem.gain.setTargetAtTime(0, AU.ctx.currentTime, 0.1); AU.dem = null; } }\nfunction schedBombo() {\n  if (!AU.ctx || SND.chant) return; const now = AU.ctx.currentTime; if (AU.bomboNext < now) AU.bomboNext = now + 0.05;\n  const pat = [1, 0, 1, 1, 1, 0, 1, 0];\n  while (AU.bomboNext < now + 0.3) { const s = AU.bomboStep++ % 8; if (pat[s]) sfx.bombo(AU.bomboNext, s === 0); AU.bomboNext += 0.21; }\n}\n\n/* =========================================================\n   INTERFAZ\n   ========================================================= */\nconst HU = { air:$('#m-air'), airbar:$('#h-airbar'), hud:$('#hud'), sc:$('#h-sc'), min:$('#h-min'), jug:$('#h-jug'), jt:$('#h-jt'), jtw:$('#h-jtw'), culpa:$('#m-culpa'), culpaL:$('#h-culpa-l'), culpabar:$('#h-culpabar'), vola:$('#m-vola'), volaL:$('#h-vola-l'), volabar:$('#h-volabar'), pitos:document.querySelectorAll('#h-pitos i'), power:$('#power'), pw:$('#h-power'), banner:$('#banner'), bubble:$('#bubble'), bubbleT