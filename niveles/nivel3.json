.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(gain, t + 0.01); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);\n  let node = o; if (filt) { const bf = ctx.createBiquadFilter(); bf.type = filt[0]; bf.frequency.value = filt[1]; if (filt[2]) bf.Q.value = filt[2]; o.connect(bf); node = bf; }\n  node.connect(g); g.connect(dest || AU.sfx); o.start(t); o.stop(t + dur + 0.02); return o;\n}\nfunction noise(t, dur, gain, type, freq, q, dest) {\n  const ctx = AU.ctx, s = ctx.createBufferSource(); s.buffer = AU.noise;\n  const f = ctx.createBiquadFilter(); f.type = type; f.frequency.value = freq; if (q) f.Q.value = q;\n  const g = ctx.createGain(); g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(gain, t + 0.02); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);\n  s.connect(f); f.connect(g); g.connect(dest || AU.sfx); s.start(t, Math.random() * 1.5); s.stop(t + dur + 0.05); return f;\n}\nfunction crowd(level, tc) { if (AU.ctx) AU.crowdOut.gain.setTargetAtTime((SND.chant && level < 0.8 ? level * 0.45 : level) * 0.6, AU.ctx.currentTime, tc || 0.4); }\nconst sfx = {\n  ok() { return !!AU.ctx; },\n  whistle(n, long) {\n    if (!sfx.ok()) return; let t = AU.ctx.currentTime + 0.02;\n    for (let k = 0; k < n; k++) {\n      const d = long && k === n - 1 ? 0.9 : 0.22, o = AU.ctx.createOscillator(), g = AU.ctx.createGain(), l = AU.ctx.createOscillator(), lg = AU.ctx.createGain();\n      o.type = 'sine'; o.frequency.value = 2900; l.frequency.value = 38; lg.gain.value = 160; l.connect(lg); lg.connect(o.frequency);\n      g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.16, t + 0.02); g.gain.setValueAtTime(0.16, t + d - 0.04); g.gain.exponentialRampToValueAtTime(0.0001, t + d);\n      o.connect(g); g.connect(AU.sfx); o.start(t); l.start(t); o.stop(t + d + 0.02); l.stop(t + d + 0.02); t += d + 0.12;\n    }\n  },\n  kick(p) { if (!sfx.ok()) return; const t = AU.ctx.currentTime; const o = tone(160, t, 0.12, 'sine', 